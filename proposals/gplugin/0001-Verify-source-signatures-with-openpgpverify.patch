From d61dc5dbb4babdb56d1a0086b93f653a179c8f3d Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:46 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 gplugin.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/gplugin.spec b/gplugin.spec
index e6e2e4b..afef9f9 100644
--- a/gplugin.spec
+++ b/gplugin.spec
@@ -16,7 +16,7 @@ Source2:        https://keybase.io/grim/pgp_keys.asc
 # This is too strict for downstream packaging.
 Patch:          gplugin-0.43.1-gi-docgen-no-fatal-warnings.patch
 
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  meson >= 0.61.0
 BuildRequires:  gcc
 BuildRequires:  gi-docgen
@@ -117,7 +117,7 @@ Requires:       %{name}-vala%{?_isa} = %{?epoch:%{epoch}:}%{version}-%{release}
 %{summary}.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 # We install docs ourselves
 sed -i -e '/install_data/,+1 d' meson.build
-- 
2.56.0

