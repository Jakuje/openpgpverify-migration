From 40ed19feb694e68f201e54e42c65ff16f27a3688 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 13:58:44 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 libtasn1.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libtasn1.spec b/libtasn1.spec
index e09931e..f6c1a5c 100644
--- a/libtasn1.spec
+++ b/libtasn1.spec
@@ -13,7 +13,7 @@ Source1:	http://ftp.gnu.org/gnu/libtasn1/%name-%version.tar.gz.sig
 Source2:        https://keys.openpgp.org/vks/v1/by-fingerprint/B1D2BD1375BECB784CF4F8C4D73CF638C53C06BE#/gpgkey-B1D2BD1375BECB784CF4F8C4D73CF638C53C06BE.asc
 Patch1:		libtasn1-3.4-rpath.patch
 
-BuildRequires:	gnupg2
+BuildRequires:	openpgpverify
 BuildRequires:	gcc
 BuildRequires:	bison, pkgconfig, help2man
 BuildRequires:	autoconf, automake, libtool
@@ -55,7 +55,7 @@ data.
 
 
 %prep
-gpgv2 --keyring %{SOURCE2} %{SOURCE1} %{SOURCE0}
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %setup -q
 
 %patch -P1 -p1 -b .rpath
-- 
2.56.0

