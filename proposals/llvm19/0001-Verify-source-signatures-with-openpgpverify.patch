From 485e0bd5c876e6340bd304af85d1d0118c614bb3 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Wed, 4 Nov 2026 10:52:17 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 llvm19.spec | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/llvm19.spec b/llvm19.spec
index 9d7f104..cbf854f 100644
--- a/llvm19.spec
+++ b/llvm19.spec
@@ -246,7 +246,7 @@
 #region main package
 Name:		%{pkg_name_llvm}
 Version:	%{maj_ver}.%{min_ver}.%{patch_ver}%{?rc_ver:~rc%{rc_ver}}%{?llvm_snapshot_version_suffix:~%{llvm_snapshot_version_suffix}}
-Release:	20%{?dist}
+Release:	21%{?dist}
 Summary:	The Low Level Virtual Machine
 
 License:	Apache-2.0 WITH LLVM-exception OR NCSA
@@ -446,7 +446,7 @@ BuildRequires:	python%{python3_pkgversion}-rpm-macros
 %endif
 
 # For gpg source verification
-BuildRequires:	gnupg2
+BuildRequires:	openpgpverify
 
 BuildRequires:	swig
 BuildRequires:	libxml2-devel
@@ -1078,11 +1078,11 @@ Polly header files.
 %prep
 %if %{without snapshot_build}
 # llvm
-%{gpgverify} --keyring='%{SOURCE6}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE6}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 
 %if %{with bundle_compat_lib}
-%{gpgverify} --keyring='%{SOURCE6}' --signature='%{SOURCE3001}' --data='%{SOURCE3000}'
+%{openpgpverify} --keyring='%{SOURCE6}' --signature='%{SOURCE3001}' --data='%{SOURCE3000}'
 %setup -T -q -b 3000 -n llvm-project-%{compat_ver}.src
 
 # Apply all patches with number < 500 (unconditionally)
@@ -3153,6 +3153,9 @@ fi
 
 #region changelog
 %changelog
+* Wed Nov 04 2026 Jakub Jelen <jjelen@redhat.com> - 19.1.7-21
+- Verify upstream source signatures with openpgpverify
+
 * Thu Sep 10 2026 Zbigniew Jędrzejewski-Szmek <zbyszek@in.waw.pl> - 19.1.7-20
 - Rebuilt for libxml-2.5.4
 
-- 
2.56.0

