From 34043be38ea0a2a3759294b9b1691352ba22946a Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:41 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 basez.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/basez.spec b/basez.spec
index 06e096c..93cfd66 100644
--- a/basez.spec
+++ b/basez.spec
@@ -1,6 +1,6 @@
 Name:           basez
 Version:        1.6.2
-Release:        11%{?dist}
+Release:        12%{?dist}
 Summary:        Base 16/32/64 encode/decode data to standard output
 
 License:        GPL-3.0-or-later AND CC-BY-3.0-US AND BSD-2-Clause AND FSFAP
@@ -18,7 +18,7 @@ Source3:        %{url}/download/GPG-KEY
 Patch0:         add_disable_hex_opt.patch
 
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  make
 
 %description
@@ -32,7 +32,7 @@ base32plain base32hex base64plain base64url base64mime base64pem
 base32/64 are OMITTED from this package since coreutils provides them.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE3}' --signature='%{SOURCE2}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE3}' --signature='%{SOURCE2}' --data='%{SOURCE0}'
 %autosetup
 
 %build
@@ -63,6 +63,9 @@ rm -f %{buildroot}%{_datadir}/doc/%{name}/LICENSE
 
 
 %changelog
+* Fri Oct 30 2026 Jakub Jelen <jjelen@redhat.com> - 1.6.2-12
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.6.2-11
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

