From 2f5f4c8c9b5173bc4fc89efb3d45804d23e52040 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 24 Nov 2026 12:54:23 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 fedrq.spec | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/fedrq.spec b/fedrq.spec
index 96b2e72..7f84187 100644
--- a/fedrq.spec
+++ b/fedrq.spec
@@ -9,7 +9,7 @@
 
 Name:           fedrq
 Version:        1.9.1
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        A tool to query the Fedora and EPEL repositories
 
 # - code is GPL-2.0-or-later
@@ -38,8 +38,8 @@ BuildRequires:  python3-libdnf5 >= %{min_libdnf5_version}
 %endif
 # Manpage
 BuildRequires:  scdoc
-# gpgverify
-BuildRequires:  gnupg2
+# openpgpverify
+BuildRequires:  openpgpverify
 
 Requires:       (python3-dnf or python3-libdnf5)
 Suggests:       (python3-libdnf5 if dnf5)
@@ -57,7 +57,7 @@ fedrq is a tool to query the Fedora and EPEL repositories.
 
 
 %prep
-%gpgverify -d0 -s1 -k2
+%openpgpverify -d0 -s1 -k2
 %autosetup -p1
 
 
@@ -120,6 +120,9 @@ FEDRQ_BACKEND=libdnf5 %{py3_test_envvars} \
 
 
 %changelog
+* Tue Nov 24 2026 Jakub Jelen <jjelen@redhat.com> - 1.9.1-2
+- Verify upstream source signatures with openpgpverify
+
 * Thu Nov 19 2026 Maxwell G <maxwell@gtmx.me> - 1.9.1-1
 - Update to 1.9.1.
 
-- 
2.56.1

