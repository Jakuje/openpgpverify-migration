From 2d27fc06ab8b797e21e446f0f59f869550eb3cff Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 23 Oct 2026 10:26:37 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 libnftnl.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/libnftnl.spec b/libnftnl.spec
index ccdb82e..4e69917 100644
--- a/libnftnl.spec
+++ b/libnftnl.spec
@@ -1,6 +1,6 @@
 Name:           libnftnl
 Version:        1.3.2
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        Library for low-level interaction with nftables Netlink's API over libmnl
 
 License:        GPL-2.0-or-later
@@ -13,6 +13,7 @@ BuildRequires:  libmnl-devel
 BuildRequires:  gcc
 BuildRequires:  make
 BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 
 %description
 A library for low-level interaction with nftables Netlink's API over libmnl.
@@ -26,7 +27,7 @@ The %{name}-devel package contains libraries and header files for
 developing applications that use %{name}.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
@@ -50,6 +51,9 @@ find $RPM_BUILD_ROOT -name '*.la' -exec rm -f {} ';'
 %{_includedir}/libnftnl
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 1.3.2-2
+- Verify upstream source signatures with openpgpverify
+
 * Wed Sep 02 2026 Phil Sutter <psutter@redhat.com> - 1.3.2-1
 - new version
 
-- 
2.56.0

