From 434812a6bd9158bd75ea5f1dbc852fb1427e5a1a Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 9 Oct 2026 15:20:18 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 logrotate.spec | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/logrotate.spec b/logrotate.spec
index 56a7d25..3afe990 100644
--- a/logrotate.spec
+++ b/logrotate.spec
@@ -23,6 +23,7 @@ BuildRequires: libselinux-devel
 BuildRequires: make
 BuildRequires: popt-devel
 BuildRequires: systemd-rpm-macros
+BuildRequires: openpgpverify
 Requires: coreutils
 Requires(post): systemd
 Requires(preun): systemd
@@ -38,7 +39,7 @@ Install the logrotate package if you need a utility to deal with the
 log files on your system.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -S git
 
 cat >> .gitignore << EOF
@@ -115,6 +116,9 @@ fi
 %config(noreplace) %{_sysconfdir}/rwtab.d/logrotate
 
 %changelog
+* Fri Oct 09 2026 Jakub Jelen <jjelen@redhat.com> - 3.22.0-6
+- Verify source signatures with openpgpverify (Sequoia)
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 3.22.0-6
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
