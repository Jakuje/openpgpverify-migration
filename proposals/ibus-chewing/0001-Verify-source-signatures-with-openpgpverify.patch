From 591b633f2ca4b3f84cabd8704cb0be1dd072c760 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 23 Oct 2026 10:26:37 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 ibus-chewing.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ibus-chewing.spec b/ibus-chewing.spec
index a4e98b8..ce7dad9 100644
--- a/ibus-chewing.spec
+++ b/ibus-chewing.spec
@@ -14,7 +14,7 @@ Source2:        https://chewing.im/.well-known/openpgpkey/hu/y84sdmnksfqswe7fxf5
 BuildRequires:  meson >= 0.57.0
 BuildRequires:  gcc
 BuildRequires:  pkgconf
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  pkgconfig(ibus-1.0)
 BuildRequires:  pkgconfig(chewing) >= 0.9.0
 BuildRequires:  pkgconfig(glib-2.0)
@@ -42,7 +42,7 @@ IBus-chewing 是新酷音輸入法的IBus前端。
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -n %{name}-%{version_no_tilde}
 
 %build
-- 
2.56.0

