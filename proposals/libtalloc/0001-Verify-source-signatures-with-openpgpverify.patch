From 4ef85c6a06a39955e2433d5a53197737531efdb6 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:34:52 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Refresh talloc.keyring from keyservers/WKD: same certificate(s), with
self-signatures our copy was missing; the commands are in the spec
comment.

Assisted-by: Claude Opus 5.5
---
 libtalloc.spec |   7 ++++++-
 talloc.keyring | Bin 646 -> 10801 bytes
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/libtalloc.spec b/libtalloc.spec
index 400d3ae..1a59bcc 100644
--- a/libtalloc.spec
+++ b/libtalloc.spec
@@ -7,6 +7,10 @@ URL:             https://talloc.samba.org/
 
 Source0:         https://www.samba.org/ftp/talloc/talloc-%{version}.tar.gz
 Source1:         https://www.samba.org/ftp/talloc/talloc-%{version}.tar.asc
+# Refreshed from keyservers/WKD (same keys, newer signatures):
+#   sq --home=none network search --output - 9147A339719518EE9011BCB54793916113084025 | sq keyring filter --experimental --cert 9147A339719518EE9011BCB54793916113084025 --output update.pgp
+#   sq keyring merge talloc.keyring update.pgp | sq packet dearmor --output talloc.keyring.new
+#   mv talloc.keyring.new talloc.keyring
 Source2:         https://download.samba.org/pub/samba/samba-pubkey.asc#/talloc.keyring
 
 BuildRequires: make
@@ -16,6 +20,7 @@ BuildRequires: docbook-style-xsl
 BuildRequires: python3-devel
 BuildRequires: doxygen
 BuildRequires: gnupg2
+BuildRequires: openpgpverify
 
 Provides: bundled(libreplace)
 Obsoletes: python2-talloc < 2.2.0-1
@@ -54,7 +59,7 @@ Development libraries for python3-talloc
 %autosetup -n talloc-%{version} -p1
 
 %build
-zcat %{SOURCE0} | gpgv2 --quiet --keyring %{SOURCE2} %{SOURCE1} -
+zcat %{SOURCE0} | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 
 # workaround https://gitlab.com/ita1024/waf/-/issues/2472
 export PYTHONARCHDIR=%{python3_sitearch}
diff --git a/talloc.keyring b/talloc.keyring
index dc6f26b019fe410b6c5defac77034152235732ba..91264ee2b327bcb9a5d7485c02118dd5362385e6 100644
