From db2bd6cb5551a370adaf551d6b22b86daa7f30c8 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:41 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 libtalloc.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/libtalloc.spec b/libtalloc.spec
index b74cd69..1a59bcc 100644
--- a/libtalloc.spec
+++ b/libtalloc.spec
@@ -20,6 +20,7 @@ BuildRequires: docbook-style-xsl
 BuildRequires: python3-devel
 BuildRequires: doxygen
 BuildRequires: gnupg2
+BuildRequires: openpgpverify
 
 Provides: bundled(libreplace)
 Obsoletes: python2-talloc < 2.2.0-1
@@ -58,7 +59,7 @@ Development libraries for python3-talloc
 %autosetup -n talloc-%{version} -p1
 
 %build
-zcat %{SOURCE0} | gpgv2 --quiet --keyring %{SOURCE2} %{SOURCE1} -
+zcat %{SOURCE0} | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 
 # workaround https://gitlab.com/ita1024/waf/-/issues/2472
 export PYTHONARCHDIR=%{python3_sitearch}
-- 
2.56.0

