From 5b4b50d7225bcee6b55d411548e367c19f84ace2 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 23 Oct 2026 10:26:38 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 pcre2.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/pcre2.spec b/pcre2.spec
index 72216d2..7646e0f 100644
--- a/pcre2.spec
+++ b/pcre2.spec
@@ -9,7 +9,7 @@
 #%%global rcversion RC1
 Name:       pcre2
 Version:    10.47
-Release:    %{?rcversion:0.}1%{?rcversion:.%rcversion}%{?dist}.2
+Release:    %{?rcversion:0.}1%{?rcversion:.%rcversion}%{?dist}.3
 %global     myversion %{version}%{?rcversion:-%rcversion}
 Summary:    Perl-compatible regular expression library
 # the library:                          BSD with exceptions
@@ -68,6 +68,7 @@ BuildRequires:  make
 BuildRequires:  readline-devel
 %endif
 BuildRequires:  sed
+BuildRequires:  openpgpverify
 Requires:       %{name}-syntax = %{version}-%{release}
 Provides:       bundled(sljit)
 
@@ -147,7 +148,7 @@ Requires:   %{name}-utf16 = %{version}-%{release}
 Utilities demonstrating PCRE2 capabilities like pcre2grep or pcre2test.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -n %{name}-%{myversion} -p1
 # Because of multilib patch
 libtoolize --copy --force
@@ -262,6 +263,9 @@ make %{?_smp_mflags} check VERBOSE=yes
 %{_mandir}/man1/pcre2test.*
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 10.47-1.3
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 10.47-1.2
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
