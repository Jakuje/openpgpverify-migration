From 4fff0fe9efcd7e53b9e207475e219068be12a67b Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 18:56:55 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 wlroots0.18.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/wlroots0.18.spec b/wlroots0.18.spec
index 64449f9..407a934 100644
--- a/wlroots0.18.spec
+++ b/wlroots0.18.spec
@@ -42,7 +42,7 @@ Patch:          Revert-layer-shell-error-on-0-dimension-without-anch.patch
 
 BuildRequires:  gcc
 BuildRequires:  glslang
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  meson >= 0.59.0
 
 BuildRequires:  (pkgconfig(libliftoff) >= %{liftoff_ver} with pkgconfig(libliftoff) < 0.6)
@@ -98,7 +98,7 @@ Development files for %{name}.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -N -n wlroots-%{version}
 # apply unconditional patches (0..99)
 %autopatch -p1 -M99
-- 
2.56.0

