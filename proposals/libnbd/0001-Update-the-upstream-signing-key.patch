index e28be02..69c5dcc 100644
--- a/libnbd.spec
+++ b/libnbd.spec
@@ -36,6 +36,11 @@ Source1:        http://libguestfs.org/download/libnbd/%{source_directory}/%{name
 # Keyring used to verify tarball signature.  This contains the single
 # key from here:
 # https://pgp.key-server.io/pks/lookup?search=rjones%40redhat.com&fingerprint=on&op=vindex
+# Upstream signing key from upstream, merged into this keyring:
+#   curl -fsSL -o key.asc https://download.libguestfs.org/rich@annexia.org-pubkey.txt
+#   sq keyring merge libguestfs.keyring key.asc | sq packet dearmor --output libguestfs.keyring.new
