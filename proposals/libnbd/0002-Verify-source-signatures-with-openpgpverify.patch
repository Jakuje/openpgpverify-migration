From b8222e7ff4cb442df72b56e0271c72f1daaf6d3b Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 3 Nov 2026 12:51:34 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 libnbd.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/libnbd.spec b/libnbd.spec
index 29cd00c..3a8cfb0 100644
--- a/libnbd.spec
+++ b/libnbd.spec
@@ -25,7 +25,7 @@
 
 Name:           libnbd
 Version:        1.25.8
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        NBD client library in userspace
 
 License:        LGPL-2.0-or-later AND BSD-3-Clause
@@ -42,7 +42,7 @@ Source2:       https://download.libguestfs.org/rich@annexia.org-pubkey.txt
 Source3:        copy-patches.sh
 
 %if 0%{verify_tarball_signature}
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 %endif
 
 # For rebuilding autoconf cruft.
@@ -218,7 +218,7 @@ for %{name}.
 
 %prep
 %if 0%{verify_tarball_signature}
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 %autosetup -p1
 autoreconf -i
@@ -405,6 +405,9 @@ make %{?_smp_mflags} check || {
 
 
 %changelog
+* Tue Nov 03 2026 Jakub Jelen <jjelen@redhat.com> - 1.25.8-2
+- Verify upstream source signatures with openpgpverify
+
 * Tue Oct 13 2026 Richard W.M. Jones <rjones@redhat.com> - 1.25.8-1
 - New upstream development version 1.25.8
 - Replace TODO with TODO.md
-- 
