From 89c1328be3d3cc6e48a4308821f4706727defe0f Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 3 Nov 2026 11:30:53 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 libnbd.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/libnbd.spec b/libnbd.spec
index 6650815..f2ae969 100644
--- a/libnbd.spec
+++ b/libnbd.spec
@@ -25,7 +25,7 @@
 
 Name:           libnbd
 Version:        1.25.8
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        NBD client library in userspace
 
 License:        LGPL-2.0-or-later AND BSD-3-Clause
@@ -96,6 +96,7 @@ BuildRequires:  jq
 BuildRequires:  nbd
 %endif
 BuildRequires:  util-linux
+BuildRequires:  openpgpverify
 
 # On RHEL, maybe even in Fedora in future, we do not build qemu-img or
 # nbdkit for i686.  These are only needed for the test suite so make
@@ -220,7 +221,7 @@ for %{name}.
 
 %prep
 %if 0%{verify_tarball_signature}
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 %autosetup -p1
 autoreconf -i
@@ -407,6 +408,9 @@ make %{?_smp_mflags} check || {
 
 
 %changelog
+* Fri Oct 30 2026 Jakub Jelen <jjelen@redhat.com> - 1.25.8-2
+- Verify upstream source signatures with openpgpverify
+
 * Tue Oct 13 2026 Richard W.M. Jones <rjones@redhat.com> - 1.25.8-1
 - New upstream development version 1.25.8
 - Replace TODO with TODO.md
-- 
