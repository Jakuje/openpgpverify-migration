From ff713e985072ec3879fa7819594c540404f6d119 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 10:38:41 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 samba.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/samba.spec b/samba.spec
index ffa449f..1601008 100644
--- a/samba.spec
+++ b/samba.spec
@@ -395,6 +395,7 @@ BuildRequires: cepces-certmonger >= 0.3.8
 BuildRequires: perl(ExtUtils::MakeMaker)
 BuildRequires: perl(FindBin)
 BuildRequires: perl(Parse::Yapp)
+BuildRequires: openpgpverify
 
 %if %{without includelibs}
 BuildRequires: libtalloc-devel >= %{talloc_version}
@@ -1362,7 +1363,7 @@ Python bindings for the LDB library
 
 %prep
 %if 0%{?fedora} || 0%{?rhel} >= 9
-xzcat %{SOURCE0} | %{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
+xzcat %{SOURCE0} | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %else
 xzcat %{SOURCE0} | gpgv2 --quiet --keyring %{SOURCE2} %{SOURCE1} -
 %endif
-- 
