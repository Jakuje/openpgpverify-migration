From 05954f04734527360b20374b37e5e91b9838e2ca Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:35 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 znc.spec | 15 +++++++--------
 1 file changed, 7 insertions(+), 8 deletions(-)

diff --git a/znc.spec b/znc.spec
index 9d03c90..37d66e6 100644
--- a/znc.spec
+++ b/znc.spec
@@ -13,7 +13,7 @@
 
 Name:           znc
 Version:        1.10.3
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        An advanced IRC bouncer
 
 # Automatically converted from old format: ASL 2.0 - review is highly recommended.
@@ -39,7 +39,7 @@ BuildRequires:  cyrus-sasl-devel
 BuildRequires:  gcc-c++
 BuildRequires:  gettext
 BuildRequires:  gettext-devel
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  libargon2-devel
 BuildRequires:  libicu-devel
 BuildRequires:  make
@@ -125,12 +125,8 @@ Requires:      python%{python3_pkgversion}
 
 
 %prep
-# Verify GPG signature
-gpghome="$(mktemp -qd)" # Ensure we don't use any existing gpg keyrings
-key="%{SOURCE2}"
-gpg2 --dearmor --quiet --batch --yes $key >/dev/null
-gpgv2 --homedir "$gpghome" --quiet --keyring $key.gpg %{SOURCE1} %{SOURCE0}
-rm -rf "$gpghome" $key.gpg # Cleanup tmp gpg home dir and dearmored key
+# Verify the source signature
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 
 %autosetup -p1
 
@@ -245,6 +241,9 @@ install -m0644 -D znc.sysusers.conf %{buildroot}%{_sysusersdir}/znc.conf
 
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 1.10.3-2
+- Verify upstream source signatures with openpgpverify
+
 * Sun Sep 13 2026 Nick Bebout <nb@fedoraproject.org> - 1.10.3-1
 - Update to 1.10.3
 - Fix CVE-2026-82373, CVE-2026-82374, CVE-2020-11022, CVE-2020-11023
