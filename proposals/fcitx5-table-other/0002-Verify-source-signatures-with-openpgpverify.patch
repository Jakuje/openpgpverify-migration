From 11b500bc009867a91b0f8f4836122e3020a5b1b1 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 6 Nov 2026 09:07:07 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 fcitx5-table-other.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/fcitx5-table-other.spec b/fcitx5-table-other.spec
index 45723fa..65469c8 100644
--- a/fcitx5-table-other.spec
+++ b/fcitx5-table-other.spec
@@ -13,7 +13,7 @@ Source2:    https://pgp.key-server.io/download/0x8E8B898CBF2412F9
 Patch1:     0001-tell-CMAKE-no-compiler-will-be-used.patch
 BuildArch:  noarch
 
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  cmake
 BuildRequires:  extra-cmake-modules
 BuildRequires:  ninja-build
@@ -31,7 +31,7 @@ Fcitx-table-other provides some other tables
 for Fcitx, fork from ibus-table-others, scim-tables.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build 
-- 
2.56.0

