From c130a17db1d0e92f939b5051ced67bf89943235f Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 6 Nov 2026 12:19:22 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 libextractor.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libextractor.spec b/libextractor.spec
index bab924d..b0e813e 100644
--- a/libextractor.spec
+++ b/libextractor.spec
@@ -40,7 +40,7 @@ BuildRequires:  gcc
 ## exiv2 config check uses g++
 BuildRequires:  gcc-c++
 BuildRequires:  gettext-devel
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  libtool-ltdl-devel
 BuildRequires:  make
 BuildRequires:  pkgconfig(bzip2)
@@ -147,7 +147,7 @@ introduce additional dependencies.
 #pluginpkg      gstreamer  -B gstreamer-devel,libgsf-gnome-devel,libgsf-devel,gtk
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 cp -aR %{SOURCE3} .
 rm -rfv README.debian
-- 
2.56.0

