From b5865fd15749447a2b434e501e9bcbe77322bd65 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:08:51 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Refresh gpgkey-junio.asc from keyservers/WKD: same certificate(s), with
self-signatures our copy was missing; the commands are in the spec
comment.
Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 git.spec         |   12 +-
 gpgkey-junio.asc | 1158 +++++++++++++++++++++++++++++++++++++++++-----
 2 files changed, 1048 insertions(+), 122 deletions(-)

diff --git a/git.spec b/git.spec
index 40b0b51..d239ff0 100644
--- a/git.spec
+++ b/git.spec
@@ -87,7 +87,7 @@
 
 Name:           git
 Version:        2.56.0
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        Fast Version Control System
 License:        BSD-3-Clause AND GPL-2.0-only AND GPL-2.0-or-later AND LGPL-2.1-or-later AND MIT
 URL:            https://git-scm.com/
@@ -110,6 +110,10 @@ Source1:        https://www.kernel.org/pub/software/scm/git/%{rcpath}%{name}-%{r
 #
 # https://git.kernel.org/cgit/git/git.git/tag/?h=junio-gpg-pub
 # https://git.kernel.org/cgit/git/git.git/blob/?h=junio-gpg-pub&id=7214aea37915ee2c4f6369eb9dea520aec7d855b
+# Refreshed from keyservers/WKD (same keys, newer signatures):
+#   sq --home=none network search --output - 96E07AF25771955980DAD10020D04E5A713660A7 | sq keyring filter --experimental --cert 96E07AF25771955980DAD10020D04E5A713660A7 --output update.pgp
+#   sq keyring merge --output gpgkey-junio.asc.new gpgkey-junio.asc update.pgp
+#   mv gpgkey-junio.asc.new gpgkey-junio.asc
 Source2:        gpgkey-junio.asc
 
 # Local sources begin at 10 to allow for additional future upstream sources
@@ -208,6 +212,7 @@ BuildRequires:  tcl
 BuildRequires:  tk
 BuildRequires:  xz
 BuildRequires:  zlib-devel >= 1.2
+BuildRequires:  openpgpverify
 
 %if %{with tests}
 # Test suite requirements
@@ -540,7 +545,7 @@ Requires:       subversion
 
 %prep
 # Verify GPG signatures
-xz -dc '%{SOURCE0}' | %{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
+xz -dc '%{SOURCE0}' | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 
 %autosetup -p1 -n %{name}-%{real_version}
 
@@ -1053,6 +1058,9 @@ rmdir --ignore-fail-on-non-empty "$testdir"
 %{?with_docs:%{_pkgdocdir}/git-svn.html}
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 2.56.0-2
+- Verify upstream source signatures with openpgpverify
+
 * Mon Oct 05 2026 Ondřej Pohořelský <opohorel@redhat.com> - 2.56.0-1
 - update to 2.56.0
 
