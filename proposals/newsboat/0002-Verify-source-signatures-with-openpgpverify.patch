From 9f5339617e876227f27d756f888c85a331c94895 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 10:38:42 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 newsboat.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/newsboat.spec b/newsboat.spec
index b14a4b8..58421b2 100644
--- a/newsboat.spec
+++ b/newsboat.spec
@@ -35,6 +35,7 @@ BuildRequires: pkgconfig(stfl)
 # Rust parts
 BuildRequires:  git-core
 BuildRequires:  rust-packaging
+BuildRequires: openpgpverify
 
 Obsoletes: newsbeuter < 2.9-29
 
@@ -44,7 +45,7 @@ Provides: podboat = %{version}-%{release}
 Newsboat is a fork of Newsbeuter, an RSS/Atom feed reader for the text console.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 # Note to self: do not use -S git_am for released builds, it messes up version string
 %autosetup -p1
 %cargo_prep
-- 
2.56.0

