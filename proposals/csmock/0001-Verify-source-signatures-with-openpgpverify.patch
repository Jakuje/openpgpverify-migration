From ca07a5e4cb60f4677c79b95cb8f60ca6b3c2936a Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 18:56:46 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 csmock.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/csmock.spec b/csmock.spec
index 33ee5ad..465c1c9 100644
--- a/csmock.spec
+++ b/csmock.spec
@@ -3,7 +3,7 @@
 
 Name:       csmock
 Version:    3.8.7
-Release:    2%{?dist}
+Release:    3%{?dist}
 Summary:    A mock wrapper for Static Analysis tools
 
 License:    GPL-3.0-or-later
@@ -16,7 +16,7 @@ Source1:    https://github.com/csutils/%{name}/releases/download/%{name}-%{versi
 Source2:    sfowler.pgp
 
 BuildRequires: cmake
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: help2man
 
 %if 0%{?rhel} == 7
@@ -207,7 +207,7 @@ Requires: csmock-common
 This package contains the unicontrol plug-in for csmock.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
@@ -340,6 +340,9 @@ This package contains the unicontrol plug-in for csmock.
 %{python3_sitelib}/csmock/plugins/__pycache__/unicontrol.*
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 3.8.7-3
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 3.8.7-2
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

