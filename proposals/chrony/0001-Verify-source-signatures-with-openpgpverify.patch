From fc67cdefab1c7da1c5b66c1bd5c92f5b17315e7b Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 22 Oct 2026 13:10:14 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 chrony.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/chrony.spec b/chrony.spec
index 11a8de2..9729960 100644
--- a/chrony.spec
+++ b/chrony.spec
@@ -13,7 +13,7 @@
 
 Name:           chrony
 Version:        4.9
-Release:        2%{?dist}
+Release:        3%{?dist}
 Summary:        An NTP client/server
 
 License:        GPL-2.0-only
@@ -32,6 +32,7 @@ Patch1:         chrony-nm-dispatcher-dhcp.patch
 
 BuildRequires:  libcap-devel libedit-devel pps-tools-devel
 BuildRequires:  gcc gcc-c++ make bison systemd gnupg2
+BuildRequires:  openpgpverify
 %{?with_nettle:BuildRequires: nettle-devel}
 %{!?with_nettle:BuildRequires: gnutls-devel}
 %{?with_nts:BuildRequires: gnutls-devel gnutls-utils}
@@ -62,7 +63,7 @@ service to other computers in the network.
 %endif
 
 %prep
-%{gpgverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
+%{openpgpverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
 %setup -q -n %{name}-%{version}%{?prerelease} -a 10
 %autopatch -p1
 
@@ -213,6 +214,9 @@ fi
 %ghost %dir %attr(750,chrony,chrony) %{_localstatedir}/log/chrony
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 4.9-3
+- Verify upstream source signatures with openpgpverify
+
 * Thu Aug 27 2026 Yaakov Selkowitz <yselkowi@redhat.com> - 4.9-2
 - Use gnutls for crypto on RHEL
 
-- 
2.55.0

