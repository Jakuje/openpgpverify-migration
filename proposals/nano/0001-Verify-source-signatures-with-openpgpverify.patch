From c6bfffc3f2f964a542aea7cde999056f1e4bb36e Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 12 Oct 2026 14:13:01 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 nano.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/nano.spec b/nano.spec
index 416ca3d..ef09c49 100644
--- a/nano.spec
+++ b/nano.spec
@@ -8,7 +8,7 @@
 Summary:         A small text editor
 Name:            nano
 Version:         9.2
-Release:         1%{?dist}
+Release:         2%{?dist}
 License:         GPL-3.0-or-later
 URL:             https://www.nano-editor.org
 
@@ -30,7 +30,7 @@ BuildRequires:   file-devel
 BuildRequires:   gettext-devel
 BuildRequires:   gcc
 BuildRequires:   git-core
-BuildRequires:   gnupg2
+BuildRequires:   openpgpverify
 BuildRequires:   make
 BuildRequires:   ncurses-devel
 BuildRequires:   sed
@@ -65,7 +65,7 @@ who don't have nano as a default editor during upgrade.
 %endif
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -S git_am
 
 %build
@@ -131,6 +131,9 @@ install -Dpm 0644 %{SOURCE13} %{buildroot}%{_datadir}/fish/vendor_conf.d/%{basen
 
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 9.2-2
+- Verify upstream source signatures with openpgpverify
+
 * Fri Jul 31 2026 Lukáš Zaoral <lzaoral@redhat.com> - 9.2-1
 - rebase to the latest upstream release (rhbz#2509695)
 
-- 
2.55.0

