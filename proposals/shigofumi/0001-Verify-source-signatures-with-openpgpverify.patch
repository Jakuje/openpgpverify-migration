From 72f07d5db9c041518a39320e59ba72cb71a239bd Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 15:23:38 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 shigofumi.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/shigofumi.spec b/shigofumi.spec
index 62c6370..27b3e72 100644
--- a/shigofumi.spec
+++ b/shigofumi.spec
@@ -1,6 +1,6 @@
 Name:           shigofumi
 Version:        0.9
-Release:        17%{?dist}
+Release:        18%{?dist}
 Summary:        Command line client for accessing the Czech Data Boxes
 # COPYING:          GPL-3.0 text
 # README:           GPL-3.0-or-later
@@ -56,7 +56,7 @@ BuildRequires:  automake
 BuildRequires:  file-devel
 BuildRequires:  gettext-devel
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  libxml2-devel
 BuildRequires:  make
 BuildRequires:  pkgconfig(libconfuse)
@@ -68,7 +68,7 @@ This is Shigofumi, an ISDS (Informační systém datových schránek / Data Box
 Information System) client.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 autoreconf -fi
 
@@ -98,6 +98,9 @@ export CFLAGS="$CFLAGS -Wno-error=deprecated-declarations"
 %{_mandir}/*/man5/shigofumirc.*
 
 %changelog
+* Fri Oct 23 2026 Jakub Jelen <jjelen@redhat.com> - 0.9-18
+- Verify upstream source signatures with openpgpverify
+
 * Thu Sep 10 2026 Zbigniew Jędrzejewski-Szmek <zbyszek@in.waw.pl> - 0.9-17
 - Rebuilt for libxml-2.5.4
 
-- 
2.56.0

