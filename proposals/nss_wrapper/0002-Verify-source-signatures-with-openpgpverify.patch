From 5bde549ad3ea7046939d028027211bf8e60ff27a Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 3 Nov 2026 11:00:26 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 nss_wrapper.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/nss_wrapper.spec b/nss_wrapper.spec
index ff09bdf..feae14f 100644
--- a/nss_wrapper.spec
+++ b/nss_wrapper.spec
@@ -23,6 +23,7 @@ BuildRequires:  gcc
 BuildRequires:  gnupg2
 BuildRequires:  libcmocka-devel
 BuildRequires:  perl-generators
+BuildRequires:  openpgpverify
 
 Requires:       %{name}-libs%{?_isa} = %{version}-%{release}
 Recommends:     cmake
@@ -59,7 +60,7 @@ The %{name}-libs package provides only the shared library.
 For a minimal footprint, install just this package.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
-- 
