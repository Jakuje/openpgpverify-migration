From befa1ffce384083f31cf48a3159fbe73dfde18cd Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 15:23:30 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 facter.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/facter.spec b/facter.spec
index 29fcd1e..4fabe18 100644
--- a/facter.spec
+++ b/facter.spec
@@ -22,6 +22,7 @@ BuildRequires:  (rubygem(hocon) >= 1.3 with rubygem(hocon) < 2)
 BuildRequires:  (rubygem(thor) >= 1.0.1 with rubygem(thor) < 2)
 BuildRequires:  rubygem(sys-filesystem)
 BuildRequires:  rubygem(base64)
+BuildRequires:  openpgpverify
 
 # Binaries that Facter can call for complete facts
 %ifarch %ix86 x86_64 ia64
@@ -64,7 +65,7 @@ Documentation for %{name}.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %setup -q -n %{gem_name}-%{version}
 %gemspec_add_dep -g sys-filesystem
 # Revert https://github.com/puppetlabs/facter/commit/5e6c601f2a4ae37e3cd72f8411816a508d2f8b3c
-- 
2.56.0

