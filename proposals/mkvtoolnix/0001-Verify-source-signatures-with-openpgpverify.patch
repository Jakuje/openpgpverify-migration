From 78a04cd15239220915eb2e1c190d66e5c22079f8 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 13:17:34 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 mkvtoolnix.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/mkvtoolnix.spec b/mkvtoolnix.spec
index 1a019e0..45cd512 100644
--- a/mkvtoolnix.spec
+++ b/mkvtoolnix.spec
@@ -22,7 +22,7 @@ BuildRequires: fmt-devel >= 8.0.0
 BuildRequires: gcc-c++
 BuildRequires: gettext
 BuildRequires: gmp-devel
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: gtest-devel
 BuildRequires: json-devel
 BuildRequires: libappstream-glib
@@ -66,7 +66,7 @@ streams into and from Matroska containers.
 This package contains the QT graphical interface for these utilities.
 
 %prep
-%{gpgverify} --keyring='%{S:2}' --signature='%{S:1}' --data='%{S:0}'
+%{openpgpverify} --keyring='%{S:2}' --signature='%{S:1}' --data='%{S:0}'
 %setup -q
 rm -rf lib/{fmt,libebml,libmatroska,nlohmann-json,pugixml,utf8-cpp}
 rm -rf rake.d/vendor drake
-- 
2.56.0

