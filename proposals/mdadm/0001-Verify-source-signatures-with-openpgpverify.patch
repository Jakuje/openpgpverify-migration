From f4545e412fcf87f41596cad065ec0341e7818d47 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 23 Oct 2026 10:26:38 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 mdadm.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/mdadm.spec b/mdadm.spec
index 4285a1d..8e3a548 100644
--- a/mdadm.spec
+++ b/mdadm.spec
@@ -2,7 +2,7 @@
 
 Name:        mdadm
 Version:     4.6
-Release:     2%{?dist}
+Release:     3%{?dist}
 Summary:     The mdadm program controls Linux md devices (software RAID arrays)
 URL:         http://www.kernel.org/pub/linux/utils/raid/mdadm/
 License:     GPL-2.0-or-later
@@ -28,7 +28,7 @@ BuildRequires:    systemd-rpm-macros
 BuildRequires:    binutils-devel
 BuildRequires:    gcc
 BuildRequires:    systemd-devel
-BuildRequires:    gnupg2
+BuildRequires:    openpgpverify
 BuildRequires:    mandoc
 %if %{with abrt}
 Requires:         libreport-filesystem
@@ -49,7 +49,7 @@ file can be used to help with some common tasks.
 # because the tarball is what is signed, not the compressed tarball
 # keyring should be one from https://git.kernel.org/pub/scm/docs/kernel/pgpkeys.git/plain/keys
 # which will vary depending on who did the release
-%{_bindir}/gzip -d -c %{SOURCE0} | %{gpgverify} --keyring='%{SOURCE11}' --signature='%{SOURCE10}' --data=-
+%{_bindir}/gzip -d -c %{SOURCE0} | %{openpgpverify} --keyring='%{SOURCE11}' --signature='%{SOURCE10}' --data=-
 %autosetup -p1
 
 
@@ -124,6 +124,9 @@ install -Dm644 raid6check.man %{buildroot}/%{_mandir}/man8/raid6check.man
 
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 4.6-3
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 4.6-2
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
