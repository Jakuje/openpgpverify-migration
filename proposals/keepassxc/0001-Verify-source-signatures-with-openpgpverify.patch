From f5c1eae72cf0b0a88d44a0ed381f86e2e6d5bab4 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 21:26:37 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Refresh keepassxc_master_signing_key.asc from keyservers/WKD: same
certificate(s), with self-signatures our copy was missing.
Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 keepassxc.spec                   |    8 +-
 keepassxc_master_signing_key.asc | 1916 ++++++++++++++++++------------
 2 files changed, 1186 insertions(+), 738 deletions(-)

diff --git a/keepassxc.spec b/keepassxc.spec
index 767b2a0..1361cb8 100644
--- a/keepassxc.spec
+++ b/keepassxc.spec
@@ -2,7 +2,7 @@
 
 Name:           keepassxc
 Version:        2.8.0
-Release:        3%{?dist}
+Release:        4%{?dist}
 Summary:        Cross-platform password manager
 License:        GPL-2.0-or-later AND BSD-2-Clause AND MIT AND CC0-1.0 AND Apache-2.0 AND LGPL-2.0-only AND LGPL-2.1-only
 URL:            https://keepassxc.org/
@@ -54,6 +54,7 @@ BuildRequires:  zlib-devel
 BuildRequires:  rubygem-asciidoctor
 # Required for GPG signature verification
 BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 
 # enforces on the user system, Qt version to be the same one used to build KeepassXC
 # This avoids "not a bug" bugreports like this one
@@ -104,7 +105,7 @@ information can be considered as quite safe.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 
 %autosetup -n %{name}-%{version}
 
@@ -170,6 +171,9 @@ appstream-util validate-relax --nonet %{buildroot}%{_datadir}/metainfo/org.%{nam
 %{_mandir}/man1/%{name}.1*
 
 %changelog
+* Mon Oct 26 2026 Jakub Jelen <jjelen@redhat.com> - 2.8.0-4
+- Verify upstream source signatures with openpgpverify
+
 * Sun Oct 25 2026 Jan Grulich <jgrulich@redhat.com> - 2.8.0-3
 - Rebuild (qt6)
 
