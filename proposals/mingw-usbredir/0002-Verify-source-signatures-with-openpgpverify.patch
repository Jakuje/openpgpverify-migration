From 1b3dc0d34286c6833804f60ccc7b134ed850f35b Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:45 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 mingw-usbredir.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/mingw-usbredir.spec b/mingw-usbredir.spec
index fb6b228..bbd74ef 100644
--- a/mingw-usbredir.spec
+++ b/mingw-usbredir.spec
@@ -2,7 +2,7 @@
 
 Name:           mingw-usbredir
 Version:        0.14.0
-Release:        6%{?dist}
+Release:        7%{?dist}
 Summary:        MinGW USB network redirection protocol libraries
 
 # Automatically converted from old format: LGPLv2+ - review is highly recommended.
@@ -29,6 +29,7 @@ BuildRequires:  mingw64-glib2
 BuildRequires:  git-core
 BuildRequires:  meson
 BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 
 %description
 The usbredir libraries allow USB devices to be used on remote and/or virtual
@@ -80,7 +81,7 @@ applications that use usbredir with MinGW.
 
 
 %prep
-gpgv2 --quiet --keyring %{SOURCE2} %{SOURCE1} %{SOURCE0}
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -S git_am -p1 -n usbredir-%{version}
 
 %build
@@ -139,6 +140,9 @@ find $RPM_BUILD_ROOT -name "*.la" -delete
 
 
 %changelog
+* Mon Oct 26 2026 Jakub Jelen <jjelen@redhat.com> - 0.14.0-7
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 0.14.0-6
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

