From 260b226db7d6254b878faea37464b230a40b7362 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 15:23:34 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 xvinfo.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/xvinfo.spec b/xvinfo.spec
index 09ca9d6..65b26a2 100644
--- a/xvinfo.spec
+++ b/xvinfo.spec
@@ -8,7 +8,7 @@ Source0:    https://www.x.org/pub/individual/app/%{name}-%{version}.tar.xz
 Source1:    https://www.x.org/pub/individual/app/%{name}-%{version}.tar.xz.sig
 Source2:    gpgkey-3AB285232C46AE43D8E192F4DAB0F78EA6E7E2D2.gpg
 BuildRequires:  gcc
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 BuildRequires:  meson
 BuildRequires:  pkgconfig(x11)
 BuildRequires:  pkgconfig(xproto)
@@ -18,7 +18,7 @@ BuildRequires:  pkgconfig(xv)
 xvinfo displays information about the XVideo extension on an X server.
 
 %prep
-%gpgverify -k 2 -s 1 -d 0
+%openpgpverify -k 2 -s 1 -d 0
 %autosetup
 
 %build
-- 
2.56.0

