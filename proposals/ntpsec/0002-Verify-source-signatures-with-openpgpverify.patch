From dac8c0c8930b019b8bb3ad2dad7c6cd14a4c23b7 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 13:58:44 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 ntpsec.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/ntpsec.spec b/ntpsec.spec
index 3e1584f..7fdeca8 100644
--- a/ntpsec.spec
+++ b/ntpsec.spec
@@ -1,6 +1,6 @@
 Name:           ntpsec
 Version:        1.2.6
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        NTP daemon and utilities
 
 License:        NTP AND BSD-2-Clause AND BSD-3-Clause AND BSD-4-Clause AND ISC AND Apache-2.0 AND Beerware
@@ -12,7 +12,7 @@ Source3:        ntp.conf
 
 BuildRequires:  bison
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  libbsd-devel
 BuildRequires:  libcap-devel
 BuildRequires:  m4
@@ -55,7 +55,7 @@ NTPsec is a more secure and improved implementation of the Network Time
 Protocol derived from the original NTP project.
 
 %prep
-%{gpgverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
+%{openpgpverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
 %autosetup -p1
 
 # Fix egg info to use a shorter version which will work as an rpm provide
@@ -209,6 +209,9 @@ sed -i.bak -E '/^restrict/s/no(e?peer|trap)//g' %{_sysconfdir}/ntp.conf
 %{_sysusersdir}/ntpsec.conf
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 1.2.6-2
+- Verify upstream source signatures with openpgpverify
+
 * Wed Oct 21 2026 Miroslav Lichvar <mlichvar@redhat.com> 1.2.6-1
 - update to 1.2.6 (CVE-2026-102483 CVE-2026-102484 CVE-2026-102485
   CVE-2026-102486)
