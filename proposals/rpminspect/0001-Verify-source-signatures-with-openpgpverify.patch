From 0a8c23e733d55996d03c5f4bf221e139e3c9b7eb Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:55 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 rpminspect.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/rpminspect.spec b/rpminspect.spec
index 26647b2..837f836 100644
--- a/rpminspect.spec
+++ b/rpminspect.spec
@@ -48,6 +48,7 @@ BuildRequires:  gettext-devel
 BuildRequires:  clamav-devel
 BuildRequires:  libmandoc-devel >= 1.14.5
 BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  libicu-devel
 BuildRequires:  libcdson-devel
 %if 0%{?fedora}
@@ -167,7 +168,7 @@ control files.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 # not always compatible with new warnings in latest GCC (particularly libtoml)
 sed -i -e 's|werror=true|werror=false|' meson.build
-- 
2.56.0

