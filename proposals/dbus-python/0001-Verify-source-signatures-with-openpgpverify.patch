From f99c252b5dae56e1aff8055edc02f694e4ca47c7 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 30 Oct 2026 13:47:07 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 dbus-python.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/dbus-python.spec b/dbus-python.spec
index 8c238a5..0fe6c6b 100644
--- a/dbus-python.spec
+++ b/dbus-python.spec
@@ -13,7 +13,7 @@ Source1: http://dbus.freedesktop.org/releases/dbus-python/%{srcname}-%{version}.
 # gpg --export --export-options export-minimal > gpgkey-7A073AD1AE694FA25BFF62E5235C099D3EB33076.gpg
 Source2: gpgkey-7A073AD1AE694FA25BFF62E5235C099D3EB33076.gpg
 
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: pkgconfig(dbus-1)
 BuildRequires: pkgconfig(glib-2.0)
 # for %%check
@@ -50,7 +50,7 @@ Headers and static libraries for hooking up custom mainloops to the dbus python
 bindings.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1 -n %{srcname}-%{version}
 
 %build
-- 
2.56.0

