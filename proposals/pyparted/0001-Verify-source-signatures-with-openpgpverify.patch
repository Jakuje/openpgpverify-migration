diff --git a/pyparted.spec b/pyparted.spec
index ad79d71..5e828ed 100644
--- a/pyparted.spec
+++ b/pyparted.spec
@@ -2,12 +2,16 @@ Summary:       Python module for GNU parted
 Name:          pyparted
 Epoch:         1
 Version:       3.13.0
-Release:       17%{?dist}
+Release:       18%{?dist}
 License:       GPL-2.0-or-later
 URL:           https://github.com/dcantrell/pyparted
 
 Source0:       https://github.com/dcantrell/pyparted/releases/download/v%{version}/%{name}-%{version}.tar.gz
 Source1:       https://github.com/dcantrell/pyparted/releases/download/v%{version}/%{name}-%{version}.tar.gz.asc
+# Refreshed from keyservers/WKD (same keys, newer signatures):
+#   sq --home=none network search --output - 08F7C8B3C621950C138F766162977BB9C841B965 | sq keyring filter --experimental --cert 08F7C8B3C621950C138F766162977BB9C841B965 --output update.pgp
+#   sq keyring merge keyring.gpg update.pgp | sq packet dearmor --output keyring.gpg.new
+#   mv keyring.gpg.new keyring.gpg
 Source2:       keyring.gpg
 Source3:       trustdb.gpg
 
@@ -19,6 +23,7 @@ BuildRequires: e2fsprogs
 BuildRequires: gnupg2
 BuildRequires: python3-devel
 BuildRequires: python3-setuptools
+BuildRequires: openpgpverify
 
 %description
 Python module for the parted library.  It is used for manipulating
@@ -33,7 +38,7 @@ partition tables. This package provides Python 3 bindings for parted.
 
 %prep
 # Verify source archive signature
-gpg --no-default-keyring --keyring %{SOURCE2} --trustdb-name %{SOURCE3} --verify %{SOURCE1} %{SOURCE0} || exit 1
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 
 %autosetup
 
@@ -54,6 +59,9 @@ make test
 %{python3_sitearch}/%{name}-%{version}-*.egg-info
 
 %changelog
+* Mon Oct 26 2026 Jakub Jelen <jjelen@redhat.com> - 1:3.13.0-18
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 22 2026 Python Maint <python-maint@redhat.com> - 1:3.13.0-17
 - Rebuilt for Python 3.15.0b4 ABI change
 
