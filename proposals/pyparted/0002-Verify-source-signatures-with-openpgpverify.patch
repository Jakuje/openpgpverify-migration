From 5e1778e1d96c352950a187cc12d915d3c177ce2a Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:35 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 pyparted.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/pyparted.spec b/pyparted.spec
index 2770fdd..098a6e5 100644
--- a/pyparted.spec
+++ b/pyparted.spec
@@ -2,7 +2,7 @@ Summary:       Python module for GNU parted
 Name:          pyparted
 Epoch:         1
 Version:       3.13.0
-Release:       17%{?dist}
+Release:       18%{?dist}
 License:       GPL-2.0-or-later
 URL:           https://github.com/dcantrell/pyparted
 
@@ -18,7 +18,7 @@ BuildRequires: gcc
 BuildRequires: parted-devel >= 3.4
 BuildRequires: pkgconfig
 BuildRequires: e2fsprogs
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: python3-devel
 BuildRequires: python3-setuptools
 
@@ -35,7 +35,7 @@ partition tables. This package provides Python 3 bindings for parted.
 
 %prep
 # Verify source archive signature
-gpg --no-default-keyring --keyring %{SOURCE2} --trustdb-name %{SOURCE3} --verify %{SOURCE1} %{SOURCE0} || exit 1
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 
 %autosetup
 
@@ -56,6 +56,9 @@ make test
 %{python3_sitearch}/%{name}-%{version}-*.egg-info
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 1:3.13.0-18
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 22 2026 Python Maint <python-maint@redhat.com> - 1:3.13.0-17
 - Rebuilt for Python 3.15.0b4 ABI change
 
-- 
2.56.0

