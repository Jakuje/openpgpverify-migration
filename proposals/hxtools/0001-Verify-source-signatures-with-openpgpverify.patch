--- a/hxtools.spec
+++ b/hxtools.spec
@@ -2,7 +2,7 @@
 
 Name:           hxtools
 Version:        20150304
-Release:        25%{?dist}
+Release:        26%{?dist}
 Summary:        A collection of several tools
 # fd0ssh: LGPLv2 or LGPLv3
 # git-forest: GPLv2+
@@ -17,6 +17,10 @@ URL:            http://inai.de/projects/hxtools/
 # xzdec hxtools-%%{version}.tar.xz | gpg --verify hxtools-%%{version}.tar.asc -
 Source0:        http://inai.de/files/hxtools/hxtools-%{version}.tar.xz
 Source1:        http://inai.de/files/hxtools/hxtools-%{version}.tar.asc
+# Refreshed from keyservers/WKD (same keys, newer signatures):
+#   sq --home=none network search --output - B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D | sq keyring filter --experimental --cert B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D --output update.pgp
+#   sq keyring merge gpgkey-B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D.gpg update.pgp | sq packet dearmor --output gpgkey-B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D.gpg.new
+#   mv gpgkey-B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D.gpg.new gpgkey-B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D.gpg
 Source2:        gpgkey-B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D.gpg
 BuildRequires:  gcc
 BuildRequires:  gcc-c++
@@ -32,6 +36,7 @@ BuildRequires:  libxcb-devel
 # For source verification with gpgv
 BuildRequires:  gpg perl-generators xz
 BuildRequires: make
+BuildRequires:  openpgpverify
 Provides:       fd0ssh
 Provides:       git-forest
 Provides:       ofl
@@ -49,7 +54,7 @@ Currently only these tools are included in Fedora:
 * peicon - PE files icons extractor
 
 %prep
-xzcat %{SOURCE0} | gpgv --quiet --keyring %{SOURCE2} %{SOURCE1} -
+xzcat %{SOURCE0} | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %setup -q
 
 %build
@@ -215,6 +220,9 @@ rm "%{buildroot}%{_mandir}/man8/xfs_irecover.8"*
 %{_mandir}/man1/peicon.1*
 
