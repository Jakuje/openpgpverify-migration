From 27b4c4926a8af7484e944920188aa837d3263d59 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:58 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 hxtools.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/hxtools.spec b/hxtools.spec
index f831f2d..c51af6a 100644
--- a/hxtools.spec
+++ b/hxtools.spec
@@ -2,7 +2,7 @@
 
 Name:           hxtools
 Version:        20150304
-Release:        25%{?dist}
+Release:        26%{?dist}
 Summary:        A collection of several tools
 # fd0ssh: LGPLv2 or LGPLv3
 # git-forest: GPLv2+
@@ -36,6 +36,7 @@ BuildRequires:  libxcb-devel
 # For source verification with gpgv
 BuildRequires:  gpg perl-generators xz
 BuildRequires: make
+BuildRequires:  openpgpverify
 Provides:       fd0ssh
 Provides:       git-forest
 Provides:       ofl
@@ -53,7 +54,7 @@ Currently only these tools are included in Fedora:
 * peicon - PE files icons extractor
 
 %prep
-xzcat %{SOURCE0} | gpgv --quiet --keyring %{SOURCE2} %{SOURCE1} -
+xzcat %{SOURCE0} | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %setup -q
 
 %build
@@ -219,6 +220,9 @@ rm "%{buildroot}%{_mandir}/man8/xfs_irecover.8"*
 %{_mandir}/man1/peicon.1*
 
 %changelog
+* Mon Oct 26 2026 Jakub Jelen <jjelen@redhat.com> - 20150304-26
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 20150304-25
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
