From 445076a7dd568b0d110bff836927d1a7daee0761 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 6 Nov 2026 10:31:47 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 pass-audit.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/pass-audit.spec b/pass-audit.spec
index eefc9ad..2b56961 100644
--- a/pass-audit.spec
+++ b/pass-audit.spec
@@ -18,6 +18,7 @@ Patch: 0001-Install-data-files-from-the-Makefile.patch
 Patch: 0001-remove-shebang-from-non-executable-__main__.py-file.patch
 
 BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: python3-devel
 BuildRequires: make
 # Test dependencies
@@ -45,7 +46,7 @@ Requires: pass
 `pass audit` python package.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -n %{name}-%{version} -p1
 
 %generate_buildrequires
-- 
2.56.0

