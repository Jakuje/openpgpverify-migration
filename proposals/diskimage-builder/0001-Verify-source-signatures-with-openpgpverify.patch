From 61e06ab1e18e3c0e6bb374d2817a3ab91ac92973 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:51 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 diskimage-builder.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/diskimage-builder.spec b/diskimage-builder.spec
index c910ef4..091e9b5 100644
--- a/diskimage-builder.spec
+++ b/diskimage-builder.spec
@@ -22,7 +22,7 @@ Source102:        https://releases.openstack.org/_static/%{sources_gpg_sign}.txt
 BuildRequires: git-core
 BuildRequires: python3-devel
 %if 0%{?sources_gpg} == 1
-BuildRequires: /usr/bin/gpgv2
+BuildRequires: openpgpverify
 %endif
 
 BuildArch: noarch
@@ -51,7 +51,7 @@ Components of TripleO that are responsible for building disk images.
 %prep
 # Required for tarball sources verification
 %if 0%{?sources_gpg} == 1
-%{gpgverify}  --keyring=%{SOURCE102} --signature=%{SOURCE101} --data=%{SOURCE0}
+%{openpgpverify}  --keyring=%{SOURCE102} --signature=%{SOURCE101} --data=%{SOURCE0}
 %endif
 %autosetup -n diskimage_builder-%{version} -S git
 
-- 
2.56.0

