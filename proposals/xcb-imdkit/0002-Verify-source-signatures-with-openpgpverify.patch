From ad4ad96794f975006800f0698aeec337de7ab939 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 19:21:01 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 xcb-imdkit.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/xcb-imdkit.spec b/xcb-imdkit.spec
index 4017c7e..1ef1db3 100644
--- a/xcb-imdkit.spec
+++ b/xcb-imdkit.spec
@@ -19,6 +19,7 @@ BuildRequires:  gcc-c++
 BuildRequires:  pkgconfig(xcb)
 BuildRequires:  pkgconfig(xcb-keysyms)
 BuildRequires:  pkgconfig(xcb-util)
+BuildRequires:  openpgpverify
 
 %description
 xcb-imdkit is an implementation of xim protocol in xcb, 
@@ -34,7 +35,7 @@ Requires:       %{name}%{?_isa} = %{version}-%{release}
 Devel files for xcb-imdkit
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
-- 
2.56.0

