From be3f2e2ba1b32dfb1a58b7eebc9341fb2050c2d8 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 15:23:32 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 mucalc.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/mucalc.spec b/mucalc.spec
index bfc9a22..8cdf536 100644
--- a/mucalc.spec
+++ b/mucalc.spec
@@ -11,7 +11,7 @@ Source2:        https://marlam.de/key.txt
 
 BuildRequires:  cmake
 BuildRequires:  gcc-c++
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 
 BuildRequires:  muParser-devel
 BuildRequires:  readline-devel
@@ -24,7 +24,7 @@ with tab-completion and persistent history using GNU readline. The evaluation
 of expressions is handled by the muParser math parser library.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
-- 
2.56.0

