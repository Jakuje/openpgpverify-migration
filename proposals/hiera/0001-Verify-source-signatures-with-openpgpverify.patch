From 8a1b23a9b7c547db7d8c9a702c38832e36917559 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:41 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 hiera.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/hiera.spec b/hiera.spec
index 888559a..a5a7d55 100644
--- a/hiera.spec
+++ b/hiera.spec
@@ -11,7 +11,7 @@ Source2:        https://downloads.puppetlabs.com/puppet-gpg-signing-key-20250406
 # Use /etc/puppet rather than /etc/puppetlabs/puppet
 Patch0:         fix-puppetlab-paths.patch
 BuildArch:      noarch
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  rubygem(rspec)
 BuildRequires:  rubygem(mocha)
 BuildRequires:  rubygem(json)
@@ -21,7 +21,7 @@ BuildRequires:  ruby-devel
 A simple hierarchical database supporting plugin data sources.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %setup -q
 %patch -P0 -p1
 
-- 
2.56.0

