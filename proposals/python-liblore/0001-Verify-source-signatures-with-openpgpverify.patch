From e4d18d3dc37115c6677933525204e838e2e5d7bf Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:47 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 python-liblore.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/python-liblore.spec b/python-liblore.spec
index 701a02e..215f68e 100644
--- a/python-liblore.spec
+++ b/python-liblore.spec
@@ -20,6 +20,7 @@ BuildRequires:  pyproject-rpm-macros
 # linters, typecheckers, etc.; see
 # https://docs.fedoraproject.org/en-US/packaging-guidelines/Python/#_linters.
 # Therefore, we maintain the following list of test dependencies manually.
+BuildRequires:  openpgpverify
 BuildRequires:  python3dist(authheaders)
 BuildRequires:  python3dist(pytest)
 BuildRequires:  python3dist(pytest-asyncio)
@@ -42,7 +43,7 @@ Provides:       python%{python3_pkgversion}-%{srcname} = %{version}-%{release}
 
 
 %prep
-xz -dc '%{SOURCE0}' | %{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
+xz -dc '%{SOURCE0}' | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %autosetup -p1 -n %{srcname}-%{version}
 
 
-- 
