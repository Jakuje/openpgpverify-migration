From d6a2fefefacb3d61d1eeb7deece145343fc7b62c Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 3 Nov 2026 11:00:32 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 qemu-sanity-check.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/qemu-sanity-check.spec b/qemu-sanity-check.spec
index 2305cfc..862221b 100644
--- a/qemu-sanity-check.spec
+++ b/qemu-sanity-check.spec
@@ -10,7 +10,7 @@
 
 Name:           qemu-sanity-check
 Version:        1.1.6
-Release:        22%{?dist}
+Release:        23%{?dist}
 Summary:        Simple qemu and Linux kernel sanity checker
 License:        GPL-2.0-or-later
 
@@ -73,6 +73,7 @@ BuildRequires:  kernel
 # into a /boot/<machine-id> subdirectory (in Fedora >= 23).  Read the
 # kernel-install script to understand why.
 BuildRequires:  grubby
+BuildRequires:  openpgpverify
 
 %if !0%{?rhel}
 %ifarch %{ix86} x86_64
@@ -131,7 +132,7 @@ as %{name} except that this package does not depend on qemu or kernel.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 autoreconf -fi
 
@@ -178,6 +179,9 @@ make DESTDIR=$RPM_BUILD_ROOT install
 
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 1.1.6-23
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.1.6-22
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

