From 885503330ce83264bd8b8a7143724ae95c46a60d Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 22 Oct 2026 13:10:17 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 squid.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/squid.spec b/squid.spec
index ab7b7d8..f8a950b 100644
--- a/squid.spec
+++ b/squid.spec
@@ -3,7 +3,7 @@
 
 Name:     squid
 Version:  7.7
-Release:  1%{?dist}
+Release:  2%{?dist}
 Summary:  The Squid proxy caching server
 Epoch:    7
 # See CREDITS for breakdown of non GPLv2+ code
@@ -74,6 +74,7 @@ BuildRequires: gnupg2
 BuildRequires: systemd-rpm-macros
 # systemd notify
 BuildRequires: systemd-devel
+BuildRequires: openpgpverify
 
 %{?systemd_requires}
 %{?sysusers_requires_compat}
@@ -94,7 +95,7 @@ lookup program (dnsserver), a program for retrieving FTP data
 (ftpget), and some management and client tools.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 
 %autosetup -p1
 
@@ -313,6 +314,9 @@ fi
 
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 7:7.7-2
+- Verify upstream source signatures with openpgpverify
+
 * Wed Sep 16 2026 Luboš Uhliarik <luhliari@redhat.com> - 7:7.7-1
 - new version 7.7
 
-- 
2.55.0

