From b8acc3e85d5dcedc31f29bb46afd3ace3df24ca6 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 3 Nov 2026 11:35:59 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 supermin.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/supermin.spec b/supermin.spec
index e8fddc2..9a7a486 100644
--- a/supermin.spec
+++ b/supermin.spec
@@ -38,7 +38,7 @@ ExcludeArch: %{ix86}
 Summary:       Tool for creating supermin appliances
 Name:          supermin
 Version:       5.3.5
-Release:       12%{?dist}
+Release:       13%{?dist}
 License:       GPL-2.0-or-later
 
 ExclusiveArch: %{kernel_arches}
@@ -103,6 +103,7 @@ BuildRequires: kernel-core
 BuildRequires: grubby
 # https://bugzilla.redhat.com/show_bug.cgi?id=1331012
 BuildRequires: systemd-udev
+BuildRequires: openpgpverify
 
 # This only includes the dependencies needed at runtime, ie.  supermin
 # --build.  For supermin --prepare, dependencies like dnf are placed
@@ -156,7 +157,7 @@ supermin appliances.
 
 %prep
 %if 0%{verify_tarball_signature}
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 %setup -q
 %autopatch -p1
@@ -211,6 +212,9 @@ make check || {
 
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 5.3.5-13
+- Verify upstream source signatures with openpgpverify
+
 * Tue Sep 15 2026 Richard W.M. Jones <rjones@redhat.com> - 5.3.5-12
 - OCaml 5.5.1 rebuild
 
-- 
