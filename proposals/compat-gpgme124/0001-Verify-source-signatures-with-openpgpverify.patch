From a06b3f49ed5e14d6d7308f1fb4b06c44ab19d3d1 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:34:58 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 compat-gpgme124.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/compat-gpgme124.spec b/compat-gpgme124.spec
index a857cdc..f2f1d43 100644
--- a/compat-gpgme124.spec
+++ b/compat-gpgme124.spec
@@ -15,7 +15,7 @@
 Name:           compat-gpgme124
 Summary:        GnuPG Made Easy - high level crypto API
 Version:        1.24.3
-Release:        13%{?dist}
+Release:        14%{?dist}
 
 # MIT: src/cJSON.{c,h} (used by gpgme-json)
 License:        LGPL-2.1-or-later AND MIT
@@ -46,7 +46,7 @@ BuildRequires:  gawk
 BuildRequires:  texinfo
 BuildRequires:  gnupg2 >= %{gnupg2_min_ver}
 BuildRequires:  gnupg2-smime
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 BuildRequires:  libgpg-error-devel >= %{libgpg_error_min_ver}
 BuildRequires:  libassuan-devel >= 2.4.2
 
@@ -158,7 +158,7 @@ Requires:       q%{name}-common-devel%{?_isa}
 %endif
 
 %prep
-%{gpgverify} --keyring=%{SOURCE3} --signature=%{SOURCE1} --data=%{SOURCE0}
+%{openpgpverify} --keyring=%{SOURCE3} --signature=%{SOURCE1} --data=%{SOURCE0}
 %autosetup -n gpgme-%{version} -p1 -S gendiff
 
 ## HACK ALERT
@@ -323,6 +323,9 @@ popd
 %endif
 
 %changelog
+* Fri Oct 23 2026 Jakub Jelen <jjelen@redhat.com> - 1.24.3-14
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.24.3-13
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

