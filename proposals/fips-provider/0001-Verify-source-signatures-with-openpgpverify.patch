From 96b2c4923166f1cfd9b184336b6e8db1192cd54e Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 12 Oct 2026 14:12:59 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 fips-provider.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/fips-provider.spec b/fips-provider.spec
index e728218..8d4bd66 100644
--- a/fips-provider.spec
+++ b/fips-provider.spec
@@ -66,6 +66,7 @@ BuildRequires:  perl(Test::Harness), perl(Test::More), perl(Math::BigInt)
 BuildRequires:  perl(Module::Load::Conditional), perl(File::Temp) perl(Time::Piece)
 BuildRequires:  perl(Time::HiRes), perl(IPC::Cmd), perl(Pod::Html), perl(Digest::SHA)
 BuildRequires:  perl(FindBin), perl(lib), perl(File::Compare), perl(File::Copy), perl(bigint)
+BuildRequires:  openpgpverify
 
 Provides:       fips-provider-so
 Provides:       bundled(openssl) = %{osslver}
@@ -85,7 +86,7 @@ as well as a PKCS#11 software token.
 
 %prep
 %if %{with gpgcheck}
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 
 # Preps kryoptic
