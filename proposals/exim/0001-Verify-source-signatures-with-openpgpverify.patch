From 41f46e0e9b908599641cfb490495ceaf26934568 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 21:26:23 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 exim.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/exim.spec b/exim.spec
index f23e445..425febc 100644
--- a/exim.spec
+++ b/exim.spec
@@ -12,7 +12,7 @@
 Summary: The exim mail transfer agent
 Name: exim
 Version: 4.100.1
-Release: 1%{?dist}
+Release: 2%{?dist}
 # Automatically converted from old format: GPLv2+ - review is highly recommended.
 License: GPL-2.0-or-later
 Url: https://www.exim.org/
@@ -89,7 +89,7 @@ BuildRequires: libgsasl-devel
 # Workaround for NIS removal from glibc, bug 1534920
 BuildRequires: libnsl2-devel
 BuildRequires: libtirpc-devel
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: grep
 BuildRequires: perl-devel
 BuildRequires: perl-generators
@@ -188,7 +188,7 @@ greylisting for whatever 'offences' you can dream of, or even to make
 greylisting unconditional.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 cp src/EDITME Local/Makefile
@@ -512,6 +512,9 @@ fi
 %{_sysconfdir}/cron.daily/greylist-tidy.sh
 
 %changelog
+* Fri Oct 23 2026 Jakub Jelen <jjelen@redhat.com> - 4.100.1-2
+- Verify upstream source signatures with openpgpverify
+
 * Tue Oct 06 2026 Jaroslav Škarvada <jskarvad@redhat.com> - 4.100.1-1
 - New version
   Resolves: rhbz#2537003
-- 
2.56.0

