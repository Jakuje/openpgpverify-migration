From 0959a09c1095235f24d30c6c174fabaeb1d66510 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:47 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 qgpgme.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/qgpgme.spec b/qgpgme.spec
index 014ae7d..0b80b58 100644
--- a/qgpgme.spec
+++ b/qgpgme.spec
@@ -6,7 +6,7 @@ Name:           qgpgme
 Summary:        Qt API bindings/wrapper for GPGME
 Epoch:          1
 Version:        2.2.0
-Release:        1%{?dist}
+Release:        2%{?dist}
 
 License:        GPL-2.0-or-later
 URL:            https://gnupg.org/related_software/gpgme/
@@ -27,6 +27,7 @@ BuildRequires:  pkgconfig(gpg-error) >= 1.47
 
 # to remove RPATH
 BuildRequires:  chrpath
+BuildRequires:  openpgpverify
 
 %description
 %{summary}. GnuPG Made Easy (GPGME) is a library
@@ -84,7 +85,7 @@ Requires:       pkgconfig(gpg-error) >= 1.47
 
 %prep
 # verify sources
-%{gpgverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
+%{openpgpverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
 %autosetup -p1 -S gendiff
 
 
@@ -135,6 +136,9 @@ chrpath -d %{buildroot}%{_libdir}/lib%{name}qt6.so*
 %endif
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 1:2.2.0-2
+- Verify upstream source signatures with openpgpverify
+
 * Tue Oct 13 2026 Michal Hlavinka <mhlavink@redhat.com> - 1:2.2.0-1
 - updated to 2.2.0
 
-- 
2.56.0

