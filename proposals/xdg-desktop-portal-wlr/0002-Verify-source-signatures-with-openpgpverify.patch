From f5a25d9dd0544163ec4c4aca73dff6f69971cbc5 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:48 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 xdg-desktop-portal-wlr.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/xdg-desktop-portal-wlr.spec b/xdg-desktop-portal-wlr.spec
index 2abad2b..5f785bb 100644
--- a/xdg-desktop-portal-wlr.spec
+++ b/xdg-desktop-portal-wlr.spec
@@ -1,6 +1,6 @@
 Name:           xdg-desktop-portal-wlr
 Version:        0.8.4
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        xdg-desktop-portal backend for wlroots
 
 License:        MIT
@@ -13,7 +13,7 @@ Source2:        https://emersion.fr/.well-known/openpgpkey/hu/dj3498u4hyyarh35rk
 Source3:        wlroots-portals.conf
 
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  meson
 BuildRequires:  systemd-rpm-macros
 
@@ -48,7 +48,7 @@ remote-desktop xdg-desktop-portal interfaces for wlroots based compositors.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 
@@ -83,6 +83,9 @@ install -D -pv -m644 %{SOURCE3} \
 
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 0.8.4-2
+- Verify upstream source signatures with openpgpverify
+
 * Sun Aug 02 2026 Aleksei Bavshin <alebastr@fedoraproject.org> - 0.8.4-1
 - Update to 0.8.4 (#2490450)
 
-- 
