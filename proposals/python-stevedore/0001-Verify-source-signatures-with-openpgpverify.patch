From e3ec3146249bd3d3c917fd13e68b203b58cd701e Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:54 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 python-stevedore.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/python-stevedore.spec b/python-stevedore.spec
index 24367f9..ff419bf 100644
--- a/python-stevedore.spec
+++ b/python-stevedore.spec
@@ -24,7 +24,7 @@ BuildArch:      noarch
 
 # Required for tarball sources verification
 %if 0%{?sources_gpg} == 1
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 %endif
 BuildRequires:  python3-devel
 BuildRequires:  git-core
@@ -45,7 +45,7 @@ Group:          Development/Libraries
 %prep
 # Required for tarball sources verification
 %if 0%{?sources_gpg} == 1
-%{gpgverify}  --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify}  --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 %setup -q -n stevedore-%{version}
 
-- 
2.56.0

