From 7ab0e0c7f3c2fbd40d7ac8221af0a931aa22bc0a Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:53 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 python-stevedore.spec | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/python-stevedore.spec b/python-stevedore.spec
index 24367f9..619c8cc 100644
--- a/python-stevedore.spec
+++ b/python-stevedore.spec
@@ -23,11 +23,9 @@ Source2:        https://releases.openstack.org/_static/%{sources_gpg_sign}.txt
 BuildArch:      noarch
 
 # Required for tarball sources verification
-%if 0%{?sources_gpg} == 1
-BuildRequires:  gpgverify
-%endif
 BuildRequires:  python3-devel
 BuildRequires:  git-core
+BuildRequires:  openpgpverify
 
 %description
 %{common_desc}
@@ -45,7 +43,7 @@ Group:          Development/Libraries
 %prep
 # Required for tarball sources verification
 %if 0%{?sources_gpg} == 1
-%{gpgverify}  --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify}  --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 %setup -q -n stevedore-%{version}
 
-- 
2.56.0

