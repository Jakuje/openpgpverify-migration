From 3ab7a1119e5cc6424090f14145e83ff51ccd5e38 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 19:21:00 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 libgsasl.spec | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/libgsasl.spec b/libgsasl.spec
index 22b1f34..a6ffc44 100644
--- a/libgsasl.spec
+++ b/libgsasl.spec
@@ -1,6 +1,6 @@
 Name:           libgsasl
 Version:        1.10.0
-Release:        17%{?dist}
+Release:        18%{?dist}
 Summary:        GNU SASL library
 License:        LGPL-2.1-or-later
 URL:            https://www.gnu.org/software/gsasl/
@@ -12,8 +12,8 @@ Source2:        https://josefsson.org/54265e8c.txt
 Patch:          0001-GSSAPI-server-Boundary-check-gss_wrap-token-read-OOB.patch
 Patch:          0002-Fix-NULL-pointer-dereference-in-DIGEST-MD5-parser.patch
 BuildRequires:  gcc
-# for %%gpgverify
-BuildRequires:  gnupg2
+# for %%openpgpverify
+BuildRequires:  openpgpverify
 BuildRequires:  krb5-devel
 BuildRequires:  libgcrypt-devel
 BuildRequires:  libidn-devel
@@ -37,7 +37,7 @@ The %{name}-devel package contains libraries and header files for
 developing applications that use %{name}.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p2
 
 %build
@@ -63,6 +63,9 @@ find %{buildroot} -name '*.la' -exec rm -f {} ';'
 %{_libdir}/pkgconfig/libgsasl.pc
 
 %changelog
+* Fri Oct 23 2026 Jakub Jelen <jjelen@redhat.com> - 1.10.0-18
+- Verify upstream source signatures with openpgpverify
+
 * Fri Aug  7 2026 Peter Lemenkov <lemenkov@gmail.com> - 1.10.0-17
 - Fix CVE-2026-48829
 
-- 
2.56.0

