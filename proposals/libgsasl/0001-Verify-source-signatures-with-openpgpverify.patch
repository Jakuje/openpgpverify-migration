@@ -1,17 +1,21 @@
 Name:           libgsasl
 Version:        1.10.0
-Release:        17%{?dist}
+Release:        18%{?dist}
 Summary:        GNU SASL library
 License:        LGPL-2.1-or-later
 URL:            https://www.gnu.org/software/gsasl/
 Source0:        https://ftp.gnu.org/gnu/gsasl/%{name}-%{version}.tar.gz
 Source1:        https://ftp.gnu.org/gnu/gsasl/%{name}-%{version}.tar.gz.sig
+# Refreshed from keyservers/WKD (same keys, newer signatures):
+#   sq --home=none network search --output - 9AA9BDB11BB1B99A21285A330664A76954265E8C | sq keyring filter --experimental --cert 9AA9BDB11BB1B99A21285A330664A76954265E8C --output update.pgp
+#   sq keyring merge 54265e8c.txt update.pgp | sq packet dearmor --output 54265e8c.txt.new
+#   mv 54265e8c.txt.new 54265e8c.txt
 Source2:        https://josefsson.org/54265e8c.txt
 Patch:          0001-GSSAPI-server-Boundary-check-gss_wrap-token-read-OOB.patch
 Patch:          0002-Fix-NULL-pointer-dereference-in-DIGEST-MD5-parser.patch
 BuildRequires:  gcc
-# for %%gpgverify
-BuildRequires:  gnupg2
+# for %%openpgpverify
