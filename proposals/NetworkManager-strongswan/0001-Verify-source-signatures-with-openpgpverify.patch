From d58bceb19adc799dc7e5a4a553db6f1ffffaddc1 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:50 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 NetworkManager-strongswan.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/NetworkManager-strongswan.spec b/NetworkManager-strongswan.spec
index 504cb55..c113cbf 100644
--- a/NetworkManager-strongswan.spec
+++ b/NetworkManager-strongswan.spec
@@ -17,7 +17,7 @@
 
 Name:      NetworkManager-strongswan
 Version:   1.6.0
-Release:   13%{?dist}
+Release:   14%{?dist}
 Summary:   NetworkManager strongSwan IPSec VPN plug-in
 # Automatically converted from old format: GPLv2+ - review is highly recommended.
 License:   GPL-2.0-or-later
@@ -34,7 +34,7 @@ BuildRequires: pkgconfig(libnma) >= 1.1.0
 BuildRequires: intltool
 BuildRequires: libtool
 %if 0%{?fedora}
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 %endif
 
 %if %{with gtk4}
@@ -73,7 +73,7 @@ with the graphical desktop.
 
 %prep
 %if 0%{?fedora}
-%gpgverify -k 2 -d 0 -s 1
+%openpgpverify -k 2 -d 0 -s 1
 %endif
 %autosetup -p1
 
@@ -119,6 +119,9 @@ rm -f %{buildroot}%{_libdir}/NetworkManager/libnm-*.la
 
 
 %changelog
+* Fri Oct 30 2026 Jakub Jelen <jjelen@redhat.com> - 1.6.0-14
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.6.0-13
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

