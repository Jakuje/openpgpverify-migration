From 99173e4e29a5f68b09f09449bc5afd47488952d1 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:42 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 xz.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/xz.spec b/xz.spec
index 6f750bb..894c5b9 100644
--- a/xz.spec
+++ b/xz.spec
@@ -5,7 +5,7 @@ Summary:	LZMA compression utilities
 Name:		xz
 Epoch:		1
 Version:	5.8.4
-Release:	1%{?dist}
+Release:	2%{?dist}
 
 # liblzma - 0BSD
 # xz{,dec}, lzma{dec,info} - 0BSD
@@ -37,6 +37,7 @@ BuildRequires:	gcc
 BuildRequires:	gnupg2
 BuildRequires:	perl-interpreter
 BuildRequires:	autoconf automake libtool gettext-devel
+BuildRequires:	openpgpverify
 
 
 %description
@@ -91,7 +92,7 @@ commands that deal with the older LZMA format.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 autoreconf -fi
 
@@ -184,6 +185,9 @@ LD_LIBRARY_PATH=$PWD/src/liblzma/.libs make check
 
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 1:5.8.4-2
+- Verify upstream source signatures with openpgpverify
+
 * Thu Sep 10 2026 Richard W.M. Jones <rjones@redhat.com> - 1:5.8.4-1
 - Update to 5.8.4 (RHBZ#2531115)
 
-- 
2.56.0

