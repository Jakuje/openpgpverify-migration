From a2ab1cbc1197c666b0802cab61006d34fe0eb810 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 12 Oct 2026 14:12:59 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 emacs.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/emacs.spec b/emacs.spec
index 111abff..8a95902 100644
--- a/emacs.spec
+++ b/emacs.spec
@@ -117,6 +117,7 @@ BuildRequires: systemd-devel
 BuildRequires: systemd-rpm-macros
 BuildRequires: texinfo
 BuildRequires: zlib-devel
+BuildRequires: openpgpverify
 
 %if v"%{version}" < v"31"
 BuildRequires: pkgconfig(tree-sitter) < 0.26
@@ -335,7 +336,7 @@ Development header files for Emacs.
 
 %prep
 cat '%{SOURCE100}' '%{SOURCE101}' '%{SOURCE102}' '%{SOURCE103}' > keyring
-%{gpgverify} --keyring=keyring --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring=keyring --signature='%{SOURCE1}' --data='%{SOURCE0}'
 rm keyring
 
 %autosetup -N -c
-- 
2.55.0

