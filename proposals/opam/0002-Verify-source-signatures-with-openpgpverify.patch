From 7ebc164737602a1c5bf776f945bae2568ba8eebd Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:58 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 opam.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/opam.spec b/opam.spec
index ac4f08a..c6ddf18 100644
--- a/opam.spec
+++ b/opam.spec
@@ -38,7 +38,7 @@ Patch:          %{name}-disable-tests.patch
 BuildRequires:  diffutils
 BuildRequires:  gcc-c++
 BuildRequires:  git-core
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 BuildRequires:  make
 BuildRequires:  ocaml >= 4.11.0
 BuildRequires:  ocaml-base64-devel >= 3.1.0
@@ -107,7 +107,7 @@ Standalone script for working with opam .install files, see the opam package
 for more information.
 
 %prep
-%{gpgverify} --data=%{SOURCE0} --signature=%{SOURCE1} --keyring=%{SOURCE2}
+%{openpgpverify} --data=%{SOURCE0} --signature=%{SOURCE1} --keyring=%{SOURCE2}
 %autosetup -n %{name}-full-%{version} -p1
 sed -e 's,%%SOURCE3%%,%{SOURCE3},' \
     -e 's,%%SOURCE4%%,%{SOURCE4},' \
-- 
2.56.0

