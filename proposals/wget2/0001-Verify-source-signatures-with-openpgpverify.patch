From 42087e601c510063ecae48ff8b298d69d8482252 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:58 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 wget2.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/wget2.spec b/wget2.spec
index e9953a6..ad55634 100644
--- a/wget2.spec
+++ b/wget2.spec
@@ -8,7 +8,7 @@
 
 Name:           wget2
 Version:        2.3.0
-Release:        3%{?dist}
+Release:        4%{?dist}
 Summary:        An advanced file and recursive website downloader
 
 # Documentation is GFDL
@@ -73,6 +73,7 @@ BuildRequires:  lzip
 
 # For gpg signature verification
 BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 
 Provides:       webclient
 Requires:       %{name}-libs%{?_isa} = %{version}-%{release}
@@ -123,7 +124,7 @@ the system provider of wget.
 %endif
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -S git_am
 
 
@@ -187,6 +188,9 @@ echo ".so man1/%{name}.1" > %{buildroot}%{_mandir}/man1/wget.1
 
 
 %changelog
+* Sat Oct 31 2026 Jakub Jelen <jjelen@redhat.com> - 2.3.0-4
+- Verify upstream source signatures with openpgpverify
+
 * Fri Oct 30 2026 Artur Frenszek-Iwicki <fedora@svgames.pl> - 2.3.0-3
 - Backport a patch fixing program crash after failed request
 
-- 
2.56.0

