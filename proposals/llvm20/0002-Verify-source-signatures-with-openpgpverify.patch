From 1bb46389a50acc948bf10eb609b11a2a475f68ae Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 6 Nov 2026 09:01:14 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 llvm20.spec | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/llvm20.spec b/llvm20.spec
index 15fff89..edd6247 100644
--- a/llvm20.spec
+++ b/llvm20.spec
@@ -547,7 +547,7 @@ BuildRequires:	python%{python3_pkgversion}-rpm-macros
 %endif
 
 # For gpg source verification
-BuildRequires:	gnupg2
+BuildRequires:	openpgpverify
 
 BuildRequires:	swig
 BuildRequires:	libxml2-devel
@@ -1178,11 +1178,11 @@ Polly header files.
 %prep
 %if %{without snapshot_build}
 # llvm
-%{gpgverify} --keyring='%{SOURCE6}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE6}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 
 %if %{with bundle_compat_lib}
-%{gpgverify} --keyring='%{SOURCE6}' --signature='%{SOURCE3001}' --data='%{SOURCE3000}'
+%{openpgpverify} --keyring='%{SOURCE6}' --signature='%{SOURCE3001}' --data='%{SOURCE3000}'
 %setup -T -q -b 3000 -n llvm-project-%{compat_ver}.src
 
 # Apply all patches with number < 500 (unconditionally)
-- 
