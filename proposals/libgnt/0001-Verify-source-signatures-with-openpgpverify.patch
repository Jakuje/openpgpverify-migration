From 28e3df9efb1cc297f83b903b9d37e0574056676a Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 08:28:38 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 libgnt.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/libgnt.spec b/libgnt.spec
index bfe1df9..fe12195 100644
--- a/libgnt.spec
+++ b/libgnt.spec
@@ -1,7 +1,7 @@
 Summary:	GLib Ncurses Toolkit
 Name:		libgnt
 Version:	2.14.3
-Release:	4%{?dist}
+Release:	5%{?dist}
 # Automatically converted from old format: GPLv2+ - review is highly recommended.
 License:	GPL-2.0-or-later
 URL:		https://keep.imfreedom.org/libgnt/libgnt/
@@ -15,6 +15,7 @@ BuildRequires:	libxml2-devel
 BuildRequires:	ncurses-devel
 BuildRequires:	python3-devel
 BuildRequires:	gnupg2
+BuildRequires:	openpgpverify
 Source0:	https://sourceforge.net/projects/pidgin/files/%{name}/%{version}/%{name}-%{version}.tar.xz
 Source1:	https://sourceforge.net/projects/pidgin/files/%{name}-%{version}.tar.xz.asc
 # https://issues.imfreedom.org/issue/LIBGNT-10
@@ -40,7 +41,7 @@ Summary:	Documentation for libgnt
 Documentation files for libgnt.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
@@ -68,6 +69,9 @@ Documentation files for libgnt.
 %{_datadir}/gtk-doc
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 2.14.3-5
+- Verify upstream source signatures with openpgpverify
+
 * Thu Sep 10 2026 Zbigniew Jędrzejewski-Szmek <zbyszek@in.waw.pl> - 2.14.3-4
 - Rebuilt for libxml-2.5.4
 
-- 
2.56.0

