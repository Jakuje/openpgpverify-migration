From 01508b7774af43be8d5cc46e40e30611b29a88ed Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:09:04 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Refresh gpgkey-6D5B_EF9A_DD20_7580_5747_B70F_9F88_FB52_FAF7_B393.gpg
from keyservers/WKD: same certificate(s), with self-signatures our copy
was missing; the commands are in the spec comment.
Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 borgbackup.spec                               |  13 ++++++++++---
 ...D20_7580_5747_B70F_9F88_FB52_FAF7_B393.gpg | Bin 5745 -> 162131 bytes
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/borgbackup.spec b/borgbackup.spec
index ac92a6a..e644e7f 100644
--- a/borgbackup.spec
+++ b/borgbackup.spec
@@ -2,7 +2,7 @@
 
 Name:           %{srcname}
 Version:        1.4.5
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        A deduplicating backup program with compression and authenticated encryption
 # zlib:         src/borg/algorithms/{crc32_clmul.c, crc32_slice_by_8.c}
 # Apache-2.0:   src/borg/cache_sync/{sysdep.h, unpack.h, unpack_template.h, unpack_define.h}
@@ -14,7 +14,10 @@ Source0:        https://github.com/borgbackup/borg/releases/download/%{version}/
 Source1:        https://github.com/borgbackup/borg/releases/download/%{version}/borgbackup-%{version}.tar.gz.asc
 # upstream publishes only key ids:
 #    https://borgbackup.readthedocs.io/en/stable/support.html#verifying-signed-releases
-# gpg2 --export --export-options export-minimal "6D5B EF9A DD20 7580 5747 B70F 9F88 FB52 FAF7 B393" > gpgkey-6D5B_EF9A_DD20_7580_5747_B70F_9F88_FB52_FAF7_B393.gpg
+# Refreshed from keyservers/WKD (same keys, newer signatures):
+#   sq --home=none network search --output - 6D5BEF9ADD2075805747B70F9F88FB52FAF7B393 | sq keyring filter --experimental --cert 6D5BEF9ADD2075805747B70F9F88FB52FAF7B393 --output update.pgp
+#   sq keyring merge gpgkey-6D5B_EF9A_DD20_7580_5747_B70F_9F88_FB52_FAF7_B393.gpg update.pgp | sq packet dearmor --output gpgkey-6D5B_EF9A_DD20_7580_5747_B70F_9F88_FB52_FAF7_B393.gpg.new
+#   mv gpgkey-6D5B_EF9A_DD20_7580_5747_B70F_9F88_FB52_FAF7_B393.gpg.new gpgkey-6D5B_EF9A_DD20_7580_5747_B70F_9F88_FB52_FAF7_B393.gpg
 Source2:        gpgkey-6D5B_EF9A_DD20_7580_5747_B70F_9F88_FB52_FAF7_B393.gpg
 
 # we don't need the guzzley_sphinx theme for only man page generation
@@ -44,6 +47,7 @@ BuildRequires:  libacl-devel
 BuildRequires:  lz4-devel >= 1.7.0
 BuildRequires:  libzstd-devel >= 1.3.0
 BuildRequires:  xxhash-devel >= 0.7.3
+BuildRequires:  openpgpverify
 
 # msgpack dependency is detected automatically
 Requires:       python3-llfuse >= 1.3.8
@@ -54,7 +58,7 @@ BorgBackup (short: Borg) is a deduplicating backup program. Optionally, it
 supports compression and authenticated encryption.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 rm -rf %{srcname}.egg-info
 
@@ -136,6 +140,9 @@ TEST_SELECTOR="not test_fuse and not test_readonly_mount and not benchmark"
 
 
 %changelog
+* Mon Oct 26 2026 Jakub Jelen <jjelen@redhat.com> - 1.4.5-2
+- Verify upstream source signatures with openpgpverify
+
 * Tue Jul 28 2026 Felix Schwarz <fschwarz@fedoraproject.org> - 1.4.5-1
 - update to 1.4.5
 
diff --git a/gpgkey-6D5B_EF9A_DD20_7580_5747_B70F_9F88_FB52_FAF7_B393.gpg b/gpgkey-6D5B_EF9A_DD20_7580_5747_B70F_9F88_FB52_FAF7_B393.gpg
