From 4b950052a95793ce62bd93b8ef5f6bcad2f4cbef Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 10:38:42 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 borgbackup.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/borgbackup.spec b/borgbackup.spec
index 0f9bcb8..1bdb65e 100644
--- a/borgbackup.spec
+++ b/borgbackup.spec
@@ -2,7 +2,7 @@
 
 Name:           %{srcname}
 Version:        1.4.5
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        A deduplicating backup program with compression and authenticated encryption
 # zlib:         src/borg/algorithms/{crc32_clmul.c, crc32_slice_by_8.c}
 # Apache-2.0:   src/borg/cache_sync/{sysdep.h, unpack.h, unpack_template.h, unpack_define.h}
@@ -43,6 +43,7 @@ BuildRequires:  libacl-devel
 BuildRequires:  lz4-devel >= 1.7.0
 BuildRequires:  libzstd-devel >= 1.3.0
 BuildRequires:  xxhash-devel >= 0.7.3
+BuildRequires:  openpgpverify
 
 # msgpack dependency is detected automatically
 Requires:       python3-llfuse >= 1.3.8
@@ -53,7 +54,7 @@ BorgBackup (short: Borg) is a deduplicating backup program. Optionally, it
 supports compression and authenticated encryption.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 rm -rf %{srcname}.egg-info
 
@@ -135,6 +136,9 @@ TEST_SELECTOR="not test_fuse and not test_readonly_mount and not benchmark"
 
 
 %changelog
+* Mon Oct 26 2026 Jakub Jelen <jjelen@redhat.com> - 1.4.5-2
+- Verify upstream source signatures with openpgpverify
+
 * Tue Jul 28 2026 Felix Schwarz <fschwarz@fedoraproject.org> - 1.4.5-1
 - update to 1.4.5
 
-- 
2.56.0

