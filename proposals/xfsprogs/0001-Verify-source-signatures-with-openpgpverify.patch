From b2cdb1e96e0cef056164baa9924a6cc751ba998e Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 12 Oct 2026 14:13:02 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 xfsprogs.spec | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/xfsprogs.spec b/xfsprogs.spec
index 7050ff0..516ee30 100644
--- a/xfsprogs.spec
+++ b/xfsprogs.spec
@@ -1,7 +1,7 @@
 Summary:	Utilities for managing the XFS filesystem
 Name:		xfsprogs
 Version:	7.2.0
-Release:	1%{?dist}
+Release:	2%{?dist}
 License:	GPL-1.0-or-later AND LGPL-2.1-or-later
 URL:		https://xfs.wiki.kernel.org
 Source0:	http://kernel.org/pub/linux/utils/fs/xfs/xfsprogs/%{name}-%{version}.tar.xz
@@ -14,7 +14,8 @@ BuildRequires:	g++
 BuildRequires:	libtool, gettext, libattr-devel, libuuid-devel
 BuildRequires:	libedit-devel, libblkid-devel >= 2.17-0.1.git5e51568
 Buildrequires:	libicu-devel >= 4.6, systemd
-BuildRequires:	gnupg2, xz, inih-devel, userspace-rcu-devel
+BuildRequires:	xz, inih-devel, userspace-rcu-devel
+BuildRequires:	openpgpverify
 Provides:	xfs-cmds
 Obsoletes:	xfs-cmds <= %{version}
 Provides:	xfsprogs-qa-devel
@@ -75,7 +76,7 @@ Extra utilities for XFS filesystems, such as xfs_protofile, that may require
 Python.
 
 %prep
-xzcat '%{SOURCE0}' | %{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
+xzcat '%{SOURCE0}' | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %autosetup -p1
 
 # Inject libicuuc to fix link error:
@@ -159,6 +160,9 @@ rm -rf $RPM_BUILD_ROOT/%{_datadir}/doc/xfsprogs/
 %{_libdir}/*.so
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 7.2.0-2
+- Verify upstream source signatures with openpgpverify
+
 * Thu Sep 17 2026 Pavel Reichl <preichl@redhat.com> - 7.2.0-1
 - Update to upstream v7.2.0
 - Related: rhbz#2535943
-- 
2.55.0

