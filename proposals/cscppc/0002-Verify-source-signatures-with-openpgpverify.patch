From e146f034adbff60811b58071a1fd51d799e62795 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:33 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 cscppc.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/cscppc.spec b/cscppc.spec
index 7a711d9..d4fa54e 100644
--- a/cscppc.spec
+++ b/cscppc.spec
@@ -3,7 +3,7 @@
 
 Name:       cscppc
 Version:    2.2.8
-Release:    2%{?dist}
+Release:    3%{?dist}
 Summary:    A compiler wrapper that runs Cppcheck in background
 
 License:    GPL-3.0-or-later
@@ -18,7 +18,7 @@ Source2:    kdudka.pgp
 BuildRequires: asciidoc
 BuildRequires: cmake
 BuildRequires: gcc
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 
 # csmock copies the resulting cscppc binary into mock chroot, which may contain
 # an older (e.g. RHEL-7) version of glibc, and it would not dynamically link
@@ -77,7 +77,7 @@ This package contains the csmatch compiler wrapper that runs the Smatch analyzer
 in background fully transparently.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
@@ -139,6 +139,9 @@ done
 %{_mandir}/man1/csmatch.1*
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 2.2.8-3
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 2.2.8-2
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

