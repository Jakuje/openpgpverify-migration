From 520c677410e35403e6e4257fa1959651b98657c2 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 23 Oct 2026 10:26:40 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 ctstream.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/ctstream.spec b/ctstream.spec
index 622b572..794c7ee 100644
--- a/ctstream.spec
+++ b/ctstream.spec
@@ -1,6 +1,6 @@
 Name:           ctstream
 Version:        33
-Release:        10%{?dist}
+Release:        11%{?dist}
 Summary:        Get URLs of Czech Television video streams
 License:        GPL-1.0-or-later
 URL:            http://xpisar.wz.cz/%{name}/
@@ -10,7 +10,7 @@ Source1:        %{url}%{name}-%{version}.asc
 Source2:        gpgkey-E3F42FCE156830A80358E6E94FD1AEC3365AF7BF.gpg
 BuildArch:      noarch
 BuildRequires:  coreutils
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  perl-generators
 Requires:       perl(LWP::Protocol::https)
 
@@ -18,7 +18,7 @@ Requires:       perl(LWP::Protocol::https)
 Get locators of Czech Television video streams for given web page.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 
 %build
 # Empty %%build section for possible RPM hooks
@@ -31,6 +31,9 @@ install %{SOURCE0} %{buildroot}%{_bindir}/%{name}
 %{_bindir}/ctstream
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 33-11
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 33-10
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

