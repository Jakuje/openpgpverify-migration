From f5ae31f33a181c8dfcb5cb0ec53cead6067e5a62 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:35 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 nss-pem.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/nss-pem.spec b/nss-pem.spec
index 52e8b18..ca856e3 100644
--- a/nss-pem.spec
+++ b/nss-pem.spec
@@ -2,7 +2,7 @@
 
 Name:       nss-pem
 Version:    1.1.1
-Release:    5%{?dist}
+Release:    6%{?dist}
 Summary:    PEM file reader for Network Security Services (NSS)
 
 # See README for details
@@ -19,7 +19,7 @@ Source2:    kdudka.pgp
 
 BuildRequires: cmake
 BuildRequires: gcc
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: make
 BuildRequires: nss-pkcs11-devel
 
@@ -31,7 +31,7 @@ PEM file reader for Network Security Services (NSS), implemented as a PKCS#11
 module.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %setup -q
 
 %build
@@ -49,6 +49,9 @@ module.
 %license COPYING.{GPL,MPL}
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 1.1.1-6
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 23 2026 Marcin Juszkiewicz <mjuszkiewicz@redhat.com> - 1.1.1-5
 - Build with CMake 4
 - fix FTBFS (rhbz#2504373)
-- 
2.56.0

