From 4e06b55447566446bce3a04a905b40479f3accfe Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:48 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 python-os-service-types.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/python-os-service-types.spec b/python-os-service-types.spec
index a5fd655..d3da518 100644
--- a/python-os-service-types.spec
+++ b/python-os-service-types.spec
@@ -33,7 +33,7 @@ Source2:        https://releases.openstack.org/_static/%{sources_gpg_sign}.txt
 BuildArch:      noarch
 BuildRequires:  git-core
 %if 0%{?sources_gpg} == 1
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 %endif
 
 
@@ -64,7 +64,7 @@ Documentation for %{pypi_name}
 
 %prep
 %if 0%{?sources_gpg} == 1
-%{gpgverify}  --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
+%{openpgpverify}  --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
 %endif
 %autosetup -n %{module_name}-%{version} -S git
 
-- 
2.56.0

