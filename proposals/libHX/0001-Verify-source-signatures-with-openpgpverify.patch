diff --git a/libHX.spec b/libHX.spec
index b2a3adb..102cc82 100644
--- a/libHX.spec
+++ b/libHX.spec
@@ -1,6 +1,6 @@
 Name:           libHX
 Version:        3.22
-Release:        27%{?dist}
+Release:        28%{?dist}
 Summary:        Useful collection of routines for C and C++ programming
 
 # Automatically converted from old format: LGPLv2 or LGPLv3 - review is highly recommended.
@@ -8,12 +8,17 @@ License:        LicenseRef-Callaway-LGPLv2 OR LGPL-3.0-only
 URL:            http://sourceforge.net/projects/libhx/
 Source0:        http://downloads.sourceforge.net/libhx/libHX-%{version}.tar.xz
 Source1:        http://downloads.sourceforge.net/libhx/libHX-%{version}.tar.asc
+# Refreshed from keyservers/WKD (same keys, newer signatures):
+#   sq --home=none network search --output - B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D | sq keyring filter --experimental --cert B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D --output update.pgp
+#   sq keyring merge gpgkey-B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D.gpg update.pgp | sq packet dearmor --output gpgkey-B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D.gpg.new
+#   mv gpgkey-B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D.gpg.new gpgkey-B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D.gpg
 Source2:        gpgkey-B56B8B9D9915AA8796EDC013DFFF2CDB19FC338D.gpg
 
 BuildRequires:  perl-interpreter gcc-c++
 # For source verification with gpgv
 BuildRequires:  gpg xz
 BuildRequires: make
+BuildRequires:  openpgpverify
 
 
 %description
@@ -39,7 +44,7 @@ developing applications that use %{name}.
 
 
 %prep
-xzcat %{SOURCE0} | gpgv --quiet --keyring %{SOURCE2} %{SOURCE1} -
+xzcat %{SOURCE0} | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %setup -q
 
 
@@ -97,6 +102,9 @@ install -m 644 README.txt \
 
 
 %changelog
