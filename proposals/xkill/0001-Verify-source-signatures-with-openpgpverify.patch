From 912e0c1f7c2d160d9a73fd19aaf512d0535151a4 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 08:28:44 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 xkill.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/xkill.spec b/xkill.spec
index ad20881..047bba2 100644
--- a/xkill.spec
+++ b/xkill.spec
@@ -10,7 +10,7 @@ Source1:        https://www.x.org/pub/individual/app/%{name}-%{version}.tar.xz.s
 Source2:        gpgkey-3AB285232C46AE43D8E192F4DAB0F78EA6E7E2D2.gpg
 
 BuildRequires:  gcc
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 BuildRequires:  meson
 BuildRequires:  pkgconfig(x11)
 BuildRequires:  pkgconfig(xmuu)
@@ -22,7 +22,7 @@ clients. This program is very dangerous, but is useful for aborting
 programs that have displayed undesired windows on a user's screen.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
-- 
2.56.0

