From 1626fc5018e0b1e29b353c3c06da660e78d42a53 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 18:56:55 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 tth.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/tth.spec b/tth.spec
index a1d8dcc..a25e233 100644
--- a/tth.spec
+++ b/tth.spec
@@ -3,7 +3,7 @@
 
 Name:           tth
 Version:        4.16
-Release:        11%{?dist}
+Release:        12%{?dist}
 Summary:        TeX to HTML/MathML translators
 
 License:        GPL-2.0-only
@@ -26,7 +26,7 @@ ExcludeArch:    %{ix86}
 BuildRequires:  flex
 BuildRequires:  gcc
 BuildRequires:  ghostscript
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 BuildRequires:  make
 BuildRequires:  netpbm-progs
 BuildRequires:  tex(amssym.tex)
@@ -132,7 +132,7 @@ Development files for building applications that use TTH.
 
 %prep
 # Verify the source file
-%{gpgverify} --data=%{SOURCE0} --signature=%{SOURCE1} --keyring=%{SOURCE2}
+%{openpgpverify} --data=%{SOURCE0} --signature=%{SOURCE1} --keyring=%{SOURCE2}
 %autosetup -n %{name} -p1
 
 %conf
@@ -251,6 +251,9 @@ cp -p tthgold/tth*.sty %{buildroot}%{_texmf_main}/tex/generic/%{name}
 %{_includedir}/tth.h
 
 %changelog
+* Fri Oct 23 2026 Jakub Jelen <jjelen@redhat.com> - 4.16-12
+- Verify upstream source signatures with openpgpverify
+
 * Fri Jul 17 2026 Fedora Release Engineering <releng@fedoraproject.org> - 4.16-11
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

