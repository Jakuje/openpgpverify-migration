From 96c30206406559816e95895a452edab8198525eb Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 3 Nov 2026 12:51:34 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 nbdkit.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/nbdkit.spec b/nbdkit.spec
index 7e39873..c28d0e1 100644
--- a/nbdkit.spec
+++ b/nbdkit.spec
@@ -55,7 +55,7 @@
 
 Name:           nbdkit
 Version:        1.49.4
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        NBD server
 
 License:        BSD-3-Clause
@@ -152,7 +152,7 @@ BuildRequires:  pkgconfig(tcl)
 BuildRequires:  pkgconfig(lua)
 %endif
 %if 0%{verify_tarball_signature}
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 %endif
 
 # Only for running the test suite:
@@ -824,7 +824,7 @@ development kit for 64 bit versions of Windows.
 
 %prep
 %if 0%{verify_tarball_signature}
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 %autosetup -p1 -S git
 autoreconf -i
@@ -1586,6 +1586,9 @@ fi
 
 
 %changelog
+* Tue Nov 03 2026 Jakub Jelen <jjelen@redhat.com> - 1.49.4-2
+- Verify upstream source signatures with openpgpverify
+
 * Sat Oct 17 2026 Richard W.M. Jones <rjones@redhat.com> - 1.49.4-1
 - New upstream development version 1.49.4
 
-- 
