From 82e204424d06d6925af8606c2759908eeff55604 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 15:23:35 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 0install.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/0install.spec b/0install.spec
index 673939e..b4bfedc 100644
--- a/0install.spec
+++ b/0install.spec
@@ -30,7 +30,7 @@ BuildOption(build): -p 0install-solver
 BuildOption(install): 0install-solver
 BuildOption(check): -p 0install-solver
 
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 BuildRequires:  ocaml >= 4.08
 BuildRequires:  ocaml-dune >= 2.5
 BuildRequires:  ocaml-ounit2-devel
@@ -68,7 +68,7 @@ The %{name}-solver-devel package contains libraries and signature files for
 developing applications that use %{name}-solver.
 
 %prep
-%{gpgverify} --data=%{SOURCE0} --signature=%{SOURCE1} --keyring=%{SOURCE2}
+%{openpgpverify} --data=%{SOURCE0} --signature=%{SOURCE1} --keyring=%{SOURCE2}
 %autosetup
 
 %files -n ocaml-0install-solver -f .ofiles
-- 
2.56.0

