From a7592807237f1a347e1398348d07bcd1ff7cfcc6 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:49 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 sysconftool.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/sysconftool.spec b/sysconftool.spec
index 9482425..274bc1f 100644
--- a/sysconftool.spec
+++ b/sysconftool.spec
@@ -12,7 +12,7 @@ URL:		https://www.courier-mta.org/sysconftool/
 BuildArch:	noarch
 BuildRequires:	autoconf
 BuildRequires:	automake
-BuildRequires:	gnupg2
+BuildRequires:	openpgpverify
 BuildRequires:  make
 BuildRequires:	perl-generators
 
@@ -28,7 +28,7 @@ istniejących aplikacji na nowsze wersje bez straty starszych wersji
 plików konfiguracyjnych.
 
 %prep
-%{gpgverify} --keyring='%{S:2}' --signature='%{S:1}' --data='%{S:0}'
+%{openpgpverify} --keyring='%{S:2}' --signature='%{S:1}' --data='%{S:0}'
 %setup -q
 
 %build
-- 
2.56.0

