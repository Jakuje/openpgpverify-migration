From 3662c26a23695bddb32d6d3a5a4562991b7a794a Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 3 Nov 2026 12:51:34 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 virt-what.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/virt-what.spec b/virt-what.spec
index e53e3a2..8ec6ad4 100644
--- a/virt-what.spec
+++ b/virt-what.spec
@@ -1,6 +1,6 @@
 Name:           virt-what
 Version:        1.27
-Release:        6%{?dist}
+Release:        7%{?dist}
 Summary:        Detect if we are running in a virtual machine
 License:        GPL-2.0-or-later
 
@@ -26,7 +26,7 @@ BuildRequires:  autoconf, automake, libtool
 BuildRequires:  /usr/bin/pod2man
 
 # Required to verify tarball signature.
-BuildRequires: gnupg2
+BuildRequires:  openpgpverify
 
 # Required at build time in order to do 'make check' (for getopt).
 BuildRequires:  util-linux
@@ -95,7 +95,7 @@ Current types of virtualization detected:
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -S git
 
 # Always rebuild upstream autotools files.
@@ -126,6 +126,9 @@ fi
 
 
 %changelog
+* Tue Nov 03 2026 Jakub Jelen <jjelen@redhat.com> - 1.27-7
+- Verify upstream source signatures with openpgpverify
+
 * Fri Jul 17 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.27-6
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
