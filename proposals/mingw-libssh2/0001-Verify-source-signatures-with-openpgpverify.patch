From 36ea8a779b8679f061be343e6615d9641316aabb Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 21:26:28 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 mingw-libssh2.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/mingw-libssh2.spec b/mingw-libssh2.spec
index 08cf292..67b162a 100644
--- a/mingw-libssh2.spec
+++ b/mingw-libssh2.spec
@@ -2,7 +2,7 @@
 
 Name:           mingw-libssh2
 Version:        1.11.1
-Release:        4%{?dist}
+Release:        5%{?dist}
 Summary:        MinGW Windows library implementation of the SSH2 protocol
 
 License:        BSD-3-Clause
@@ -26,6 +26,7 @@ BuildRequires:  mingw64-gcc
 BuildRequires:  mingw64-binutils
 BuildRequires:  mingw64-openssl
 BuildRequires:  mingw64-zlib
+BuildRequires: openpgpverify
 
 
 %description
@@ -76,7 +77,7 @@ Static version of the MinGW Windows SSH2 library.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -n libssh2-%{version}
 
 
@@ -124,6 +125,9 @@ rm -r $RPM_BUILD_ROOT%{mingw64_mandir}/man3
 
 
 %changelog
+* Fri Oct 23 2026 Jakub Jelen <jjelen@redhat.com> - 1.11.1-5
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.11.1-4
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

