From fd40aa08fd5fbdeb68fd4ee5cb49bf9295c668cc Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:55 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 sngrep.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/sngrep.spec b/sngrep.spec
index 35cd292..2e29a3f 100644
--- a/sngrep.spec
+++ b/sngrep.spec
@@ -9,6 +9,7 @@ Source0:        %{url}/releases/download/v%{version}/%{name}-%{version}.tar.gz
 Source1:        %{url}/releases/download/v%{version}/v%{version}.tar.gz.asc
 Source2:        69100FFB90E87A320DF8643CBEC39009E8321A61.gpg
 BuildRequires:  gcc
+BuildRequires:  openpgpverify
 BuildRequires:  pkgconfig(libcrypto)
 BuildRequires:  pkgconfig(libpcap)
 BuildRequires:  pkgconfig(libpcre2-8)
@@ -24,7 +25,7 @@ supports live capture to display realtime SIP packets and can also be used as
 PCAP viewer.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 rm -f README.md
 cp -f README README.md
-- 
