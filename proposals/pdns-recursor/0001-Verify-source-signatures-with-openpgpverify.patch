From 4fc35361f6310cf9eb8387de3dd7ce6ef542d612 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 18:56:53 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 pdns-recursor.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pdns-recursor.spec b/pdns-recursor.spec
index de8a4b0..d8bb383 100644
--- a/pdns-recursor.spec
+++ b/pdns-recursor.spec
@@ -25,7 +25,7 @@ BuildRequires:  chrpath
 BuildRequires:  curl-devel
 BuildRequires:  fstrm-devel
 BuildRequires:  gcc-c++
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  hostname
 BuildRequires:  libcap-devel
 BuildRequires:  libsodium-devel
@@ -53,7 +53,7 @@ PowerDNS Recursor is a non authoritative/recursing DNS server. Use this
 package if you need a dns cache for your network.
 
 %prep
-%{gpgverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
+%{openpgpverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
 %autosetup -n %{name}-%{version} -p1
 
 # Create a sysusers.d config file
-- 
2.56.0

