From 6cc78274db909f63f3e32d60117fc418009f6ab5 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 6 Nov 2026 12:15:42 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 tor.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/tor.spec b/tor.spec
index e52bf18..134e8f2 100644
--- a/tor.spec
+++ b/tor.spec
@@ -14,7 +14,7 @@
 
 Name:       tor
 Version:    0.4.9.15
-Release:    1%{?dist}
+Release:    2%{?dist}
 License:    BSD-3-Clause
 Summary:    Anonymizing overlay network for TCP
 URL:        https://www.torproject.org
@@ -45,7 +45,7 @@ BuildRequires: zlib-devel
 BuildRequires: libzstd-devel
 BuildRequires: xz-devel
 BuildRequires: libcap-devel
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: systemd-devel
 BuildRequires: systemd-rpm-macros
 %{?sysusers_requires_compat}
@@ -83,7 +83,7 @@ Tor network, or as a client to connect to the Tor network.
 
 %prep
 echo "$(cat %{SOURCE1} | cut -d ' ' -f 1) %{SOURCE0}" | sha256sum --check
-%{gpgverify} --keyring='%{SOURCE5}' --signature='%{SOURCE2}' --data='%{SOURCE1}'
+%{openpgpverify} --keyring='%{SOURCE5}' --signature='%{SOURCE2}' --data='%{SOURCE1}'
 %autosetup -p1
 
 
@@ -169,6 +169,9 @@ rm -rf %{buildroot}%{_datadir}/doc
 %{_sysusersdir}/tor.conf
 
 %changelog
+* Fri Nov 06 2026 Jakub Jelen <jjelen@redhat.com> - 0.4.9.15-2
+- Verify upstream source signatures with openpgpverify
+
 * Thu Oct 29 2026 Marcel Härry <mh+fedora@scrit.ch> - 0.4.9.15-1
 - Update to latest upstream release https://forum.torproject.org/t/security-release-0-4-9-15/22332 bz#2562928
 
-- 
