From 7dd382844fd6c753e11b2224b219cd73367cbc32 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:57 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 budgie-backgrounds.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/budgie-backgrounds.spec b/budgie-backgrounds.spec
index 46f6c35..67946a1 100644
--- a/budgie-backgrounds.spec
+++ b/budgie-backgrounds.spec
@@ -1,6 +1,6 @@
 Name:           budgie-backgrounds
 Version:        4.1
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        Default set of background images for the Budgie Desktop
 
 License:        CC0-1.0
@@ -12,14 +12,14 @@ Source2:        https://forge.moderndesktop.dev/BuddiesOfBudgie/keyrings/raw/bra
 BuildArch:      noarch
 BuildRequires:  ImageMagick
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  meson
 
 %description
 Default set of background images for the Budgie Desktop.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
@@ -38,6 +38,9 @@ Default set of background images for the Budgie Desktop.
 %{_datadir}/gnome-background-properties/%{name}.xml
 
 %changelog
+* Mon Oct 26 2026 Jakub Jelen <jjelen@redhat.com> - 4.1-2
+- Verify upstream source signatures with openpgpverify
+
 * Sun Sep 13 2026 Joshua Strobl <joshua@buddiesofbudgie.org> - 4.1-1
 - Update to 4.1
 
-- 
2.56.0

