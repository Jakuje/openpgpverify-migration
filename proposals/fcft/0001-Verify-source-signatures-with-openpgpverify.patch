From e43c0500788b8be5f2911379a9aead7a1c27e0c4 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 15:23:35 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 fcft.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/fcft.spec b/fcft.spec
index d5c321f..804ad02 100644
--- a/fcft.spec
+++ b/fcft.spec
@@ -2,7 +2,7 @@
 
 Name:           fcft
 Version:        3.3.3
-Release:        3%{?dist}
+Release:        4%{?dist}
 Summary:        Simple library for font loading and glyph rasterization
 
 # main source:  MIT
@@ -16,7 +16,7 @@ Source1:        %{url}/releases/download/%{version}/%{name}-%{version}.tar.gz.si
 Source2:        gpgkey-5BBD4992C116573F.asc
 
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  meson >= 0.58.0
 
 BuildRequires:  pkgconfig(check)
@@ -52,7 +52,7 @@ developing applications that use %{name}.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 cp 3rd-party/nanosvg/LICENSE.txt LICENSE.nanosvg
 cp unicode/license.txt LICENSE.Unicode
@@ -91,6 +91,9 @@ rm -f %{buildroot}%{_docdir}/%{name}/LICENSE
 
 
 %changelog
+* Fri Oct 23 2026 Jakub Jelen <jjelen@redhat.com> - 3.3.3-4
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 3.3.3-3
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

