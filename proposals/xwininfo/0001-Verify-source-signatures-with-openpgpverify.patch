From 88cee6df0fdd07b7df282d3cdf783e3e16c7ed77 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:50 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 xwininfo.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/xwininfo.spec b/xwininfo.spec
index f006135..aa6793f 100644
--- a/xwininfo.spec
+++ b/xwininfo.spec
@@ -9,7 +9,7 @@ Source1:    https://xorg.freedesktop.org/archive/individual/app/%{name}-%{versio
 Source2:    gpgkey-3AB285232C46AE43D8E192F4DAB0F78EA6E7E2D2.gpg
 
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  meson
 BuildRequires:  pkgconfig(x11)
 BuildRequires:  pkgconfig(xcb)
@@ -19,7 +19,7 @@ BuildRequires:  pkgconfig(xcb-shape)
 xwininfo prints information about an X11 window.
 
 %prep
-%{gpgverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
+%{openpgpverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
 %autosetup
 
 %build
-- 
2.56.0

