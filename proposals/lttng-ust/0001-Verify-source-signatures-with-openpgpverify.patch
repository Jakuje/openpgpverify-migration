From fafe35b13eac1f2558349fd2b897c4b5441e4fc5 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 12 Oct 2026 14:13:00 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 lttng-ust.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/lttng-ust.spec b/lttng-ust.spec
index e02134a..4694561 100644
--- a/lttng-ust.spec
+++ b/lttng-ust.spec
@@ -14,7 +14,7 @@
 
 Name:           lttng-ust
 Version:        2.16.0
-Release:        1%{?dist}
+Release:        2%{?dist}
 
 License:        LGPL-2.1-only AND MIT AND GPL-2.0-only AND BSD-3-Clause AND BSD-2-Clause
 Summary:        LTTng Userspace Tracer library
@@ -34,6 +34,7 @@ BuildRequires:  libuuid-devel
 BuildRequires:  pkgconfig
 BuildRequires:  systemtap-sdt-devel
 BuildRequires:  userspace-rcu-devel >= 0.15.0
+BuildRequires:  openpgpverify
 %if %{with_numactl}
 BuildRequires:  numactl-devel
 %endif
@@ -68,7 +69,7 @@ applications that use %{name}'s Python logging backend.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
@@ -138,6 +139,9 @@ make check
 %{python3_sitelib}/lttngust-*.egg-info
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 2.16.0-2
+- Verify upstream source signatures with openpgpverify
+
 * Fri Aug 28 2026 Michael Jeanson <mjeanson@efficios.com> - 2.16.0-1
 - New upstream release
 
-- 
2.55.0

