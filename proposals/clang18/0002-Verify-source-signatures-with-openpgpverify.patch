From a580b12b4bad81794778c976b98cf4924bd38a26 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 13:58:43 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 clang18.spec | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/clang18.spec b/clang18.spec
index 80cfe90..bda72d1 100644
--- a/clang18.spec
+++ b/clang18.spec
@@ -75,7 +75,7 @@
 
 Name:		%pkg_name
 Version:	%{clang_version}%{?rc_ver:~rc%{rc_ver}}%{?llvm_snapshot_version_suffix:~%{llvm_snapshot_version_suffix}}
-Release:	11%{?dist}
+Release:	12%{?dist}
 Summary:	A C language family front-end for LLVM
 
 License:	Apache-2.0 WITH LLVM-exception OR NCSA
@@ -166,7 +166,7 @@ BuildRequires: /usr/bin/marshalparser
 BuildRequires:	multilib-rpm-config
 
 # For origin certification
-BuildRequires:	gnupg2
+BuildRequires:	openpgpverify
 
 # scan-build uses these perl modules so they need to be installed in order
 # to run the tests.
@@ -302,12 +302,12 @@ Requires:      python3
 
 %prep
 %if %{without snapshot_build}
-%{gpgverify} --keyring='%{SOURCE4}' --signature='%{SOURCE3}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE4}' --signature='%{SOURCE3}' --data='%{SOURCE0}'
 %endif
 
 
 %if %{without snapshot_build}
-%{gpgverify} --keyring='%{SOURCE4}' --signature='%{SOURCE2}' --data='%{SOURCE1}'
+%{openpgpverify} --keyring='%{SOURCE4}' --signature='%{SOURCE2}' --data='%{SOURCE1}'
 %endif
 
 %setup -T -q -b 1 -n %{clang_tools_srcdir}
@@ -731,6 +731,9 @@ LD_LIBRARY_PATH=%{buildroot}/%{install_libdir} %{__ninja} check-all -C %{__cmake
 
 %endif
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 18.1.8-12
+- Verify upstream source signatures with openpgpverify
+
 * Thu Sep 10 2026 Zbigniew Jędrzejewski-Szmek <zbyszek@in.waw.pl> - 18.1.8-11
 - Rebuilt for libxml-2.5.4
 
