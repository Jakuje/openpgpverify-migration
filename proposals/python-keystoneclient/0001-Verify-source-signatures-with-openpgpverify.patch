From b5936fbf86e6880a0a769bcfe51e3c3ae9d58b9d Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 13:17:32 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 python-keystoneclient.spec | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/python-keystoneclient.spec b/python-keystoneclient.spec
index 89bcf2a..9d57b7b 100644
--- a/python-keystoneclient.spec
+++ b/python-keystoneclient.spec
@@ -26,11 +26,9 @@ Source102:        https://releases.openstack.org/_static/%{sources_gpg_sign}.txt
 BuildArch:  noarch
 
 # Required for tarball sources verification
-%if 0%{?sources_gpg} == 1
-BuildRequires:  /usr/bin/gpgv2
-%endif
 
 BuildRequires: /usr/bin/openssl
+BuildRequires:  openpgpverify
 
 
 %description
@@ -82,7 +80,7 @@ Summary: Documentation for OpenStack Keystone API client
 
 %prep
 %if 0%{?sources_gpg} == 1
-%{gpgverify}  --keyring=%{SOURCE102} --signature=%{SOURCE101} --data=%{SOURCE0}
+%{openpgpverify}  --keyring=%{SOURCE102} --signature=%{SOURCE101} --data=%{SOURCE0}
 %endif
 %autosetup -n python_%{sname}-%{version} -S git
 
-- 
2.56.0

