From 82fd67fefff7ac496b4e6628718da20f38b7a0b6 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:09:02 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 redwax-tool.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/redwax-tool.spec b/redwax-tool.spec
index 873658f..1873f42 100644
--- a/redwax-tool.spec
+++ b/redwax-tool.spec
@@ -13,7 +13,7 @@ Source3:       redwax-test-certificates.pem
 Patch0:        0001-Support-OpenSSL4-by-using-opaque-function-accessors.patch
 Patch1:        0002-Fix-header-workarounds-for-p11kit-compilation.patch
 Url:           https://redwax.eu/rs/
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: gcc
 BuildRequires: autoconf
 BuildRequires: automake
@@ -33,7 +33,7 @@ be read, searched for, and converted into other formats as needed by
 common services.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
-- 
2.56.0

