From a8832b1adcaf5a23235f3aab7b9828a803363bd8 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 30 Oct 2026 13:47:05 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 debugedit.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/debugedit.spec b/debugedit.spec
index 42544f2..4118ef9 100644
--- a/debugedit.spec
+++ b/debugedit.spec
@@ -1,6 +1,6 @@
 Name: debugedit
 Version: 5.4
-Release: 1%{?dist}
+Release: 2%{?dist}
 Summary: Tools and scripts for creating debuginfo and source file distributions, collect build-ids and rewrite source paths in DWARF data for debugging, tracing and profiling.
 License: GPL-3.0-or-later AND GPL-2.0-or-later AND LGPL-2.0-or-later
 URL: https://sourceware.org/debugedit/
@@ -12,7 +12,7 @@ BuildRequires: make gcc gcc-c++
 BuildRequires: pkgconfig(libelf)
 BuildRequires: pkgconfig(libdw)
 BuildRequires: help2man
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 
 # For configure checking -j support
 BuildRequires: dwz
@@ -60,7 +60,7 @@ binutils.  It depends on the elfutils libelf and libdw libraries to
 read and write ELF files, DWARF data and build-ids.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
@@ -92,6 +92,9 @@ make check %{?_smp_mflags}
 %{_mandir}/man1/find-debuginfo.1*
 
 %changelog
+* Fri Oct 30 2026 Jakub Jelen <jjelen@redhat.com> - 5.4-2
+- Verify upstream source signatures with openpgpverify
+
 * Thu Oct 29 2026 Mark Wielaard <mjw@fedoraproject.org> - 5.4-1
 - New upstream 5.4 release
 - Remove debugedit-5.3-elflint-test.patch
-- 
2.56.0

