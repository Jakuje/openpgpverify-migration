From 77c2b05b326d23e5916ff71b95ec090fa464a3fc Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 23 Oct 2026 10:26:40 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 dehydrated.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/dehydrated.spec b/dehydrated.spec
index 862c8af..efdaabe 100644
--- a/dehydrated.spec
+++ b/dehydrated.spec
@@ -17,7 +17,7 @@ Patch0: dehydrated-improve-trap-handling.patch
 Patch1: dehydrated-hook.sh-defaults.patch
 
 BuildArch: noarch
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: systemd-rpm-macros
 %{?systemd_requires}
 Requires: coreutils
@@ -50,7 +50,7 @@ Current features:
 - Certificate revocation
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %setup -q
 %patch -P0 -p1 -b .improve-trap-handling
 %patch -P1 -p1 -b .hook.sh-defaults
-- 
2.56.0

