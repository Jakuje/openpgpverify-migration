From ae4a828f958189d53ed36035c775300ccf938297 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 22 Oct 2026 13:10:17 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 tomcat.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tomcat.spec b/tomcat.spec
index bb27fab..79e3125 100644
--- a/tomcat.spec
+++ b/tomcat.spec
@@ -63,7 +63,7 @@ BuildArch:     noarch
 # See: https://docs.fedoraproject.org/en-US/packaging-guidelines/Java/#_architecture_support
 ExclusiveArch:  %{java_arches} noarch
 
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: ant-openjdk25
 BuildRequires: ecj
 BuildRequires: findutils
@@ -186,7 +186,7 @@ Provides:  %{name}-el-3.0-api = %{?epoch:%{epoch}:}%{version}-%{release}
 Apache Tomcat EL API Implementation Classes.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 
 %setup -q -n %{packdname}
 # remove pre-built binaries and windows files
-- 
2.55.0

