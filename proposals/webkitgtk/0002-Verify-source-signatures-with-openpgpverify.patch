From 1d4aded43642b44e2996ffce2d74c4c0b9e00dd4 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 30 Oct 2026 13:47:22 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 webkitgtk.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/webkitgtk.spec b/webkitgtk.spec
index e921b58..b5dd621 100644
--- a/webkitgtk.spec
+++ b/webkitgtk.spec
@@ -166,6 +166,7 @@ BuildRequires:  pkgconfig(wayland-egl)
 BuildRequires:  pkgconfig(wayland-protocols)
 BuildRequires:  pkgconfig(wayland-server)
 BuildRequires:  pkgconfig(xt)
+BuildRequires:  openpgpverify
 
 %description
 WebKitGTK is the port of the WebKit web rendering engine to the
@@ -307,7 +308,7 @@ The javascriptcoregtk4.1-devel package contains libraries, build data, and heade
 files for developing applications that use JavaScript engine from webkit2gtk-4.1.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1 -n webkitgtk-%{version}
 
 %build
-- 
2.56.0

