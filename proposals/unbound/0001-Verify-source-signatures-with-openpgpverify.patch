From 14e9a4f848fa46517caf6f0852e95fafb7bd298e Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 12 Oct 2026 14:13:02 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 unbound.spec | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/unbound.spec b/unbound.spec
index 29cb786..8ffd1fd 100644
--- a/unbound.spec
+++ b/unbound.spec
@@ -100,6 +100,9 @@ BuildRequires: flex
 BuildRequires: byacc
 BuildRequires: dns-root-data >= 2026260100
 BuildRequires: gzip
+%if 0%{?fedora} || 0%{?rhel} >= 11
+BuildRequires: openpgpverify
+%endif
 
 %if 0%{?fedora} || 0%{?rhel} >= 9
 BuildRequires: gnupg2
@@ -232,8 +235,12 @@ in initramfs.
 
 %prep
 %if 0%{?fedora} || 0%{?rhel} >= 9
+%if 0%{?fedora} || 0%{?rhel} >= 11
+%{openpgpverify} --keyring='%{SOURCE19}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%else
 %{gpgverify} --keyring='%{SOURCE19}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
+%endif
 %global pkgname %{name}-%{version}%{?extra_version}
 
 %if 0%{with_python2} && 0%{with_python3}
-- 
2.55.0

