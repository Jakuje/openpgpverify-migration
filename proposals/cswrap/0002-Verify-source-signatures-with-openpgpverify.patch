From cd9e1817050d44a9a972c4b8c84acbbb2aed6906 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:33 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 cswrap.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/cswrap.spec b/cswrap.spec
index 06857f8..54e73e2 100644
--- a/cswrap.spec
+++ b/cswrap.spec
@@ -5,7 +5,7 @@
 
 Name:       cswrap
 Version:    2.2.6
-Release:    2%{?dist}
+Release:    3%{?dist}
 Summary:    Generic compiler wrapper
 
 License:    GPL-3.0-or-later
@@ -20,7 +20,7 @@ Source2:    kdudka.pgp
 BuildRequires: asciidoc
 BuildRequires: cmake
 BuildRequires: gcc
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 
 # csmock copies the resulting cswrap binary into mock chroot, which may contain
 # an older (e.g. RHEL-7) version of glibc, and it would not dynamically link
@@ -54,7 +54,7 @@ fully automatically.
 %endif
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
@@ -96,6 +96,9 @@ done
 %endif
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 2.2.6-3
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 2.2.6-2
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
