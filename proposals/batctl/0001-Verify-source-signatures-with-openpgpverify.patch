From ac8d678e41926ce6c34db952c7bf1dc1a1a05aa1 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:34:53 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 batctl.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/batctl.spec b/batctl.spec
index e47052b..de3154e 100644
--- a/batctl.spec
+++ b/batctl.spec
@@ -17,7 +17,7 @@ Source100:      https://keys.openpgp.org/pks/lookup?op=get&options=mr&search=0x2
 Requires:       kmod(batman-adv.ko)
 %endif
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  make
 BuildRequires:  libnl3-devel
 
@@ -38,7 +38,7 @@ to layer 2 behavior or using the B.A.T.M.A.N. advanced protocol.
 
 %prep
 cat %{S:100} > %{_builddir}/%{name}.gpg
-%{gpgverify} --keyring="%{_builddir}/%{name}.gpg" --signature="%{SOURCE1}" --data="%{SOURCE0}"
+%{openpgpverify} --keyring="%{_builddir}/%{name}.gpg" --signature="%{SOURCE1}" --data="%{SOURCE0}"
 %setup -q
 
 
-- 
2.56.0

