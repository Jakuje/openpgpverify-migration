From 5bbc7b6052b93510eaba8404f224906c354c45aa Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:44 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 fcitx5-kkc.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/fcitx5-kkc.spec b/fcitx5-kkc.spec
index 4da5b5b..3ed3e0b 100644
--- a/fcitx5-kkc.spec
+++ b/fcitx5-kkc.spec
@@ -15,7 +15,7 @@ Source1:        https://download.fcitx-im.org/fcitx5/%{name}/%{name}-%{version}.
 #   mv 0x8E8B898CBF2412F9.new 0x8E8B898CBF2412F9
 Source2:        https://pgp.key-server.io/download/0x8E8B898CBF2412F9
 
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  cmake
 BuildRequires:  gcc-c++
 BuildRequires:  ninja-build
@@ -40,7 +40,7 @@ Requires:       libkkc-data
 This provides libkkc input method support for fcitx5. Released under GPL3+.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
-- 
2.56.0

