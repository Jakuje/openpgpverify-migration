From 43337de9aa7f76b694e1527a00f3f97c22c6b481 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 23 Oct 2026 10:26:39 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 pyxattr.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/pyxattr.spec b/pyxattr.spec
index 56a1d48..2d33749 100644
--- a/pyxattr.spec
+++ b/pyxattr.spec
@@ -1,7 +1,7 @@
 Name:           pyxattr
 Summary:        Extended attributes library wrapper for Python
 Version:        0.7.2
-Release:        22%{?dist}
+Release:        23%{?dist}
 License:        LGPL-2.1-or-later
 URL:            https://pyxattr.k1024.org/
 Source0:        %{URL}/downloads/%{name}-%{version}.tar.gz
@@ -14,6 +14,7 @@ BuildRequires:  python3-devel
 BuildRequires:  python3-setuptools
 BuildRequires:  gnupg2
 BuildRequires:  %{py3_dist pytest}
+BuildRequires:  openpgpverify
 
 %global _description %{expand:
 Python extension module wrapper for libattr. It allows to query, list,
@@ -28,7 +29,7 @@ Summary: %{summary}
 %description -n python3-%{name} %_description
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
@@ -53,6 +54,9 @@ python3 -m pytest tests %{?copr_projectname:-k 'not (binary_payload or create_on
 %doc NEWS README.md
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 0.7.2-23
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 22 2026 Python Maint <python-maint@redhat.com> - 0.7.2-22
 - Rebuilt for Python 3.15.0b4 ABI change
 
-- 
2.56.0

