From c84372e008f7b15c41f76ccd1042dd5dbd268fe1 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:46 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 kronometer.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/kronometer.spec b/kronometer.spec
index 9f01a49..7e6091b 100644
--- a/kronometer.spec
+++ b/kronometer.spec
@@ -3,7 +3,7 @@
 Name:    kronometer
 Summary: A stopwatch application by KDE
 Version: 2.3.0
-Release: 11%{?dist}
+Release: 12%{?dist}
 
 # code is GPLv2, appdata file is CC0
 License: GPL-2.0-or-later AND CC0-1.0
@@ -22,7 +22,7 @@ Source2: gpgkey-F07D85CAA18ACF46A346FD017C7FC6EA8633B4EA.gpg
 BuildRequires: desktop-file-utils
 BuildRequires: extra-cmake-modules
 BuildRequires: gcc-c++
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: libappstream-glib
 
 BuildRequires: cmake(Qt5Core) >= 5.15.0
@@ -50,7 +50,7 @@ Kronometer is a stopwatch application.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 
@@ -89,6 +89,9 @@ export QT_QPA_PLATFORM=offscreen
 
 
 %changelog
+* Sat Oct 31 2026 Jakub Jelen <jjelen@redhat.com> - 2.3.0-12
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 2.3.0-11
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

