From bb3c9b5a3fca6c1740576fb437e296236ede0868 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:09:01 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 msmtp.spec | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/msmtp.spec b/msmtp.spec
index 8a4903a..31b8520 100644
--- a/msmtp.spec
+++ b/msmtp.spec
@@ -17,8 +17,8 @@ BuildRequires:	gnutls-devel
 BuildRequires:	libidn2-devel
 BuildRequires:	libsecret-devel
 BuildRequires:	make
-# for %%gpgverify
-BuildRequires:	gnupg2
+# for %%openpgpverify
+BuildRequires:	openpgpverify
 
 Requires(post):		%{_sbindir}/alternatives /sbin/install-info
 Requires(postun):	%{_sbindir}/alternatives /sbin/install-info
@@ -43,7 +43,7 @@ Features include:
   * IPv6 support.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
-- 
2.56.0

