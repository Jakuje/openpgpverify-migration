From 081cf9775915172116151e756e2e57abb79e5b11 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 15:23:33 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 screenkey.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/screenkey.spec b/screenkey.spec
index a506bd6..1e387c9 100644
--- a/screenkey.spec
+++ b/screenkey.spec
@@ -1,7 +1,7 @@
 %global py_name Screenkey
 Name:		screenkey
 Version:	1.5
-Release:	19%{?dist}
+Release:	20%{?dist}
 Summary:	A screencast tool to display your keys
 License:	GPL-3.0-or-later
 URL:		https://www.thregr.org/~wavexx/software/%{name}
@@ -16,6 +16,7 @@ BuildRequires:	python3-babel
 BuildRequires:	desktop-file-utils
 
 BuildRequires: gnupg2
+BuildRequires:	openpgpverify
 
 Requires:   slop
 
@@ -35,7 +36,7 @@ A screencast tool to display your keys, featuring:
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %generate_buildrequires
@@ -59,6 +60,9 @@ desktop-file-validate %{buildroot}/%{_datadir}/applications/%{name}.desktop
 %{_datadir}/metainfo/org.thregr.%{name}.metainfo.xml
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 1.5-20
+- Verify upstream source signatures with openpgpverify
+
 * Fri Jul 17 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.5-19
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

