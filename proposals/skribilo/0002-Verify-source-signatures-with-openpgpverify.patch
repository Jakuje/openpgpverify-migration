From 99dbad82aac494a165caec29bebe04665709aefe Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 13:58:44 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 skribilo.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/skribilo.spec b/skribilo.spec
index fc8da20..6f28603 100644
--- a/skribilo.spec
+++ b/skribilo.spec
@@ -5,7 +5,7 @@
 
 Name:         skribilo
 Version:      0.11.0
-Release:      3%{?dist}
+Release:      4%{?dist}
 Summary:      A free document production tool
 
 License:      GPL-3.0-or-later
@@ -28,7 +28,7 @@ BuildRequires:  texlive-collection-context
 # needed for iconv
 BuildRequires:  glibc-common
 # needed to check signing
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 Requires:       guile30
 Requires:       lomt-junction-fonts
 Requires:       linux-libertine-biolinum-fonts
@@ -66,7 +66,7 @@ Configuration files for writing Skribilo documents using
 Emacs.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 iconv -f ISO-8859-1 -t UTF-8 ChangeLog.Skribe > ChangeLog.Skribe.tmp
@@ -195,6 +195,9 @@ make check
 %{_datadir}/emacs/site-lisp/skribe.el
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 0.11.0-4
+- Verify upstream source signatures with openpgpverify
+
 * Fri Jul 17 2026 Fedora Release Engineering <releng@fedoraproject.org> - 0.11.0-3
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

