From 13eb96eafe915dfc8252b1e16d5a6211b01cb594 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:35:03 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 bind9-next.spec | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/bind9-next.spec b/bind9-next.spec
index d283ef0..303b248 100644
--- a/bind9-next.spec
+++ b/bind9-next.spec
@@ -125,10 +125,8 @@ BuildRequires:  pkgconfig(lmdb)
 %if %{with JEMALLOC}
 BuildRequires:  pkgconfig(jemalloc)
 %endif
-%if ! 0%{?rhel}
-BuildRequires:  gpgverify
-%endif
 BuildRequires:  pkgconfig(libuv)
+BuildRequires:  openpgpverify
 %if %{with OPENSSL_ENGINE}
 BuildRequires:  openssl-devel-engine
 %endif
@@ -304,7 +302,7 @@ in HTML and PDF format.
 %prep
 %if ! 0%{?rhel} || 0%{?rhel} > 10
 # RHEL does not (again?) support this verification
-%{gpgverify} --keyring='%{SOURCE4}' --signature='%{SOURCE2}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE4}' --signature='%{SOURCE2}' --data='%{SOURCE0}'
 %endif
 %autosetup -n %{upname}-%{version} -p1
 
-- 
2.56.0

