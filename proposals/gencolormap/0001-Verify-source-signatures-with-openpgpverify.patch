From ec60b855836fe5f645d6dc149585999a6b637bb6 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:45 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 gencolormap.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/gencolormap.spec b/gencolormap.spec
index fc56469..7a08858 100644
--- a/gencolormap.spec
+++ b/gencolormap.spec
@@ -14,7 +14,7 @@ Requires:       hicolor-icon-theme
 BuildRequires:  cmake
 BuildRequires:  desktop-file-utils
 BuildRequires:  gcc-c++
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  libappstream-glib
 
 BuildRequires:  libGL-devel
@@ -25,7 +25,7 @@ gencolormap provides tools generate color maps for visualization. A variety of
 methods for sequential, diverging, and qualitative maps is available.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
-- 
2.56.0

