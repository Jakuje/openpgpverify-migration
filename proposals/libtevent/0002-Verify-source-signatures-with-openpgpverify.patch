From 0fa64a561d8e5e262f04ebb754883fe4eea566ac Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 13:58:44 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 libtevent.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libtevent.spec b/libtevent.spec
index 7e8215f..0ea640e 100644
--- a/libtevent.spec
+++ b/libtevent.spec
@@ -16,7 +16,7 @@ Source2:        https://download.samba.org/pub/samba/samba-pubkey.asc#/tevent.ke
 BuildRequires: docbook-style-xsl
 BuildRequires: doxygen
 BuildRequires: gcc
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: libcmocka-devel >= 1.1.3
 BuildRequires: libtalloc-devel >= %{talloc_version}
 BuildRequires: libxslt
@@ -54,7 +54,7 @@ Requires: libtevent%{?_isa} = %{version}-%{release}
 Python 3 bindings for libtevent
 
 %prep
-zcat %{SOURCE0} | gpgv2 --quiet --keyring %{SOURCE2} %{SOURCE1} -
+zcat %{SOURCE0} | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %autosetup -n tevent-%{version} -p1
 
 %build
-- 
2.56.0

