From 30b6e4e0ebdd4770f8efdfe62fd5801cbc16b48c Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 3 Nov 2026 20:54:09 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 poppler.spec | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/poppler.spec b/poppler.spec
index 02a8b62..4283967 100644
--- a/poppler.spec
+++ b/poppler.spec
@@ -73,8 +73,9 @@ BuildRequires: cmake(Qt6Widgets)
 BuildRequires: cmake(Qt6Xml)
 %endif
 BuildRequires: boost-devel
-# for %%gpgverify
+# for %%openpgpverify
 BuildRequires: gnupg2
+BuildRequires: openpgpverify
 
 Requires: poppler-data
 
@@ -176,7 +177,7 @@ Command line tools for manipulating PDF files and converting them to
 other formats.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1 -b 3
 
 chmod -x poppler/CairoFontEngine.cc
-- 
2.56.0

