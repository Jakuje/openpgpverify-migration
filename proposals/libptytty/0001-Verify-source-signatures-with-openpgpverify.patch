From 3952549eabf65f96a65b0320a80a94cc4eed5a02 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:34:54 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 libptytty.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/libptytty.spec b/libptytty.spec
index e16a8f7..b4bc6cb 100644
--- a/libptytty.spec
+++ b/libptytty.spec
@@ -1,6 +1,6 @@
 Name:    libptytty
 Version: 2.0
-Release: 15%{?dist}
+Release: 16%{?dist}
 Summary: OS independent and secure pty/tty and utmp/wtmp/lastlog handling
 License: GPL-2.0-or-later
 URL:     http://software.schmorp.de/pkg/libptytty.html
@@ -19,7 +19,7 @@ Patch0: libptytty-cmake-c99.patch
 
 BuildRequires: cmake
 BuildRequires: gcc-g++
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: git
 BuildRequires: ninja-build
 BuildRequires: signify
@@ -41,7 +41,7 @@ Requires: %{name}%{?_isa} = %{version}-%{release}
 %desc
 
 %prep
-%{gpgverify} --keyring='%{SOURCE4}' --signature='%{SOURCE3}' --data='%{SOURCE2}'
+%{openpgpverify} --keyring='%{SOURCE4}' --signature='%{SOURCE3}' --data='%{SOURCE2}'
 signify -V -p '%{SOURCE2}' -m '%{SOURCE0}'
 %autosetup -S git
 
@@ -66,6 +66,9 @@ signify -V -p '%{SOURCE2}' -m '%{SOURCE0}'
 %doc README
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 2.0-16
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 2.0-15
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

