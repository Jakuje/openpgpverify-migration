From ab774f07474b5a2a1095df11440f52e806da19ca Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 19:21:00 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 libuv.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/libuv.spec b/libuv.spec
index cf2e827..9382523 100644
--- a/libuv.spec
+++ b/libuv.spec
@@ -34,6 +34,7 @@ BuildRequires:  gnupg2
 # Documentation
 BuildRequires:  make
 BuildRequires:  python3-sphinx
+BuildRequires:  openpgpverify
 
 
 %description
@@ -59,7 +60,7 @@ Static library (.a) version of libuv.
 
 
 %prep
-gpgv2 --keyring %{SOURCE2} %{SOURCE1} %{SOURCE0}
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -n %{name}-v%{version} -p1
 
 %build
-- 
2.56.0

