From acbb81c0e564da557d8af4523ef56af2dcbd87d1 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:34 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 libuv.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libuv.spec b/libuv.spec
index cf2e827..3fd2b1a 100644
--- a/libuv.spec
+++ b/libuv.spec
@@ -30,7 +30,7 @@ Source3:        libuv.abignore
 
 BuildRequires:  cmake
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 # Documentation
 BuildRequires:  make
 BuildRequires:  python3-sphinx
@@ -59,7 +59,7 @@ Static library (.a) version of libuv.
 
 
 %prep
-gpgv2 --keyring %{SOURCE2} %{SOURCE1} %{SOURCE0}
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -n %{name}-v%{version} -p1
 
 %build
-- 
2.56.0

