From 0bc76c212df4bed48b17fdfe0d2547d2b86ed9aa Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 19:20:59 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 fcitx5-qt.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/fcitx5-qt.spec b/fcitx5-qt.spec
index 8621926..d183ac3 100644
--- a/fcitx5-qt.spec
+++ b/fcitx5-qt.spec
@@ -34,6 +34,7 @@ BuildRequires:  gettext
 BuildRequires:  qt5-qtbase-private-devel
 BuildRequires:  pkgconfig(Qt6)
 BuildRequires:  qt6-qtbase-private-devel
+BuildRequires:  openpgpverify
 Requires:       ((fcitx5-qt6%{?_isa} = %{version}-%{release}) if qt6-qtbase)
 
 # pull in im-modules for existing qt version
@@ -108,7 +109,7 @@ Requires:       cmake-filesystem%{?_isa}
 Development files for %{name}
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
-- 
2.56.0

