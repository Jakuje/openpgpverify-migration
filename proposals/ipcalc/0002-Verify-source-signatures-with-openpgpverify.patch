From 107f6a2820464e612236f0657a819b1780455908 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:34 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 ipcalc.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ipcalc.spec b/ipcalc.spec
index 13cfb94..1be8914 100644
--- a/ipcalc.spec
+++ b/ipcalc.spec
@@ -11,7 +11,7 @@ Source1: https://gitlab.com/api/v4/projects/ipcalc%%2Fipcalc/packages/generic/ip
 Source2: gpgkey-1F42418905D8206AA754CCDC29EE58B996865171.gpg
 
 BuildRequires: gcc, libmaxminddb-devel, meson, rubygem-ronn-ng
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 # for the test suite (JsonEscapeHostname)
 BuildRequires: jq
 Recommends:    libmaxminddb, geolite2-city, geolite2-country, geolite2-asn
@@ -30,7 +30,7 @@ parsing in scripts, generate random private addresses, resolve an IP address,
 or check the validity of an address.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
-- 
2.56.0

