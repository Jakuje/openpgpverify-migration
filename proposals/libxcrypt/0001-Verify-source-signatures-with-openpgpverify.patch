From 2fef51137f8e8ecc059bc00edd121be5fd5e0df5 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 23 Oct 2026 10:26:38 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 libxcrypt.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/libxcrypt.spec b/libxcrypt.spec
index 83454b7..a7bc0aa 100644
--- a/libxcrypt.spec
+++ b/libxcrypt.spec
@@ -176,7 +176,7 @@ fi                                          \
 
 Name:           libxcrypt
 Version:        4.5.2
-Release:        4%{?dist}
+Release:        5%{?dist}
 Summary:        Extended crypt library for descrypt, md5crypt, bcrypt, and others
 
 # For explicit license breakdown, see the
@@ -223,6 +223,7 @@ BuildRequires:  perl(Symbol)
 BuildRequires:  perl(utf8)
 BuildRequires:  perl(warnings)
 BuildRequires:  perl-interpreter
+BuildRequires:  openpgpverify
 
 # We do not need to keep this forever.
 %if 0%{?trans_pkg}
@@ -339,7 +340,7 @@ discouraged.
 %prep
 %if %{without bootstrap}
 # Omitted during bootstrap.
-%{gpgverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
+%{openpgpverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
 pushd %{_sourcedir}
 sha256sum -c %{SOURCE3}
 popd
@@ -552,6 +553,9 @@ done
 
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 4.5.2-5
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 4.5.2-4
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
