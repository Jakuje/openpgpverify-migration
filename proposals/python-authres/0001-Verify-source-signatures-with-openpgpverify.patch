From 6ec604a73cec4d0831a574a2e50197b54d071f5e Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 13:17:27 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 python-authres.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/python-authres.spec b/python-authres.spec
index a0bcdc0..d00e2bb 100644
--- a/python-authres.spec
+++ b/python-authres.spec
@@ -2,7 +2,7 @@
 
 Name:           python-%{srcname}
 Version:        1.2.0
-Release:        30%{?dist}
+Release:        31%{?dist}
 Summary:        Authentication Results Header Module
 # Automatically converted from old format: ASL 2.0 - review is highly recommended.
 License:        Apache-2.0
@@ -12,6 +12,7 @@ Source1:	https://launchpad.net/authentication-results-python/1.2/%{version}/+dow
 Source2:	https://db.debian.org/fetchkey.cgi?fingerprint=E7729BFFBE85400FEEEE23B178D7DEFB9AD59AF1#/GPG-KEY-kitterman
 BuildArch:      noarch
 BuildRequires:	gnupg2
+BuildRequires:	openpgpverify
 
 %global _description\
 RFC 8601 Authentication-Results Headers generation and parsing for\
@@ -28,7 +29,7 @@ BuildRequires: python3-devel python3-setuptools
 %description -n python3-%{srcname} %_description
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -n %{srcname}-%{version}
 
 
@@ -52,6 +53,9 @@ BuildRequires: python3-devel python3-setuptools
 
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 1.2.0-31
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.2.0-30
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

