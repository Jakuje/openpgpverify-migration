From 65a3ed4659b21d3c0341185466952ab0d4da7ba5 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:34 +0100
Subject: [PATCH 1/2] Update the upstream signing key

Refresh tstellar-gpg-key.asc from keyservers: same certificate(s), with
self-signatures our copy was missing.
The commands are in the comment above its Source line.

The current key is needed to verify the release signature with
openpgpverify (sqv), which checks that the key was valid when the
release was signed.

Assisted-by: Claude Opus 5.5
---
 llvm14.spec          |   2 ++
 tstellar-gpg-key.asc | Bin 2222 -> 10348 bytes
 2 files changed, 2 insertions(+)

diff --git a/llvm14.spec b/llvm14.spec
index bc782fa..177e320 100644
--- a/llvm14.spec
+++ b/llvm14.spec
@@ -78,6 +78,8 @@ License:	NCSA
 URL:		http://llvm.org
 Source0:	https://github.com/llvm/llvm-project/releases/download/llvmorg-%{maj_ver}.%{min_ver}.%{patch_ver}%{?rc_ver:-rc%{rc_ver}}/%{llvm_srcdir}.tar.xz
 Source1:	https://github.com/llvm/llvm-project/releases/download/llvmorg-%{maj_ver}.%{min_ver}.%{patch_ver}%{?rc_ver:-rc%{rc_ver}}/%{llvm_srcdir}.tar.xz.sig
+# Refreshed from keyservers (same keys, newer signatures):
+#   sq --home=none network keyserver search 474E22316ABF4785A88C6E8EA2C794A986419D8A --output tstellar-gpg-key.asc --overwrite
 Source2:	tstellar-gpg-key.asc
 
 %if %{without compat_build}
