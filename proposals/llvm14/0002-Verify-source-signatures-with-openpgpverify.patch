From c4ea330e50078170249aeebfe49cc92243e8e2db Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 6 Nov 2026 09:01:14 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 llvm14.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/llvm14.spec b/llvm14.spec
index 177e320..92f97ca 100644
--- a/llvm14.spec
+++ b/llvm14.spec
@@ -71,7 +71,7 @@
 
 Name:		%{pkg_name}
 Version:	%{maj_ver}.%{min_ver}.%{patch_ver}%{?rc_ver:~rc%{rc_ver}}
-Release:	15%{?dist}
+Release:	16%{?dist}
 Summary:	The Low Level Virtual Machine
 
 License:	NCSA
@@ -123,7 +123,7 @@ BuildRequires:	python3-devel
 BuildRequires:	python3-setuptools
 
 # For origin certification
-BuildRequires:	gnupg2
+BuildRequires:	openpgpverify
 
 
 Requires:	%{name}-libs%{?_isa} = %{version}-%{release}
@@ -208,7 +208,7 @@ LLVM's modified googletest sources.
 %endif
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -n %{llvm_srcdir} -p2
 
 %py3_shebang_fix \
@@ -566,6 +566,9 @@ fi
 %endif
 
 %changelog
+* Fri Nov 06 2026 Jakub Jelen <jjelen@redhat.com> - 14.0.5-16
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 14.0.5-15
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
