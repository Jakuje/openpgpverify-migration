From 5f430de17cf01d8c170ac722048fc54a849a19dd Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 13:58:43 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 btrfs-progs.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/btrfs-progs.spec b/btrfs-progs.spec
index 85ca865..74568eb 100644
--- a/btrfs-progs.spec
+++ b/btrfs-progs.spec
@@ -3,7 +3,7 @@
 
 Name:           btrfs-progs
 Version:        7.1
-Release:        3%{?dist}
+Release:        4%{?dist}
 Summary:        Userspace programs for btrfs
 
 License:        GPL-2.0-only
@@ -16,7 +16,7 @@ Source2:        https://git.kernel.org/pub/scm/docs/kernel/pgpkeys.git/plain/key
 ## Disable RAID56 modes (RHEL-only)
 Source1001:     1001-balance-mkfs-Disable-raid56-modes.patch
 
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  gcc, autoconf, automake, make
 BuildRequires:  git-core
 BuildRequires:  e2fsprogs-devel
@@ -92,7 +92,7 @@ btrfs filesystem-specific programs in Python.
 
 
 %prep
-xzcat '%{SOURCE0}' | %{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
+xzcat '%{SOURCE0}' | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %autosetup -n %{name}-v%{version_no_tilde} -S git_am
 
 %if 0%{?rhel}
@@ -169,6 +169,9 @@ popd >/dev/null
 
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 7.1-4
+- Verify upstream source signatures with openpgpverify
+
 * Fri Oct 09 2026 Neal Gompa <ngompa@fedoraproject.org> - 7.1-3
 - Switch from libkcapi to openssl for crypto
 
-- 
2.56.0

