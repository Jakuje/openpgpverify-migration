From 3f690e3ef0d25114a5789b4ddd73c8c460a97d66 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 9 Oct 2026 15:52:19 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 python-ezgb.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/python-ezgb.spec b/python-ezgb.spec
index ba7dc5a..8f62f59 100644
--- a/python-ezgb.spec
+++ b/python-ezgb.spec
@@ -18,6 +18,7 @@ BuildArch:      noarch
 BuildRequires:  python3-devel
 BuildRequires:  python3-pytest
 BuildRequires:  pyproject-rpm-macros
+BuildRequires:  openpgpverify
 
 %global _description %{expand:
 A standalone Python library for working with git-bug repositories. It lets you
@@ -35,7 +36,7 @@ Provides:       python%{python3_pkgversion}-%{srcname} = %{version}-%{release}
 
 
 %prep
-xz -dc '%{SOURCE0}' | %{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
+xz -dc '%{SOURCE0}' | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %autosetup -p1 -n %{srcname}-%{version}
 
 # Disable pyright until it's packaged.
-- 
2.55.0

