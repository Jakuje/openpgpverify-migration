From 3c982ce23e8e942de33f32e4d3226a1d91ff163d Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 13:17:22 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 python-ezgb.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/python-ezgb.spec b/python-ezgb.spec
index 57519b8..5218ce9 100644
--- a/python-ezgb.spec
+++ b/python-ezgb.spec
@@ -24,6 +24,7 @@ BuildRequires:  pyproject-rpm-macros
 # Therefore, we maintain the following list of test dependencies manually.
 BuildRequires:  python3dist(pytest)
 BuildRequires:  python3dist(typing-extensions)
+BuildRequires:  openpgpverify
 
 %global _description %{expand:
 A standalone Python library for working with git-bug repositories. It lets you
@@ -41,7 +42,7 @@ Provides:       python%{python3_pkgversion}-%{srcname} = %{version}-%{release}
 
 
 %prep
-xz -dc '%{SOURCE0}' | %{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
+xz -dc '%{SOURCE0}' | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %autosetup -p1 -n %{srcname}-%{version}
 
 
-- 
2.56.0

