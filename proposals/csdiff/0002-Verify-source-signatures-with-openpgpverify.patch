From f4196d44f4724dc8375d368cc6e3df3befbbb9d0 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:33 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 csdiff.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/csdiff.spec b/csdiff.spec
index 8c431e2..c07f364 100644
--- a/csdiff.spec
+++ b/csdiff.spec
@@ -20,7 +20,7 @@
 
 Name:       csdiff
 Version:    3.5.7
-Release:    4%{?dist}
+Release:    5%{?dist}
 Summary:    Non-interactive tools for processing code scan results in plain-text
 
 License:    GPL-3.0-or-later
@@ -54,7 +54,7 @@ BuildRequires: cmake3
 BuildRequires: cmake
 %endif
 BuildRequires: gcc-c++
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: help2man
 BuildRequires: make
 
@@ -115,7 +115,7 @@ code scan defect lists to find out added or fixed defects.
 %endif
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
@@ -197,6 +197,9 @@ make version.cc
 %endif
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 3.5.7-5
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 22 2026 Python Maint <python-maint@redhat.com> - 3.5.7-4
 - Rebuilt for Python 3.15.0b4 ABI change
 
-- 
2.56.0

