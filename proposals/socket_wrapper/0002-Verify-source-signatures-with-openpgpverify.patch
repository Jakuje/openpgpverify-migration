From 6bb2bce69d168bcda3c8ab8e09e1ae97c0640c2d Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 3 Nov 2026 11:00:27 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 socket_wrapper.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/socket_wrapper.spec b/socket_wrapper.spec
index 3ed992f..a061ea0 100644
--- a/socket_wrapper.spec
+++ b/socket_wrapper.spec
@@ -20,6 +20,7 @@ BuildRequires:  cmake
 BuildRequires:  gcc
 BuildRequires:  gnupg2
 BuildRequires:  libcmocka-devel >= 1.1.0
+BuildRequires:  openpgpverify
 
 Recommends:     cmake
 Recommends:     pkgconfig
@@ -54,7 +55,7 @@ Development headers for applications with the need to call
 socket_wrapper_enabled().
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
-- 
2.56.0

