From 3b569d9045fc958d65e4b075273a48e5b44bdd24 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 08:28:41 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 python-osc-placement.spec | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/python-osc-placement.spec b/python-osc-placement.spec
index 835ff92..532aac7 100644
--- a/python-osc-placement.spec
+++ b/python-osc-placement.spec
@@ -22,11 +22,9 @@ Source2:          https://releases.openstack.org/_static/%{sources_gpg_sign}.txt
 
 BuildArch:        noarch
 
-%if 0%{?sources_gpg} == 1
-BuildRequires:    /usr/bin/gpgv2
-%endif
 BuildRequires:    git-core
 BuildRequires:    python%{python3_pkgversion}-devel
+BuildRequires:    openpgpverify
 
 
 %description %{_description}
@@ -51,7 +49,7 @@ Requires:         python%{python3_pkgversion}-osc-placement = %{version}-%{relea
 
 %prep
 %if 0%{?sources_gpg} == 1
-%{gpgverify}  --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
+%{openpgpverify}  --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
 %endif
 %autosetup -n osc_placement-%{version} -S git
 
-- 
2.56.0

