From 74be701545f6dc1b2341f81c55676070280a4bf0 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 13:17:30 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 davfs2.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/davfs2.spec b/davfs2.spec
index acbdd1a..435d633 100644
--- a/davfs2.spec
+++ b/davfs2.spec
@@ -1,6 +1,6 @@
 Name:           davfs2
 Version:        1.7.3
-Release:        2%{?dist}
+Release:        3%{?dist}
 Summary:        A filesystem driver for WebDAV
 # Automatically converted from old format: GPLv3+ - review is highly recommended.
 License:        GPL-3.0-or-later
@@ -16,7 +16,7 @@ Source2:        davfs2-memberlist-gpgkeys.asc
 Conflicts:      filesystem < 3
 BuildRequires:  gcc
 BuildRequires:  gettext
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  neon-devel
 BuildRequires:  make
 
@@ -30,7 +30,7 @@ davfs2 is a Linux file system driver that allows you to mount a WebDAV server
 as a disk drive.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %setup -q
 
 # Create a sysusers.d config file
@@ -95,6 +95,9 @@ install -m0644 -D davfs2.sysusers.conf %{buildroot}%{_sysusersdir}/davfs2.conf
 %{_sysusersdir}/davfs2.conf
 
 %changelog
+* Fri Oct 23 2026 Jakub Jelen <jjelen@redhat.com> - 1.7.3-3
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.7.3-2
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

