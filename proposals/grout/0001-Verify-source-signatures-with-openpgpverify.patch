From 7c73680e94c4dd9b33f63a2a7bfed57cf22b625f Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:57 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 grout.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/grout.spec b/grout.spec
index 20d1992..9e4ded0 100644
--- a/grout.spec
+++ b/grout.spec
@@ -39,7 +39,7 @@ Source1: https://fast.dpdk.org/rel/dpdk-%{dpdk_version}.tar.xz
 Source2: %{forgeurl}/releases/download/v%{version}/grout-%{version}.tar.gz.asc
 Source3: %{forgeurl}/raw/refs/heads/main/devtools/release-keys.asc
 
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 %if %{defined toolset}
 BuildRequires: %toolset
 BuildRequires: scl-utils
@@ -120,7 +120,7 @@ This package contains the FRR zebra dataplane plugin for grout.
 %endif
 
 %prep
-%gpgverify -k3 -s2 -d0
+%openpgpverify -k3 -s2 -d0
 %forgesetup
 %autopatch -p1
 mkdir -p subprojects/packagecache/
-- 
2.56.0

