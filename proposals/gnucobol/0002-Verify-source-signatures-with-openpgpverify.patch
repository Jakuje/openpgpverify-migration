From 6c6a340180b309be304abf11e5676e364a8b9d11 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 6 Nov 2026 12:15:42 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 gnucobol.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/gnucobol.spec b/gnucobol.spec
index 68e2193..ef5177c 100644
--- a/gnucobol.spec
+++ b/gnucobol.spec
@@ -3,7 +3,7 @@
 
 Name:           gnucobol
 Version:        3.2
-Release:        12%{?dist}
+Release:        13%{?dist}
 Summary:        COBOL compiler
 
 License:        GPL-3.0-or-later AND LGPL-3.0-or-later AND GFDL-1.3-only AND FSFAP AND GPL-2.0-or-later AND LGPL-3.0-or-later
@@ -25,7 +25,7 @@ BuildRequires:  gmp-devel
 BuildRequires:  readline-devel
 BuildRequires:  libdb-devel
 BuildRequires:  gettext
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  perl-interpreter
 BuildRequires:  libxml2-devel
 BuildRequires:  json-c-devel
@@ -61,7 +61,7 @@ License:        LGPL-3.0-or-later
 ESQL for GnuCOBOL
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p0
 cp %{SOURCE3} tests/cobol85/
 
@@ -127,6 +127,9 @@ make test CFLAGS="%optflags -O"
 %{_libdir}/libocsql.so*
 
 %changelog
+* Fri Nov 06 2026 Jakub Jelen <jjelen@redhat.com> - 3.2-13
+- Verify upstream source signatures with openpgpverify
+
 * Thu Sep 10 2026 Zbigniew Jędrzejewski-Szmek <zbyszek@in.waw.pl> - 3.2-12
 - Rebuilt for libxml-2.5.4
 
-- 
2.56.0

