From bccab7ac071e053eff9a962a36dfc1e1b3411e8b Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 22 Oct 2026 13:10:13 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Refresh gpgkey-aide.gpg from keyservers/WKD: same certificate(s), with self-signatures our copy was missing.

Assisted-by: Claude Opus 5.5
---
 aide.spec       |   3 ++-
 gpgkey-aide.gpg | Bin 5160 -> 59219 bytes
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/aide.spec b/aide.spec
index 1d57c3e..efe5311 100644
--- a/aide.spec
+++ b/aide.spec
@@ -36,6 +36,7 @@ BuildRequires:  systemd-rpm-macros
 BuildRequires:  gnupg2
 # For being able to run 'make check'
 BuildRequires:  check-devel
+BuildRequires:  openpgpverify
 
 
 Requires:       logrotate
@@ -45,7 +46,7 @@ AIDE (Advanced Intrusion Detection Environment) is a file integrity
 checker and intrusion detection program.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 cp -a %{SOURCE4} .
 
diff --git a/gpgkey-aide.gpg b/gpgkey-aide.gpg
index efb011917bd132d1633f2ceeb97ee79c1acfa0f4..faadf66812f3935e4114aa854148f18c6a1065b9 100644
