 Source5:        aide.logrotate
@@ -24,6 +22,8 @@ Provides:	bundled(nettle) = %{nettle_version}
 Source200:	nettle-%{nettle_version}.tar.gz
 # Taken from the main nettle package
 Source201:	nettle-%{nettle_version}.tar.gz.sig
