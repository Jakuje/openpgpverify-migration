index 1365a0e..445e0c1 100644
--- a/.gitignore
+++ b/.gitignore
@@ -25,4 +25,3 @@ aide-0.14.tar.gz.asc
 /aide-0.19.4.tar.gz.asc
 /nettle-4.0.tar.gz
 /nettle-4.0.tar.gz.sig
-/nettle-release-keyring.gpg
