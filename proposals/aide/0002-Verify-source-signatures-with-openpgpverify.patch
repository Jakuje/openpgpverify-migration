From 723a871514185c9eb6f3eb4f77baa5810c388ade Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 12 Nov 2026 10:50:29 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 aide.spec | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/aide.spec b/aide.spec
index 2481fe9..4dcf91f 100644
--- a/aide.spec
+++ b/aide.spec
@@ -46,7 +46,7 @@ BuildRequires:  audit-libs-devel
 BuildRequires:  autoconf automake libtool
 BuildRequires:  systemd-rpm-macros
 # For verifying signatures
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 # For being able to run 'make check'
 BuildRequires:  check-devel
 
@@ -58,12 +58,12 @@ AIDE (Advanced Intrusion Detection Environment) is a file integrity
 checker and intrusion detection program.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 cp -a %{SOURCE4} .
 
 %if %{with bundled_nettle}
-%{gpgverify} --keyring='%{SOURCE202}' --signature='%{SOURCE201}' --data='%{SOURCE200}'
+%{openpgpverify} --keyring='%{SOURCE202}' --signature='%{SOURCE201}' --data='%{SOURCE200}'
 
 mkdir -p bundled_nettle
 pushd bundled_nettle
-- 
2.56.0

