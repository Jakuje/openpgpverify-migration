From d1e3f03f91d49b576a31700e3e93a465cec56097 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:43 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 drm_info.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drm_info.spec b/drm_info.spec
index 24a5b3a..3274010 100644
--- a/drm_info.spec
+++ b/drm_info.spec
@@ -12,7 +12,7 @@ Source1:        %{url}/-/releases/v%{version}/downloads/%{name}-%{version}.tar.g
 Source2:        https://emersion.fr/.well-known/openpgpkey/hu/dj3498u4hyyarh35rkjfnghbjxug6b19#/gpgkey-0FDE7BE0E88F5E48.gpg
 
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  meson >= 0.56.0
 BuildRequires:  pkgconfig(json-c)
 BuildRequires:  pkgconfig(libdisplay-info)
@@ -26,7 +26,7 @@ BuildRequires:  python3-devel
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 
-- 
2.56.0

