From ef82e3dbebdce6037038166c9774e55135e2f4f0 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:45 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 mingw-cmocka.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/mingw-cmocka.spec b/mingw-cmocka.spec
index a527b58..0287776 100644
--- a/mingw-cmocka.spec
+++ b/mingw-cmocka.spec
@@ -20,7 +20,7 @@ Source2:        cmocka.keyring
 BuildArch:      noarch
 
 BuildRequires:  make
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 BuildRequires:  mingw32-filesystem >= 95
 BuildRequires:  mingw32-gcc
 BuildRequires:  mingw32-gcc-c++
@@ -77,7 +77,7 @@ Static version of the MinGW Windows cmocka library.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1 -n cmocka-%{version}
 
 %build
-- 
2.56.0

