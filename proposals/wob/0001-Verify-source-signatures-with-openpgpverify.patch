From 2a5d448ad9cf459cae04dd0ff07c42aa523b5042 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 9 Oct 2026 15:52:19 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 wob.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/wob.spec b/wob.spec
index 8d3ede1..db92f82 100644
--- a/wob.spec
+++ b/wob.spec
@@ -2,7 +2,7 @@
 
 Name:     wob
 Version:  0.15.1
-Release:  10%{?dist}
+Release:  11%{?dist}
 Summary:  A lightweight overlay volume/backlight/progress/anything bar for Wayland
 License:  ISC
 URL:      https://github.com/francma/wob
@@ -16,7 +16,7 @@ Source1: %{url}/releases/download/%{version}/%{name}-%{version}.tar.gz.sig
 Source2: 5C6DA024DDE27178073EA103F4B432D5D67990E3.gpg
 
 BuildRequires: gcc
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: meson
 BuildRequires: pkgconfig(libseccomp)
 BuildRequires: scdoc
@@ -32,7 +32,7 @@ A lightweight overlay volume/backlight/progress/anything bar for
 Wayland.
 
 %prep
-%gpgverify -k 2 -s 1 -d 0
+%openpgpverify -k 2 -s 1 -d 0
 %autosetup
 
 %build
@@ -52,6 +52,9 @@ Wayland.
 %license LICENSE
 
 %changelog
+* Fri Oct 09 2026 Jakub Jelen <jjelen@redhat.com> - 0.15.1-11
+- Verify upstream source signatures with openpgpverify
+
 * Fri Jul 17 2026 Fedora Release Engineering <releng@fedoraproject.org> - 0.15.1-10
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.55.0

