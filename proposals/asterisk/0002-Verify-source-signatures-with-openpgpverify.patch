From c6d79c557761ffada7ec0212b9bc6126a672a885 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 6 Nov 2026 09:38:02 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 asterisk.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/asterisk.spec b/asterisk.spec
index 33398fd..fc7ad5b 100644
--- a/asterisk.spec
+++ b/asterisk.spec
@@ -42,7 +42,7 @@
 Summary:          The Open Source PBX
 Name:             asterisk
 Version:          24.0.0
-Release:          %{?_rc||?_beta:0.}1%{?_rc:.rc%{_rc}}%{?_beta:.beta%{_beta}}%{?dist}.1
+Release:          %{?_rc||?_beta:0.}1%{?_rc:.rc%{_rc}}%{?_beta:.beta%{_beta}}%{?dist}.2
 # Automatically converted from old format: GPLv2 - review is highly recommended.
 License:          GPL-2.0-only
 URL:              http://www.asterisk.org/
@@ -225,6 +225,7 @@ Provides:         bundled(jansson) = %{jansson_version}
 # for gpg to be able to verify the signature
 BuildRequires:    libgcrypt
 BuildRequires:    make
+BuildRequires:    openpgpverify
 
 
 Requires(post):   systemd-units
@@ -588,7 +589,7 @@ Jabber/XMPP resources for Asterisk.
 %if 0%{?fedora} || 0%{?rhel} >=8
 # only verifying on Fedora and RHEL >=8 due to version of gpg
 rpm -q libgcrypt
-gpgv2 --keyring %{SOURCE7} %{SOURCE1} %{SOURCE0}
+%{openpgpverify} --keyring='%{SOURCE7}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 %autosetup -p1 -n asterisk-%{version}%{?_rc:-rc%{_rc}}%{?_beta:-beta%{_beta}}
 
@@ -1604,6 +1605,9 @@ fi
 %endif
 
 %changelog
+* Fri Nov 06 2026 Jakub Jelen <jjelen@redhat.com> - 24.0.0-1.2
+- Verify upstream source signatures with openpgpverify
+
 * Thu Nov 05 2026 Michel Lind <salimma@fedoraproject.org> - 24.0.0-1.1
 - Rebuild for libical 4.x
 
-- 
