From dd4973995fd7d11d22b08408e978a3a851c6c67f Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:32 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 asterisk.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/asterisk.spec b/asterisk.spec
index 896cb68..abdb4a6 100644
--- a/asterisk.spec
+++ b/asterisk.spec
@@ -42,7 +42,7 @@
 Summary:          The Open Source PBX
 Name:             asterisk
 Version:          23.6.0
-Release:          %{?_rc||?_beta:0.}1%{?_rc:.rc%{_rc}}%{?_beta:.beta%{_beta}}%{?dist}
+Release:          %{?_rc||?_beta:0.}1%{?_rc:.rc%{_rc}}%{?_beta:.beta%{_beta}}%{?dist}.1
 # Automatically converted from old format: GPLv2 - review is highly recommended.
 License:          GPL-2.0-only
 URL:              http://www.asterisk.org/
@@ -225,6 +225,7 @@ Provides:         bundled(jansson) = %{jansson_version}
 # for gpg to be able to verify the signature
 BuildRequires:    libgcrypt
 BuildRequires:    make
+BuildRequires:    openpgpverify
 
 
 Requires(post):   systemd-units
@@ -588,7 +589,7 @@ Jabber/XMPP resources for Asterisk.
 %if 0%{?fedora} || 0%{?rhel} >=8
 # only verifying on Fedora and RHEL >=8 due to version of gpg
 rpm -q libgcrypt
-gpgv2 --keyring %{SOURCE7} %{SOURCE1} %{SOURCE0}
+%{openpgpverify} --keyring='%{SOURCE7}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 %autosetup -p1 -n asterisk-%{version}%{?_rc:-rc%{_rc}}%{?_beta:-beta%{_beta}}
 
@@ -1604,6 +1605,9 @@ fi
 %endif
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 23.6.0-1.1
+- Verify upstream source signatures with openpgpverify
+
 * Thu Nov  5 2026 Peter Lemenkov <lemenkov@gmail.com> - 23.6.0-1
 - update to 23.6.0
 
-- 
2.56.0

