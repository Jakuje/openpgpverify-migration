From 118a223b1d0672e4d8ed99c52f194f17a0e4684d Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:45 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 maven-reporting-api.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/maven-reporting-api.spec b/maven-reporting-api.spec
index 3ff96df..e86d540 100644
--- a/maven-reporting-api.spec
+++ b/maven-reporting-api.spec
@@ -1,6 +1,6 @@
 Name:           maven-reporting-api
 Version:        4.0.0
-Release:        7%{?dist}
+Release:        8%{?dist}
 Epoch:          1
 Summary:        API to manage report generation
 License:        Apache-2.0
@@ -20,7 +20,7 @@ Source2:        https://downloads.apache.org/maven/KEYS
 BuildArch:      noarch
 ExclusiveArch:  %{java_arches} noarch
 
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 BuildRequires:  maven-local-openjdk25
 BuildRequires:  mvn(org.apache.maven.shared:maven-shared-components:pom:)
 BuildRequires:  mvn(org.apache.maven.doxia:doxia-sink-api)
@@ -33,7 +33,7 @@ API to manage report generation.  Maven-reporting-api is included in the Maven
 decoupling from the Maven 3 core.
 
 %prep
-%{gpgverify} --data=%{SOURCE0} --signature=%{SOURCE1} --keyring=%{SOURCE2}
+%{openpgpverify} --data=%{SOURCE0} --signature=%{SOURCE1} --keyring=%{SOURCE2}
 %autosetup
 
 # Fix end of line encoding
@@ -52,6 +52,9 @@ rm README.md.orig
 %license LICENSE NOTICE
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 1:4.0.0-8
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1:4.0.0-7
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
