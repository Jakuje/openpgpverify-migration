From 70bc0b30802a3bc4c728bf87d4024faf02042752 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:09:03 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 rush.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/rush.spec b/rush.spec
index c792e11..f3dcea6 100644
--- a/rush.spec
+++ b/rush.spec
@@ -1,6 +1,6 @@
 Name:             rush
 Version:          2.4
-Release:          5%{?dist}
+Release:          6%{?dist}
 Summary:          GNU Restricted User Shell
 # Main code and man pages under GPL-3.0-or-later
 # Documentation under GFDL1.1-or-later AND GFDL-1.3-or-later
@@ -11,7 +11,7 @@ Source0:          http://ftp.gnu.org/gnu/%{name}/%{name}-%{version}.tar.xz
 Source1:          http://ftp.gnu.org/gnu/%{name}/%{name}-%{version}.tar.xz.sig
 Source2:          gpgkey-79FFD94BFCE230B1.gpg
 BuildRequires:    gcc
-BuildRequires:    gnupg2
+BuildRequires:    openpgpverify
 BuildRequires:    make
 Provides:         bundled(gnulib)
 
@@ -26,7 +26,7 @@ execute, and allows to tune the usage of system resources, such as
 virtual memory, CPU time, etc. on a per-user basis.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
@@ -61,6 +61,9 @@ rm -rf %{buildroot}%{_infodir}/dir
 %{_infodir}/rush.info*
 
 %changelog
+* Fri Oct 23 2026 Jakub Jelen <jjelen@redhat.com> - 2.4-6
+- Verify upstream source signatures with openpgpverify
+
 * Fri Jul 17 2026 Fedora Release Engineering <releng@fedoraproject.org> - 2.4-5
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

