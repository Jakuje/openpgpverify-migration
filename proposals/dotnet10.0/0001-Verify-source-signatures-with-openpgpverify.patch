From 971db53bd87bd5b3fe98ebf813be61cb767db89b Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 14:18:39 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 dotnet10.0.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/dotnet10.0.spec b/dotnet10.0.spec
index 2ac07e3..ef58efe 100644
--- a/dotnet10.0.spec
+++ b/dotnet10.0.spec
@@ -77,7 +77,7 @@
 
 Name:           dotnet%{dotnetver}
 Version:        %{sdk_rpm_version}
-Release:        1%{?dist}
+Release:        2%{?dist}
 Summary:        .NET %{dotnetver} Runtime and SDK
 License:        0BSD AND Apache-2.0 AND (Apache-2.0 WITH LLVM-exception) AND APSL-2.0 AND BSD-2-Clause AND BSD-3-Clause AND BSD-4-Clause AND BSL-1.0 AND bzip2-1.0.6 AND CC0-1.0 AND CC-BY-3.0 AND CC-BY-4.0 AND CC-PDDC AND CNRI-Python AND EPL-1.0 AND GPL-2.0-only AND (GPL-2.0-only WITH GCC-exception-2.0) AND GPL-2.0-or-later AND GPL-3.0-only AND ICU AND ISC AND LGPL-2.1-only AND LGPL-2.1-or-later AND LicenseRef-Fedora-Public-Domain AND LicenseRef-ISO-8879 AND MIT AND MIT-Wu AND MS-PL AND MS-RL AND NCSA AND OFL-1.1 AND OpenSSL AND Unicode-DFS-2015 AND Unicode-DFS-2016 AND W3C-19980720 AND X11 AND Zlib
 
@@ -168,6 +168,7 @@ BuildRequires:  rapidjson-devel
 %endif
 BuildRequires:  tar
 BuildRequires:  util-linux
+BuildRequires:  openpgpverify
 %if ! %{use_bundled_zlib}
 BuildRequires:  zlib-devel
 %endif
@@ -478,7 +479,7 @@ These are not meant for general use.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 
 release_json_tag=$(grep tag %{SOURCE3} | cut -d: -f2 | sed -E 's/[," ]*//g')
 if [[ ${release_json_tag} != %{upstream_tag} ]]; then
@@ -998,6 +999,9 @@ export COMPlus_LTTng=0
 
 
 %changelog
+* Thu Oct 29 2026 Jakub Jelen <jjelen@redhat.com> - 10.0.113-2
+- Verify upstream source signatures with openpgpverify
+
 * Wed Oct 14 2026 Omair Majid <omajid@redhat.com> - 10.0.113-1
 - Update to .NET SDK 10.0.113 and Runtime 10.0.13
 
-- 
2.56.0

