From 9988879fae5f1ac53551b9044ee9a51099592293 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 22 Oct 2026 13:10:17 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 php.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/php.spec b/php.spec
index 3b28240..bb646ef 100644
--- a/php.spec
+++ b/php.spec
@@ -86,7 +86,7 @@ Name: php%{major_version}
 Name: php
 %endif
 Version: %{upver}%{?rcver:~%{rcver}}
-Release: 1%{?dist}
+Release: 2%{?dist}
 # All files licensed under PHP version 3.01, except
 # Zend is licensed under Zend
 # TSRM is licensed under BSD
@@ -192,6 +192,7 @@ Provides:      bundled(liburiparser) = %{liburiparser_bunver}
 # used for tests
 BuildRequires: %{_bindir}/ps
 BuildRequires: tzdata
+BuildRequires: openpgpverify
 
 %if %{with zts}
 Provides: php-zts = %{version}-%{release}
@@ -845,7 +846,7 @@ in pure PHP.
 
 
 %prep
-%{?gpgverify:%{gpgverify} --keyring='%{SOURCE20}' --signature='%{SOURCE21}' --data='%{SOURCE0}'}
+%{?openpgpverify:%{openpgpverify} --keyring='%{SOURCE20}' --signature='%{SOURCE21}' --data='%{SOURCE0}'}
 
 %setup -q -n php-%{upver}%{?rcver}
 
@@ -1675,6 +1676,9 @@ systemctl try-restart php-fpm.service >/dev/null 2>&1 || :
 
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 8.5.12-2
+- Verify upstream source signatures with openpgpverify
+
 * Wed Oct 21 2026 Jitka Plesnikova <jplesnik@redhat.com> - 8.5.12-1
 - Update to 8.5.12 - http://www.php.net/releases/8_5_12.php
 
-- 
2.55.0

