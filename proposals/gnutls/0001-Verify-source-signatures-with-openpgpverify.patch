From 6db942bfe1bca483eadfb5fb16d6e8990e78e202 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 12 Oct 2026 14:12:59 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 gnutls.spec | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/gnutls.spec b/gnutls.spec
index 6eaf19c..5687db5 100644
--- a/gnutls.spec
+++ b/gnutls.spec
@@ -116,6 +116,7 @@ Recommends: trousers >= 0.3.11.2
 BuildRequires: unbound-devel unbound-libs
 %endif
 BuildRequires: make gtk-doc
+BuildRequires: openpgpverify
 
 %if %{with mingw}
 BuildRequires:  mingw32-cpp
@@ -287,7 +288,7 @@ for MinGW.
 %endif
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 
 %autosetup -p1 -S git
 
@@ -302,7 +303,7 @@ popd
 %endif
 
 %if %{with bundled_nettle}
-%{gpgverify} --keyring='%{SOURCE202}' --signature='%{SOURCE201}' --data='%{SOURCE200}'
+%{openpgpverify} --keyring='%{SOURCE202}' --signature='%{SOURCE201}' --data='%{SOURCE200}'
 
 mkdir -p bundled_nettle
 pushd bundled_nettle
-- 
2.55.0

