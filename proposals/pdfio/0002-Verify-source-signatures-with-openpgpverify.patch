From f246c085d2f9dc7d89ef10d9d402b699324e9950 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 10:38:42 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 pdfio.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/pdfio.spec b/pdfio.spec
index a9af35b..003038b 100644
--- a/pdfio.spec
+++ b/pdfio.spec
@@ -2,7 +2,7 @@
 
 Name: pdfio
 Version: 1.6.5
-Release: 1%{?dist}
+Release: 2%{?dist}
 Summary: C library for PDF I/O
 # Apache 2.0 with exception - pdfio code
 # GPL-2.0-or-later - code128 font from examples
@@ -25,7 +25,7 @@ BuildRequires: git-core
 # builds with gcc
 BuildRequires: gcc
 # for verifying the tarball signature
-BuildRequires: gpgverify
+BuildRequires: openpgpverify
 # use make for Makefile
 BuildRequires: make
 # uses pkg-config in SPEC and in configure
@@ -64,7 +64,7 @@ The package contains HTML documentation and man page for PDFIO library.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -S git
 
 
@@ -130,6 +130,9 @@ make test
 
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 1.6.5-2
+- Verify upstream source signatures with openpgpverify
+
 * Mon Aug 31 2026 Zdenek Dohnal <zdohnal@redhat.com> - 1.6.5-1
 - 1.6.5
 
-- 
