From c0ac546f412438c63a293fb118557e53da5b8083 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:42 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the direct GnuPG verification with %openpgpverify, which
uses Sequoia sqv, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 usbredir.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/usbredir.spec b/usbredir.spec
index 505d083..f0327b1 100644
--- a/usbredir.spec
+++ b/usbredir.spec
@@ -1,6 +1,6 @@
 Name:           usbredir
 Version:        0.15.0
-Release:        4%{?dist}
+Release:        5%{?dist}
 Summary:        USB network redirection protocol libraries
 License:        LGPL-2.1-or-later
 URL:            https://www.spice-space.org/usbredir.html
@@ -17,6 +17,7 @@ BuildRequires:  glib2-devel
 BuildRequires:  libusb1-devel >= 1.0.9
 BuildRequires:  git-core
 BuildRequires:  meson
+BuildRequires:  openpgpverify
 
 %description
 The usbredir libraries allow USB devices to be used on remote and/or virtual
@@ -53,7 +54,7 @@ Includes usbredirect that uses libusbredirhost to export an USB device for use
 in another (virtual) machine
 
 %prep
-gpgv2 --quiet --keyring %{SOURCE2} %{SOURCE1} %{SOURCE0}
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -S git_am
 
 
@@ -92,6 +93,9 @@ gpgv2 --quiet --keyring %{SOURCE2} %{SOURCE1} %{SOURCE0}
 
 
 %changelog
+* Mon Oct 26 2026 Jakub Jelen <jjelen@redhat.com> - 0.15.0-5
+- Verify upstream source signatures with openpgpverify
+
 * Fri Jul 17 2026 Fedora Release Engineering <releng@fedoraproject.org> - 0.15.0-4
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
