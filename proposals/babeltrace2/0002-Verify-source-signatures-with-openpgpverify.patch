From baf54d1f94cd7e36c4c7c86ba93b3c151cab8be2 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 21:20:33 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 babeltrace2.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/babeltrace2.spec b/babeltrace2.spec
index e5ee1d1..cd92540 100644
--- a/babeltrace2.spec
+++ b/babeltrace2.spec
@@ -1,6 +1,6 @@
 Name:           babeltrace2
 Version:        2.1.2
-Release:        10%{?dist}
+Release:        11%{?dist}
 Summary:        A trace manipulation toolkit
 License:        MIT AND GPL-2.0-only
 URL:            https://www.efficios.com/babeltrace
@@ -23,7 +23,7 @@ BuildRequires:  flex >= 2.5.35
 BuildRequires:  gcc
 BuildRequires:  gcc-g++
 BuildRequires:  glib2-devel >= 2.28.0
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  libtool >= 2.2
 BuildRequires:  make
 BuildRequires:  python3-devel >= 3.4
@@ -69,7 +69,7 @@ The python3-bt2 package provides Python 3 bindings for libbabeltrace2.
 
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
@@ -127,6 +127,9 @@ rm -f %{buildroot}/%{_pkgdocdir}/std-ext-lib.md
 
 
 %changelog
+* Thu Nov 05 2026 Jakub Jelen <jjelen@redhat.com> - 2.1.2-11
+- Verify upstream source signatures with openpgpverify
+
 * Mon Jul 27 2026 Jitka Plesnikova <jplesnik@redhat.com> - 2.1.2-10
 - Replace removed Python 2 C API macros for SWIG 4.5.0 compatibility
 
-- 
2.56.0

