From efe8b10a41c4d1d30a8873abec43338b525833ca Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 9 Oct 2026 15:52:19 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 fapolicyd.spec | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/fapolicyd.spec b/fapolicyd.spec
index ce0f7cf..8bb4dc1 100644
--- a/fapolicyd.spec
+++ b/fapolicyd.spec
@@ -5,7 +5,7 @@
 Summary: Application Whitelisting Daemon
 Name: fapolicyd
 Version: 2.0.1
-Release: 1%{?dist}
+Release: 2%{?dist}
 License: GPL-3.0-or-later
 URL: https://github.com/linux-application-whitelisting/fapolicyd
 Source0: https://github.com/linux-application-whitelisting/fapolicyd/releases/download/v%{version}/fapolicyd-%{version}.tar.gz
@@ -32,7 +32,7 @@ BuildRequires: systemd systemd-devel openssl-devel rpm-devel file-devel file
 BuildRequires: libcap-ng-devel libseccomp-devel lmdb-devel
 BuildRequires: python3-devel
 %if 0%{?fedora} || 0%{?rhel} > 10
-BuildRequires: gpgverify
+BuildRequires: openpgpverify
 %else
 BuildRequires: gnupg
 %endif
@@ -67,8 +67,13 @@ BuildArch: noarch
 The %{name}-selinux package contains selinux policy for the %{name} daemon.
 
 %prep
+%if 0%{?fedora} || 0%{?rhel} >= 11
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE10}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE11}' --data='%{SOURCE1}'
+%else
 %{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE10}' --data='%{SOURCE0}'
 %{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE11}' --data='%{SOURCE1}'
+%endif
 
 %setup -q
 
@@ -229,6 +234,9 @@ fi
 %selinux_relabel_post -s %{selinuxtype}
 
 %changelog
+* Fri Oct 09 2026 Jakub Jelen <jjelen@redhat.com> - 2.0.1-2
+- Verify upstream source signatures with openpgpverify
+
 * Wed Aug 19 2026 Petr Lautrbach <lautrbach@redhat.com> - 2.0.1-1
 - fapolicyd-2.0.1
   https://github.com/linux-application-whitelisting/fapolicyd/releases/tag/v2.0.1
-- 
2.55.0

