From 6831a3cf3f6139b69dcc987921e158a7e3847105 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:49 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 suil.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/suil.spec b/suil.spec
index 06b5a5e..f07a793 100644
--- a/suil.spec
+++ b/suil.spec
@@ -15,6 +15,7 @@ Source2:    https://drobilla.net/drobilla.gpg
 BuildRequires:  doxygen
 BuildRequires:  graphviz
 BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  lv2-devel >= 1.18.3
 BuildRequires:  meson >= 0.56
 # We need to track changes to these toolkits manually due to the
@@ -50,7 +51,7 @@ Requires:   %{name}%{_isa} = %{version}-%{release}
 This package contains the headers and development libraries for %{name}.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
-- 
2.56.0

