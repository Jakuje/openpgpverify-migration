From c5d7504c5b48dec4b859f43812e9efa6b9070f94 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 12 Oct 2026 14:13:00 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 libchewing.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/libchewing.spec b/libchewing.spec
index 71c20b8..2b6c893 100644
--- a/libchewing.spec
+++ b/libchewing.spec
@@ -34,6 +34,7 @@ BuildRequires:  cargo-rpm-macros >= 24
 BuildRequires:  cmake(Corrosion)
 BuildRequires:  gnupg2
 BuildRequires:  python3-devel
+BuildRequires:  openpgpverify
 # since f31
 Obsoletes:      python2-libchewing < 0.5.1-13
 
@@ -77,7 +78,7 @@ Python binding of libchewing.
 %{name_zh_TW} python 綁定
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1 -n libchewing-%{version_no_tilde}
 %cargo_prep
 
-- 
2.55.0

