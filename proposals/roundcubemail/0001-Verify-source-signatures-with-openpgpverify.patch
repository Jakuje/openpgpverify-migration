From d51e5e01b3f1296213d873b7ea616a070e94095f Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Fri, 30 Oct 2026 10:52:06 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 roundcubemail.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/roundcubemail.spec b/roundcubemail.spec
index 39b5a18..368b915 100644
--- a/roundcubemail.spec
+++ b/roundcubemail.spec
@@ -18,7 +18,7 @@
 %global _logdir /var/log  
 Name: roundcubemail
 Version:  %{upstream_version}%{?upstream_prever:~%{upstream_prever}}
-Release:  1%{?dist}
+Release:  2%{?dist}
 Summary: Round Cube Webmail is a browser-based multilingual IMAP client
 
 # Since 0.8 beta, the main code has been GPLv3+ with exceptions and
@@ -50,7 +50,7 @@ Patch1: roundcubemail-1.7-confpath.patch
 
 
 BuildArch: noarch
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: php(language) >= 8.1
 # For test
 BuildRequires: php-cli
@@ -138,7 +138,7 @@ CSS 2.
 
 
 %prep
-%{?gpgverify: %{gpgverify} --keyring=%{SOURCE9} --signature=%{SOURCE8} --data=%{SOURCE0}}
+%{?openpgpverify: %{openpgpverify} --keyring=%{SOURCE9} --signature=%{SOURCE8} --data=%{SOURCE0}}
 
 %setup -q -n roundcubemail-%{upstream_version}%{?upstream_prever:-%{upstream_prever}}
 %patch -P1 -p1 -b .rpm
@@ -271,6 +271,9 @@ fi
 
 
 %changelog
+* Fri Oct 30 2026 Jakub Jelen <jjelen@redhat.com> - 1.7.5-2
+- Verify upstream source signatures with openpgpverify
+
 * Tue Oct 27 2026 Remi Collet <remi@remirepo.net> - 1.7.5-1
 - update to 1.7.5
 
-- 
2.56.0

