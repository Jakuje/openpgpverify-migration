From 68d50941119892d0846c4b24e14192b17528ded5 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:48 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 python-zstarfile.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/python-zstarfile.spec b/python-zstarfile.spec
index 8f6b2c5..03b09d2 100644
--- a/python-zstarfile.spec
+++ b/python-zstarfile.spec
@@ -4,7 +4,7 @@
 
 Name:           python-zstarfile
 Version:        0.3.0
-Release:        7%{?dist}
+Release:        8%{?dist}
 Summary:        Tarfile extension with additional compression algorithms and PEP 706 by default
 
 
@@ -17,7 +17,7 @@ Source2:        https://meta.sr.ht/~gotmax23.pgp
 
 BuildArch:      noarch
 
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  python3-devel
 
 # zstandard is part of stdlib on Python 3.14, so no need to pull in pyzstd by default.
@@ -38,7 +38,7 @@ Summary:        %{summary}
 
 
 %prep
-%gpgverify -d0 -s1 -k2
+%openpgpverify -d0 -s1 -k2
 %autosetup -p1 -n zstarfile-%{version}
 
 
@@ -71,6 +71,9 @@ export ERROR_FOR_MISSING=1
 %pyproject_extras_subpkg -n python3-zstarfile all lz4 zstandard
 
 %changelog
+* Sat Oct 31 2026 Jakub Jelen <jjelen@redhat.com> - 0.3.0-8
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 0.3.0-7
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

