From c626dd3e83dd9b5700cc58758a88c9d435ddcc81 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 21:26:18 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 python-zstarfile.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/python-zstarfile.spec b/python-zstarfile.spec
index 8f6b2c5..2fc1b0e 100644
--- a/python-zstarfile.spec
+++ b/python-zstarfile.spec
@@ -4,7 +4,7 @@
 
 Name:           python-zstarfile
 Version:        0.3.0
-Release:        7%{?dist}
+Release:        8%{?dist}
 Summary:        Tarfile extension with additional compression algorithms and PEP 706 by default
 
 
@@ -19,6 +19,7 @@ BuildArch:      noarch
 
 BuildRequires:  gnupg2
 BuildRequires:  python3-devel
+BuildRequires:  openpgpverify
 
 # zstandard is part of stdlib on Python 3.14, so no need to pull in pyzstd by default.
 # Zstarfile still provides an option pyzstopen method that uses pyzstd.
@@ -38,7 +39,7 @@ Summary:        %{summary}
 
 
 %prep
-%gpgverify -d0 -s1 -k2
+%openpgpverify -d0 -s1 -k2
 %autosetup -p1 -n zstarfile-%{version}
 
 
@@ -71,6 +72,9 @@ export ERROR_FOR_MISSING=1
 %pyproject_extras_subpkg -n python3-zstarfile all lz4 zstandard
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 0.3.0-8
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 0.3.0-7
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

