From 8b05a72339f02640bd28966e28ff7ed2c5c255ba Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:50 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 xstdcmap.spec | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/xstdcmap.spec b/xstdcmap.spec
index 3fd8cc8..4ee44b7 100644
--- a/xstdcmap.spec
+++ b/xstdcmap.spec
@@ -9,8 +9,7 @@ Source0:        %{url}/pub/individual/app/%{name}-%{version}.tar.xz
 Source1:        %{url}/pub/individual/app/%{name}-%{version}.tar.xz.sig
 Source2:        %{name}.gpg
 BuildRequires:  gcc
-BuildRequires:  gnupg2
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 BuildRequires:  meson
 BuildRequires:  pkgconfig(x11)
 BuildRequires:  pkgconfig(xmu)
@@ -23,7 +22,7 @@ create standard colormap definitions in order to facilitate sharing of
 scarce colormap resources among clients using PseudoColor visuals.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
-- 
2.56.0

