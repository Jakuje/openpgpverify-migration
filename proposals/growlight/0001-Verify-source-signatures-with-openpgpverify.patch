From 938fe56042e0998b318d97335c5cab38c1c63f09 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 26 Oct 2026 15:23:36 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 growlight.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/growlight.spec b/growlight.spec
index 12a75b4..45ae36d 100644
--- a/growlight.spec
+++ b/growlight.spec
@@ -9,7 +9,7 @@ Source0:       https://github.com/dankamongmen/%{name}/archive/v%{version}.tar.g
 Source1:       https://github.com/dankamongmen/%{name}/releases/download/v%{version}/v%{version}.tar.gz.asc
 Source2:       https://nick-black.com/dankamongmen.gpg
 
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: cmake
 BuildRequires: doctest-devel
 BuildRequires: gcc-c++
@@ -33,7 +33,7 @@ boot when run in an installer context. Both full-screen and REPL readline UIs
 are available.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup
 
 %build
-- 
2.56.0

