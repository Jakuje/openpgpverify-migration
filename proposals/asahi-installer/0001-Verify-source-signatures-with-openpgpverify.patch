From e906d3c7dff591f2c8c54ed546e8bbff1b486486 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:58 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 asahi-installer.spec | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/asahi-installer.spec b/asahi-installer.spec
index 9a5f3d8..a493514 100644
--- a/asahi-installer.spec
+++ b/asahi-installer.spec
@@ -47,6 +47,7 @@ Source3:        https://www.python.org/ftp/python/%{installer_python_version}/%{
 Source4:        https://keybase.io/nad/pgp_keys.asc?fingerprint=0d96df4d4110e5c43fbfb17f2d347ea6aa65421d#/key.asc
 
 BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  python3-devel
 BuildRequires:  python3dist(asn1)
 
@@ -99,7 +100,7 @@ Asahi Linux firmware tools
 
 %prep
 %autosetup -p1
-%{gpgverify} --keyring='%{SOURCE4}' --signature='%{SOURCE3}' --data='%{SOURCE2}'
+%{openpgpverify} --keyring='%{SOURCE4}' --signature='%{SOURCE3}' --data='%{SOURCE2}'
 
 # Set version
 echo "%{version}" > version.tag
-- 
2.56.0

