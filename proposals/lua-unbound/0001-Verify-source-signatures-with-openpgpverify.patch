From 02112c44244aeabd07921302479a3787b7037b50 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:46 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 lua-unbound.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/lua-unbound.spec b/lua-unbound.spec
index b072340..42fb1bb 100644
--- a/lua-unbound.spec
+++ b/lua-unbound.spec
@@ -1,14 +1,14 @@
 Summary:        Binding to libunbound for Lua
 Name:           lua-unbound
 Version:        1.1.0
-Release:        2%{?dist}
+Release:        3%{?dist}
 License:        MIT
 URL:            https://www.zash.se/luaunbound.html
 Source0:        https://code.zash.se/dl/luaunbound/luaunbound-%{version}.tar.gz
 Source1:        https://code.zash.se/dl/luaunbound/luaunbound-%{version}.tar.gz.asc
 Source2:        gpgkey-3E52119EF853C59678DBBF6BADED9A77B67AD329.gpg
 Requires:       lua(abi) = %{lua_version}
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  gcc
 BuildRequires:  make
 BuildRequires:  lua >= %{lua_version}
@@ -19,7 +19,7 @@ BuildRequires:  unbound-devel
 Lua bindings for the Unbound APIs.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %setup -q -n luaunbound-%{version}
 
 %build
@@ -47,6 +47,9 @@ lua -e \
 %{lua_libdir}/lunbound.so
 
 %changelog
+* Sat Oct 31 2026 Jakub Jelen <jjelen@redhat.com> - 1.1.0-3
+- Verify upstream source signatures with openpgpverify
+
 * Thu Jul 16 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.1.0-2
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
