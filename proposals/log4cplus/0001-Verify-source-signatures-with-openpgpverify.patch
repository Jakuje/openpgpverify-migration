From 85f96dfa69d13ee517fe3b4417d054e7c88f57e1 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 22 Oct 2026 13:10:16 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 log4cplus.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/log4cplus.spec b/log4cplus.spec
index 3212216..f4b4de9 100644
--- a/log4cplus.spec
+++ b/log4cplus.spec
@@ -25,7 +25,7 @@ Summary: Development files for log4cplus C++ logging framework
 Requires: %{name} = %{version}-%{release}
 BuildRequires: gcc-c++
 BuildRequires: make
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 
 %description devel
 This package contains headers and libraries needed to develop applications
@@ -41,7 +41,7 @@ using log4cplus logging framework.
 
 %prep
 %if 0%{?fedora}
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 %setup -q %{?prever:-n %{name}-%{version}-%{prever}}
 
-- 
2.55.0

