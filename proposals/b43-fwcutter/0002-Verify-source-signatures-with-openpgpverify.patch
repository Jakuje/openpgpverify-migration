From f87079090f7c1b5fdb6fbb762820401e5138bf47 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 5 Nov 2026 19:20:58 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 b43-fwcutter.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/b43-fwcutter.spec b/b43-fwcutter.spec
index 7e7a390..13dc23f 100644
--- a/b43-fwcutter.spec
+++ b/b43-fwcutter.spec
@@ -11,7 +11,7 @@ Source1:        https://bues.ch/b43/fwcutter/%{name}-%{version}.tar.xz.asc
 Source2:        757FAB7CED1814AE15B4836E5FB027474203454C.gpg
 Source100:      README.too
 BuildRequires:  gcc
-BuildRequires:  gnupg2
+BuildRequires:  openpgpverify
 BuildRequires:  make
 
 %description
@@ -22,7 +22,7 @@ See the README.too file shipped in the package's documentation for
 instructions on using this tool.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p2
 
 cp %{SOURCE100} .
-- 
2.56.0

