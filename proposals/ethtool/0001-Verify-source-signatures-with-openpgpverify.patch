From d5c2f8ab74aada273bffbe68d701be9129e61d20 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Mon, 12 Oct 2026 14:12:59 +0200
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 ethtool.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/ethtool.spec b/ethtool.spec
index eb8eb1c..f142f62 100644
--- a/ethtool.spec
+++ b/ethtool.spec
@@ -4,7 +4,7 @@ Summary:        Settings tool for Ethernet NICs
 Name:           ethtool
 Epoch:          2
 Version:        7.1
-Release:        1%{?dist}
+Release:        2%{?dist}
 # {json_print,qsfp,sff-common}.{c,h} are GPL-2.0-or-later, rest is GPL-2.0-only
 License:        GPL-2.0-only AND GPL-2.0-or-later
 URL:            https://www.kernel.org/pub/software/network/%{name}/
@@ -16,6 +16,7 @@ BuildRequires:  gcc
 BuildRequires:  libappstream-glib
 BuildRequires:  libmnl-devel
 BuildRequires:  make
+BuildRequires:  openpgpverify
 Conflicts:      filesystem < 3
 
 %description
@@ -24,7 +25,7 @@ port, auto-negotiation, PCI locations and checksum offload on many
 network devices, especially of Ethernet devices.
 
 %prep
-xzcat '%{SOURCE0}' | %{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
+xzcat '%{SOURCE0}' | %{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data=-
 %autosetup
 
 %build
@@ -49,6 +50,9 @@ appstream-util validate-relax --nonet $RPM_BUILD_ROOT%{_metainfodir}/%{appstream
 %{_metainfodir}/%{appstream_id}.metainfo.xml
 
 %changelog
+* Mon Oct 12 2026 Jakub Jelen <jjelen@redhat.com> - 2:7.1-2
+- Verify upstream source signatures with openpgpverify
+
 * Sat Jul 18 2026 Robert Scheck <robert@fedoraproject.org> - 2:7.1-1
 - Upgrade to 7.1 (#2498384)
 
-- 
2.55.0

