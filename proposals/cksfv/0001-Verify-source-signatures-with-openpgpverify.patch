From 9ec3b1464a2e511e79d572e4dd5b0cb1fa919085 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:34:53 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 cksfv.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/cksfv.spec b/cksfv.spec
index 115cd9e..d26f189 100644
--- a/cksfv.spec
+++ b/cksfv.spec
@@ -1,6 +1,6 @@
 Name:           cksfv
 Version:        1.3.15
-Release:        17%{?dist}
+Release:        18%{?dist}
 Summary:        Utility to manipulate SFV files
 
 # Automatically converted from old format: GPLv2+ - review is highly recommended.
@@ -12,6 +12,7 @@ Source2:        https://zakalwe.fi/~shd/keys/heikki-orsila-2017.pub
 BuildRequires:  gcc
 BuildRequires:  gnupg2
 BuildRequires: make
+BuildRequires:  openpgpverify
 
 %description
 cksfv is a utility that can create and use SFV files. SFV (Simple File
@@ -20,7 +21,7 @@ checksums.
 
 
 %prep
-%{gpgverify} --keyring='%{S:2}' --signature='%{S:1}' --data='%{S:0}'
+%{openpgpverify} --keyring='%{S:2}' --signature='%{S:1}' --data='%{S:0}'
 %setup -q
 
 # fix rpmlint warnings
@@ -56,6 +57,9 @@ mv -f ChangeLog.conv ChangeLog
 
 
 %changelog
+* Thu Oct 22 2026 Jakub Jelen <jjelen@redhat.com> - 1.3.15-18
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 1.3.15-17
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

