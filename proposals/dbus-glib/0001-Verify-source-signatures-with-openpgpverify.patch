From 364024f791f3770dda41d05329df31c03d27fc52 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Sat, 31 Oct 2026 23:04:41 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 dbus-glib.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/dbus-glib.spec b/dbus-glib.spec
index 9a4e479..07a75a2 100644
--- a/dbus-glib.spec
+++ b/dbus-glib.spec
@@ -4,7 +4,7 @@
 
 Name:    dbus-glib
 Version: 0.112
-Release: 14%{?dist}
+Release: 15%{?dist}
 Summary: GLib bindings for D-Bus
 
 # dbus/dbus-bash-completion-helper.c is GPL-2.0-or-later
@@ -25,7 +25,7 @@ BuildRequires: /usr/bin/chrpath
 BuildRequires: dbus-daemon
 BuildRequires: gcc
 BuildRequires: gettext
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 BuildRequires: make
 
 %description
@@ -42,7 +42,7 @@ Requires: %{name}%{?_isa} = %{version}-%{release}
 Headers and static libraries for the D-Bus GLib bindings
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -p1
 
 %build
@@ -90,6 +90,9 @@ chmod -x $RPM_BUILD_ROOT%{_sysconfdir}/bash_completion.d/dbus-bash-completion.sh
 
 
 %changelog
+* Sat Oct 31 2026 Jakub Jelen <jjelen@redhat.com> - 0.112-15
+- Verify upstream source signatures with openpgpverify
+
 * Wed Jul 15 2026 Fedora Release Engineering <releng@fedoraproject.org> - 0.112-14
 - Rebuilt for https://fedoraproject.org/wiki/Fedora_45_Mass_Rebuild
 
-- 
2.56.0

