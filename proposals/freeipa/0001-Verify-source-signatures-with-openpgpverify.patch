From d5a5a46d18e044a639a0e314472877b146cb286d Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Tue, 27 Oct 2026 12:35:05 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 freeipa.spec | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/freeipa.spec b/freeipa.spec
index 77fe24b..79d7450 100644
--- a/freeipa.spec
+++ b/freeipa.spec
@@ -211,7 +211,7 @@
 
 Name:           %{package_name}
 Version:        %{IPA_VERSION}
-Release:        3.2%{?rc_version:.%rc_version}%{?dist}
+Release:        3.2%{?rc_version:.%rc_version}%{?dist}.1
 Summary:        The Identity, Policy and Audit system
 
 License:        GPL-3.0-or-later
@@ -344,6 +344,7 @@ BuildRequires:  python3-pyasn1
 BuildRequires:  python3-pyasn1-modules
 BuildRequires:  python3-six
 BuildRequires:  python3-psutil
+BuildRequires:  openpgpverify
 
 #
 # Build dependencies for wheel packaging and PyPI upload
@@ -1088,7 +1089,7 @@ Custom SELinux policy module for Thales Luna HSMs
 %prep
 # Verify release signature
 %if %{NON_DEVELOPER_BUILD}
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %endif
 
 %autosetup -n freeipa-%{TARBALL_IPA_VERSION}%{?rc_version} -N -p1
@@ -1979,6 +1980,9 @@ fi
 %endif
 
 %changelog
+* Mon Oct 26 2026 Jakub Jelen <jjelen@redhat.com> - 4.13.4-3.2.1
+- Verify upstream source signatures with openpgpverify
+
 * Tue Oct 06 2026 David Hanina <dhanina@redhat.com> - 4.13.4-3.2
 - Resolves: rhbz#2546573
 
-- 
2.56.0

