From 693ecd06ca0af897b591af0d300df09b2e8daa0b Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Wed, 11 Nov 2026 11:45:29 +0100
Subject: [PATCH 2/2] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Release bumped with a changelog entry.

Assisted-by: Claude Opus 5.5
---
 coreutils.spec | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/coreutils.spec b/coreutils.spec
index f9cf862..08da40c 100644
--- a/coreutils.spec
+++ b/coreutils.spec
@@ -1,7 +1,7 @@
 Summary: A set of basic GNU tools commonly used in shell scripts
 Name:    coreutils
 Version: 9.12
-Release: 1%{?dist}
+Release: 2%{?dist}
 # some used parts of gnulib are under various variants of LGPL
 License: GPL-3.0-or-later AND GFDL-1.3-no-invariants-or-later AND LGPL-2.1-or-later AND LGPL-3.0-or-later
 Url:     https://www.gnu.org/software/coreutils/
@@ -69,7 +69,7 @@ BuildRequires: systemd-devel
 BuildRequires: texinfo
 
 # For gpg verification of source tarball
-BuildRequires: gnupg2
+BuildRequires: openpgpverify
 
 # test-only dependencies
 BuildRequires: acl
@@ -134,7 +134,7 @@ Optional though recommended components,
 including documentation and translations.
 
 %prep
-%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
+%{openpgpverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
 %autosetup -N
 
 # will be regenerated in the build directories
@@ -284,6 +284,9 @@ rm -f $RPM_BUILD_ROOT%{_infodir}/dir
 %license COPYING
 
 %changelog
+* Wed Nov 11 2026 Jakub Jelen <jjelen@redhat.com> - 9.12-2
+- Verify upstream source signatures with openpgpverify
+
 * Mon Sep 21 2026 Lukáš Zaoral <lzaoral@redhat.com> - 9.12-1
 - rebase to the latest upstream release (rhbz#2533195)
 
-- 
