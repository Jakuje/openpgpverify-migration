From 396179ba9094e8a83d068c388f4fa1504fe3c901 Mon Sep 17 00:00:00 2001
From: Jakub Jelen <jjelen@redhat.com>
Date: Thu, 29 Oct 2026 09:06:48 +0100
Subject: [PATCH] Verify source signatures with openpgpverify

Replace the GnuPG-based %gpgverify with %openpgpverify, which uses
Sequoia sqv and takes the same options, as part of the Fedora 45 Change
https://fedoraproject.org/wiki/Changes/Sequoia_openpgpverify

Assisted-by: Claude Opus 5.5
---
 xclipboard.spec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/xclipboard.spec b/xclipboard.spec
index 3b5bb3a..d95df36 100644
--- a/xclipboard.spec
+++ b/xclipboard.spec
@@ -10,7 +10,7 @@ Source1:    https://xorg.freedesktop.org/archive/individual/app/%{name}-%{versio
 Source2:    gpgkey-3AB285232C46AE43D8E192F4DAB0F78EA6E7E2D2.gpg
 
 BuildRequires:  gcc
-BuildRequires:  gpgverify
+BuildRequires:  openpgpverify
 BuildRequires:  meson
 BuildRequires:  pkgconfig(x11)
 BuildRequires:  pkgconfig(xaw7)
@@ -27,7 +27,7 @@ CLIPBOARD selections for later use.  It stores each CLIPBOARD
 selection as a separate string, each of which can be selected.
 
 %prep
-%{gpgverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
+%{openpgpverify} --keyring=%{SOURCE2} --signature=%{SOURCE1} --data=%{SOURCE0}
 %autosetup
 
 %build
-- 
2.56.0

